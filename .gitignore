node_modules/
dist/
dist-server/
build/
.env
.env.local
*.log
.DS_Store
coverage/
.vite/
.turbo/
generated/
_nm/

# astro build cache (only the root .gitignore is used; inner workspaces inherit)
.astro/

# tsbuild incremental cache
*.tsbuildinfo

# npm lockfiles (pnpm-lock.yaml is the source of truth)
package-lock.json
**/package-lock.json
# ...except duncit-mobile-app, a standalone npm app (EAS needs its lockfile to pick npm)
!duncit-mobile-app/package-lock.json
# ...and open-wa-server (+ its bundled dashboard SPA): its Docker build runs
# `npm ci` for both, so both lockfiles must be committed.
!portals/crm/open-wa-server/package-lock.json
!portals/crm/open-wa-server/dashboard/package-lock.json
# Local SonarQube issue dumps (pnpm sonar:issues)
sonar-issues.json
sonar-issues.md

# Generated at build time from signing credentials (scripts/generate-app-links.mjs).
# Never committed: the fingerprints are per signing key, and a stale one makes
# Android cache a FAILED verification.
app/mweb/public/.well-known/

# Local duplication report (pnpm dup:report). The gate writes its CI copy to a
# temp dir; only scripts/duplication-baseline.json is committed.
duplication-report.md
.jscpd/
