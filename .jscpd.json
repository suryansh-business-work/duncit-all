{
  "minLines": 10,
  "minTokens": 90,
  "maxLines": 3000,
  "maxSize": "500kb",
  "gitignore": false,
  "absolute": false,
  "silent": true,
  "format": [
    "typescript",
    "tsx",
    "javascript",
    "jsx"
  ],
  "reporters": [
    "json"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.astro/**",
    "**/.expo/**",
    "**/android/**",
    "**/ios/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/*.min.*",
    "**/*.d.ts",
    "**/__tests__/**",
    "**/e2e/**",
    "**/cypress/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.cy.*",
    "**/*.stories.*",
    "**/*.config.ts",
    "**/*.config.js",
    "**/*.config.mjs",
    "**/*.config.cjs",
    "**/vitest.setup.ts",
    "portals/crm/open-wa-server/**",
    "packages/docs-demos/**",
    "server/src/modules/ai/askBot/askBot.catalog.*.ts",
    "server/src/modules/platform/packageUpdates/package-manifest.ts",
    "server/src/modules/platform/localization/shipped-keys.ts"
  ]
}
