# Standalone npm project (not in the pnpm workspace): keep its lockfile,
# which the root .gitignore excludes everywhere else.
!package-lock.json

node_modules/
.expo/
dist/
coverage/

# Generated by `expo prebuild` (CNG). Anchored to this folder: the local
# native module's source lives in modules/crm-telephony/android/ and must
# stay tracked.
/android/
/ios/
*.apk
*.aab

.env
.env.local
*.log
.DS_Store
expo-env.d.ts

# GraphQL codegen output, regenerated from the server schema in CI.
src/generated/
