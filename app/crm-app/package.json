{
  "name": "duncit-crm",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "npm@12.2.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --port 2023",
    "start:staging": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=https://staging.server.duncit.com expo start --port 2023",
    "start:main": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=https://server.duncit.com expo start --port 2023",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:android --port 2023",
    "prebuild": "expo prebuild --platform android",
    "codegen": "graphql-codegen --config codegen.ts && node ../../scripts/generate-lead-quality-rules.mjs --out app/crm-app/src/generated/lead-quality-rules.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "ci": "npm run test:coverage && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@duncit/auth-tokens": "file:../../packages/auth-tokens",
    "@duncit/buttons-native": "file:../../packages/buttons-native",
    "@duncit/datetime": "file:../../packages/datetime",
    "@duncit/errors": "file:../../packages/errors",
    "@duncit/forms": "file:../../packages/forms",
    "@duncit/i18n": "file:../../packages/i18n",
    "@duncit/logs": "file:../../packages/logs",
    "@duncit/regex": "file:../../packages/regex",
    "@duncit/slack": "file:../../packages/slack",
    "@duncit/user-core": "file:../../packages/user-core",
    "@duncit/utils": "file:../../packages/utils",
    "@expo/vector-icons": "^15.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tamagui/config": "^2.7.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.0",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.22",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-modules-core": "~57.0.0",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.0",
    "expo-video": "~57.0.5",
    "graphql": "^16.14.2",
    "graphql-request": "^6.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-preset-expo": "~57.0.13",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
