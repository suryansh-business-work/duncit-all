# Production / release build configuration. Loaded by Expo/Metro when bundling
# in production mode (`expo prebuild` + `gradlew bundleRelease`, EAS production).
#
# A release build made WITHOUT an explicit EXPO_PUBLIC_API_URL bakes this value
# in, so it must be the production API. It pointed at staging once, and a store
# build cut that way answered its first request with "Network error" whenever
# staging was down. CI and the Dockerfiles still pass the variable explicitly,
# and a preset variable wins over this file.
EXPO_PUBLIC_API_URL=https://server.duncit.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAP_API=
EXPO_TOKEN=
