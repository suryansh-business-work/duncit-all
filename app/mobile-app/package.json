{
  "name": "duncit-mobile",
  "version": "1.72.240",
  "private": true,
  "main": "index.js",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --port 2022",
    "start:local": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=http://localhost:2001 expo start --port 2022",
    "start:local:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=http://localhost:2001 expo start --port 2022",
    "start:local:staging": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=http://localhost:2001 expo start --port 2022",
    "start:main": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=https://server.duncit.com expo start --port 2022",
    "start:staging": "cross-env NODE_OPTIONS=--max-old-space-size=8192 EXPO_PUBLIC_API_URL=https://staging.server.duncit.com expo start --port 2022",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --android --port 2022",
    "ios": "expo start --ios --port 2022",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web --port 2022",
    "export:web": "node ../../scripts/verify-fallback-icons.mjs assets/fallback-icons && expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild",
    "codegen": "graphql-codegen --config codegen.ts",
    "eas-build-post-install": "npm run codegen",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "node ../../scripts/verify-fallback-icons.mjs assets/fallback-icons && tsc --noEmit && tsc --noEmit -p __tests__/e2e/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e:build": "detox build --configuration android.emu.debug",
    "e2e:test": "detox test --configuration android.emu.debug",
    "test:e2e:web": "cypress run --config-file __tests__/e2e/cypress.config.ts",
    "test:e2e:web:open": "cypress open --config-file __tests__/e2e/cypress.config.ts",
    "build:android:apk": "pnpm dlx eas-cli build --platform android --profile preview --non-interactive",
    "build:android:aab": "pnpm dlx eas-cli build --platform android --profile production --non-interactive",
    "build:ios": "pnpm dlx eas-cli build --platform ios --profile production",
    "build:local:apk": "node scripts/build-local-android.js",
    "build:local:apk:main": "node scripts/build-local-android.js --main",
    "build:local:apk:staging": "node scripts/build-local-android.js --staging",
    "build:local:aab": "node scripts/build-local-android.js --aab",
    "build:local:aab:main": "node scripts/build-local-android.js --aab --main",
    "build:local:aab:staging": "node scripts/build-local-android.js --aab --staging",
    "build:local:ios": "node scripts/build-local-ios.js",
    "upload:slack": "node scripts/upload-slack.js",
    "ci": "npm run test:coverage && npm run typecheck && npm run lint",
    "verify:fallback-icons": "node ../../scripts/verify-fallback-icons.mjs assets/fallback-icons",
    "e2e": "cypress run --config-file __tests__/e2e/cypress.config.ts"
  },
  "dependencies": {
    "@duncit/ai-monitoring": "file:../../packages/ai-monitoring",
    "@duncit/auth-tokens": "file:../../packages/auth-tokens",
    "@duncit/buttons-native": "file:../../packages/buttons-native",
    "@duncit/datetime": "file:../../packages/datetime",
    "@duncit/dialogs-native": "file:../../packages/dialogs-native",
    "@duncit/errors": "file:../../packages/errors",
    "@duncit/fallback-icons": "file:../../packages/fallback-icons",
    "@duncit/forms": "file:../../packages/forms",
    "@duncit/geo": "file:../../packages/geo",
    "@duncit/i18n": "file:../../packages/i18n",
    "@duncit/logs": "file:../../packages/logs",
    "@duncit/onboarding": "file:../../packages/onboarding",
    "@duncit/regex": "file:../../packages/regex",
    "@duncit/slack": "file:../../packages/slack",
    "@duncit/slots": "file:../../packages/slots",
    "@duncit/tours": "file:../../packages/tours",
    "@duncit/user-core": "file:../../packages/user-core",
    "@duncit/utils": "file:../../packages/utils",
    "@duncit/verification": "file:../../packages/verification",
    "@duncit/virtual-scroll": "file:../../packages/virtual-scroll",
    "@expo/vector-icons": "^15.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tamagui/config": "^2.7.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-build-properties": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "graphql": "^16.14.2",
    "graphql-request": "^6.1.0",
    "lottie-react-native": "~7.3.8",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.18.0",
    "rn-tourguide": "^3.3.2",
    "socket.io-client": "^4.8.3",
    "tamagui": "^2.7.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@react-native/jest-preset": "^0.86.3",
    "@slack/web-api": "^8.1.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-preset-expo": "~57.0.9",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "detox": "^20.51.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
