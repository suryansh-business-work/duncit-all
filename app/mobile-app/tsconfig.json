{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // TS 6 (the SDK 57 toolchain) no longer auto-includes node_modules/@types,
    // so the jest/node ambients every suite leans on must be named. Both are
    // already installed: @types/jest directly, @types/node transitively.
    "types": ["node", "jest"],
    // No baseUrl: TS 6 deprecates it (TS 7 removes it), and every entry below
    // is ./-relative, which resolves against this tsconfig's directory anyway.
    "paths": {
      "@/*": ["./src/*"],
      // Linked workspace packages are typechecked from their own SOURCE, so
      // their peer imports resolve by walking up from packages/<name>/ —
      // which finds nothing in CI, where only app/mobile-app is installed.
      // Point them at this app's copy (the jest modulePaths twin).
      "date-fns": ["./node_modules/date-fns"],
      "date-fns/*": ["./node_modules/date-fns/*"],
      "date-fns-tz": ["./node_modules/date-fns-tz"],
      "date-fns-tz/*": ["./node_modules/date-fns-tz/*"],
      // @duncit/verification re-exports a zod address schema from its ROOT
      // entry, so the app compiles that file and has to resolve zod from
      // packages/verification/ — empty in CI. Safe as a Metro alias too: zod
      // ships its own types, so tsc and Metro both want this same module.
      "zod": ["./node_modules/zod"],
      // Same story one level over: @duncit/forms/schemas imports @duncit/regex
      // and @duncit/utils, and the app compiles that subpath from source. Both
      // are already this app's own file: dependencies — Metro finds them, tsc
      // walking up from packages/forms/ does not.
      "@duncit/regex": ["./node_modules/@duncit/regex"],
      "@duncit/utils": ["./node_modules/@duncit/utils"],
      // …and @duncit/datetime since the signup schema moved in there: the
      // birth-year age rule is a calendar question, so the one contract both
      // apps validate against reaches for it.
      "@duncit/datetime": ["./node_modules/@duncit/datetime"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `__tests__/e2e` is the Cypress suite: it has its own tsconfig (chai globals
  // clash with jest's here) and is typechecked by the same `typecheck` script.
  "exclude": ["node_modules", "e2e", "__tests__/e2e", "android", "ios", "dist"]
}
