# Loaded by `vite build --mode e2e-live` (via `pnpm build:e2e:live`).
#
# The LIVE e2e suite (__tests__/e2e-live) drives a real server: it signs in and
# signs up as the run's identity, creates pods, tickets and ideas, and purges
# them afterwards. That server is ALWAYS staging — the suite needs "Return
# one-time codes" switched on there, which must never be on for production.
# CI overrides this with the same value through VITE_GRAPHQL_URL in the
# workflow env; it is here so a local `pnpm build:e2e:live` matches.
VITE_GRAPHQL_URL=https://staging.server.duncit.com/graphql
VITE_MWEB_URL=http://localhost:2003
