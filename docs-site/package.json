{
  "name": "duncit-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Browsable reference for every @duncit/* shared package. Reads the MDX each package ships in its own docs/ folder, so the docs live next to the code they describe.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "e2e": "node ../scripts/e2e-no-surface.mjs duncit-docs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@duncit/dialogs": "workspace:*",
    "@duncit/docs-demos": "workspace:*",
    "@duncit/theme": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/loader": "^1.7.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "astro": "^5.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "monaco-editor": "^0.56.0"
  }
}
