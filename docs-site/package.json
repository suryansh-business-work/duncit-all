{
  "name": "duncit-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Browsable reference for every @duncit/* shared package. Reads the MDX each package ships in its own docs/ folder, so the docs live next to the code they describe.",
  "scripts": {
    "deps:check": "node ../scripts/deps.mjs check",
    "deps:update": "node ../scripts/deps.mjs update",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "e2e": "node ../scripts/e2e-no-surface.mjs duncit-docs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@duncit/dialogs": "workspace:*",
    "@duncit/docs-demos": "workspace:*",
    "@duncit/theme": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/loader": "^1.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "monaco-editor": "^0.56.0"
  }
}
