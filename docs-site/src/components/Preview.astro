---
import { Code } from 'astro:components';
import CodeCard from './CodeCard.astro';
import { SHIKI_THEMES } from '../shiki-themes.mjs';

/**
 * Frames one live example: a titled surface, the REAL component rendered as a
 * React island, and the exact source that produced it.
 *
 * `code` is meant to be fed from a `?raw` import of the example module, so the
 * snippet on the page is the file that is actually running — it cannot drift
 * the way a hand-copied block does. It goes through `<Code>` rather than a bare
 * `<pre>` so it is highlighted by the same Shiki pass as a fenced block, and
 * through `<CodeCard>` so it carries the same copy/wrap/format toolbar.
 *
 * The stage is deliberately pinned to a light surface: the islands mount MUI's
 * default (light) theme, so a dark page background would show light-theme
 * components on the wrong canvas.
 */
interface Props {
  /** What this example demonstrates. */
  title: string;
  /** Exact source of the rendered example (import it with `?raw`). */
  code: string;
  /** One line telling the reader what to look at. */
  note?: string;
  /** Language of `code`. Every example is a component today. */
  lang?: string;
}

const { title, code, note, lang = 'tsx' } = Astro.props;
---

<figure class="preview">
  <figcaption class="preview__head">
    <span class="code-card__badge">live</span>
    <span class="code-card__title">{title}</span>
  </figcaption>

  <div class="preview__stage"><slot /></div>

  {note && <p class="preview__note">{note}</p>}

  <CodeCard lang={lang}>
    <Code code={code.trim()} lang={lang} themes={SHIKI_THEMES} />
  </CodeCard>
</figure>
