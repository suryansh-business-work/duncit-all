---
import { getCollection } from 'astro:content';
import CodePlayground from '../components/CodePlayground.astro';
import type { TocItem } from '../lib/nav';
import '../styles/docs.css';
import '../styles/code.css';

interface Props {
  title: string;
  subtitle?: string;
  /** Package directory, so the sidebar can mark the page you are on. */
  activeDir?: string;
  /** Rendered as the "On this page" rail; the column collapses when empty. */
  toc?: TocItem[];
}

const { title, subtitle, activeDir, toc = [] } = Astro.props;

const entries = await getCollection('packages');
const nav = entries
  .map((entry) => ({
    dir: entry.id.split('/')[0],
    name: entry.data.name,
    summary: entry.data.summary,
    category: entry.data.category,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const categories = [...new Set(nav.map((item) => item.category))].sort((a, b) => a.localeCompare(b));
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={subtitle ?? 'Reference for every @duncit/* shared package.'} />
    <title>{title} — duncit packages</title>

    {/*
      Runs before the first paint, so the page is never drawn in one palette and
      repainted in the other. It is inline for that reason and no other — a
      bundled module would arrive too late to prevent the flash.
    */}
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const stored = localStorage.getItem('duncit-docs-theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (globalThis.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
      <a class="topbar__brand" href="/">duncit <span>packages</span></a>
      <input
        id="pkg-search"
        class="topbar__search"
        type="search"
        placeholder="Filter packages — press /"
        aria-label="Filter packages by name or summary"
        autocomplete="off"
      />
      <span class="topbar__spacer"></span>
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch theme">Dark</button>
    </header>

    <div class:list={['shell', toc.length === 0 && 'shell--wide']}>
      <aside id="sidebar" class="sidebar">
        <p class="sidebar__count">{nav.length} packages documented</p>

        <div class="sidebar__group">
          <h2 class="sidebar__group-title">guides</h2>
          <a
            class="sidebar__link"
            href="/writing-docs"
            data-search="writing a package page docs mdx frontmatter preview code editor format tidy"
            aria-current={activeDir === 'writing-docs' ? 'page' : undefined}
          >
            Writing a package page
          </a>
        </div>

        {
          categories.map((category) => (
            <div class="sidebar__group">
              <h2 class="sidebar__group-title">{category}</h2>
              {nav
                .filter((item) => item.category === category)
                .map((item) => (
                  <a
                    class="sidebar__link"
                    href={`/${item.dir}`}
                    data-search={`${item.name} ${item.summary}`.toLowerCase()}
                    aria-current={item.dir === activeDir ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                ))}
            </div>
          ))
        }

        <p class="sidebar__empty">No package matches that.</p>
      </aside>

      <main id="content" class="content">
        <h1>{title}</h1>
        {subtitle && <p class="lede">{subtitle}</p>}
        <slot />
      </main>

      {
        toc.length > 0 && (
          <aside class="toc" aria-label="On this page">
            <p class="toc__title">On this page</p>
            <ol>
              {toc.map((item) => (
                <li class={`toc--${item.depth}`}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <CodePlayground />

    <script>
      import '../scripts/theme';
      import '../scripts/sidebar-filter';
      import '../scripts/code-actions';
      import '../scripts/toc';
    </script>
  </body>
</html>
