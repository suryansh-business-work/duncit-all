---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  subtitle?: string;
  activeDir?: string;
}
const { title, subtitle, activeDir } = Astro.props;

const entries = await getCollection('packages');
const nav = entries
  .map((entry) => ({
    dir: entry.id.split('/')[0],
    name: entry.data.name,
    category: entry.data.category,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const categories = [...new Set(nav.map((item) => item.category))].sort((a, b) => a.localeCompare(b));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — duncit packages</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --panel: #f6f7f9;
        --ink: #14161a;
        --muted: #5c6470;
        --line: #e3e6ea;
        --accent: #7c3aed;
        --code-bg: #f0f1f4;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1115;
          --panel: #161920;
          --ink: #e8eaed;
          --muted: #9aa2ae;
          --line: #262b34;
          --accent: #a78bfa;
          --code-bg: #1c212a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      .shell { display: grid; grid-template-columns: 268px minmax(0, 1fr); min-height: 100vh; }
      aside {
        border-right: 1px solid var(--line);
        background: var(--panel);
        padding: 20px 16px;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      aside h1 { font-size: 15px; margin: 0 0 4px; letter-spacing: -0.01em; }
      aside p { margin: 0 0 18px; color: var(--muted); font-size: 12px; }
      aside h2 {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin: 18px 0 6px;
      }
      aside a {
        display: block;
        padding: 5px 8px;
        border-radius: 6px;
        color: var(--ink);
        text-decoration: none;
        font-size: 13px;
      }
      aside a:hover { background: var(--line); }
      aside a[aria-current='page'] { background: var(--accent); color: #fff; }
      main { padding: 36px 40px 80px; max-width: 900px; }
      main :global(h1) { font-size: 30px; letter-spacing: -0.02em; margin: 0 0 6px; }
      main :global(h2) { font-size: 20px; margin: 34px 0 10px; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
      main :global(h3) { font-size: 16px; margin: 22px 0 8px; }
      main :global(code) { background: var(--code-bg); padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
      main :global(pre) { background: var(--code-bg); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
      main :global(pre code) { background: none; padding: 0; }
      main :global(table) { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
      main :global(th), main :global(td) { border: 1px solid var(--line); padding: 7px 10px; text-align: left; font-size: 14px; }
      main :global(th) { background: var(--panel); }
      main :global(a) { color: var(--accent); }
      .lede { color: var(--muted); margin: 0 0 24px; font-size: 15px; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 28px; padding: 0; list-style: none; }
      .tags li {
        font-size: 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 2px 10px;
        color: var(--muted);
      }
      @media (max-width: 800px) {
        .shell { grid-template-columns: 1fr; }
        aside { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--line); }
        main { padding: 24px 20px 60px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <h1><a href="/" style="padding:0;background:none">duncit packages</a></h1>
        <p>{nav.length} documented</p>
        {
          categories.map((category) => (
            <div>
              <h2>{category}</h2>
              {nav
                .filter((item) => item.category === category)
                .map((item) => (
                  <a
                    href={`/${item.dir}`}
                    aria-current={item.dir === activeDir ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                ))}
            </div>
          ))
        }
      </aside>
      <main>
        <h1>{title}</h1>
        {subtitle && <p class="lede">{subtitle}</p>}
        <slot />
      </main>
    </div>
  </body>
</html>
