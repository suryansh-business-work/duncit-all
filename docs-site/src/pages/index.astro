---
import { getCollection } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import type { TocItem } from '../lib/nav';

const rows = (await getCollection('packages'))
  .map((entry) => ({ dir: entry.id.split('/')[0], ...entry.data }))
  .sort((a, b) => a.name.localeCompare(b.name));

const categories = [...new Set(rows.map((row) => row.category))].sort((a, b) => a.localeCompare(b));

const stats = [
  { value: rows.length, label: 'packages documented' },
  { value: rows.filter((row) => row.zeroDeps).length, label: 'with no runtime dependency' },
  { value: rows.filter((row) => row.frameworkFree).length, label: 'framework-free' },
  { value: rows.filter((row) => row.coverageGate).length, label: 'holding a 100% coverage gate' },
];

const toc: TocItem[] = categories.map((category) => ({ depth: 2, slug: category, text: category }));
---

<DocsLayout
  title="Shared packages"
  subtitle="Every page here is generated from the MDX that package ships in its own docs/ folder, so the reference moves with the code it describes."
  toc={toc}
>
  <p>
    Before adding a helper, hook, constant map, regex, schema or component anywhere: look here
    first. Anything used in more than two places belongs in one of these, not copied a third time.
    Filter the list with the box above — it matches the summary as well as the name, so
    <em>money</em>, <em>timezone</em> or <em>otp</em> find the right package on their own.
  </p>

  <ul class="stats">
    {
      stats.map((stat) => (
        <li>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </li>
      ))
    }
  </ul>

  {
    categories.map((category) => (
      <section>
        <h2 id={category}>{category}</h2>
        <div class="cards">
          {rows
            .filter((row) => row.category === category)
            .map((row) => (
              <a class="card" href={`/${row.dir}`}>
                <div class="card__name">{row.name}</div>
                <p class="card__summary">{row.summary}</p>
                <div class="card__meta">
                  {row.zeroDeps && <span>zero deps</span>}
                  {row.frameworkFree && <span>framework-free</span>}
                  {row.coverageGate && <span>100% covered</span>}
                  <span>{row.consumers.length} consumers</span>
                </div>
              </a>
            ))}
        </div>
      </section>
    ))
  }
</DocsLayout>
