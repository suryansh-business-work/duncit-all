{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@docs/*": ["./src/*"],
      "@duncit/docs-demos/examples/*": ["../packages/docs-demos/src/examples/*"]
    }
  }
}
