# Duncit Lite server — copy to lite/.env for a local run (`pnpm --filter duncit-lite dev:server` + `start:dev`).
# Service credentials (SMTP, ImageKit, Google) are NOT env vars: add them in the console under Environment.
PORT=2040
LITE_MONGO_URI=mongodb://127.0.0.1:27017/duncit-lite
LITE_JWT_SECRET=change-me
LITE_SITE_URL=http://localhost:2041
LITE_PORTAL_URL=http://portal.localhost:2041
# Comma-separated addresses that sign in as admins on a fresh database.
LITE_ADMIN_EMAILS=admin@duncit.com
# The main Duncit API a "Sign in with Duncit" code is proved against (never its database).
DUNCIT_GRAPHQL_URL=https://server.duncit.com/graphql
DUNCIT_APP_URL=https://mweb.duncit.com
# The code every sign-in accepts while no mailbox is configured.
LITE_OTP_TEST_CODE=123456
