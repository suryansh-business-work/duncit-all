{
  "name": "duncit-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Duncit Lite — the event platform at lite.duncit.com (web app) and lite-portal.duncit.com (console). Its own API and its own database; nothing here touches the main Duncit stack.",
  "scripts": {
    "deps:check": "node ../scripts/deps.mjs check",
    "deps:update": "node ../scripts/deps.mjs update",
    "dev": "vite",
    "dev:server": "vite build --config vite.config.server.ts --watch",
    "start:dev": "node --watch --env-file=.env dist-server/index.mjs",
    "build": "tsc -b --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && vite build --config vite.config.server.ts && node ../scripts/verify-fallback-icons.mjs shared/fallback-icons",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "cd .. && eslint -c eslint.a11y.config.mjs --no-warn-ignored --max-warnings 0 lite/web lite/portal lite/shared",
    "preview": "vite preview",
    "start": "node dist-server/index.mjs",
    "e2e": "node ../scripts/e2e-no-surface.mjs duncit-lite"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "nodemailer": "^9.1.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@duncit/app-settings": "workspace:*",
    "@duncit/auth-tokens": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/datetime": "workspace:*",
    "@duncit/dialogs": "workspace:*",
    "@duncit/fallback-icons": "workspace:*",
    "@duncit/forms": "workspace:*",
    "@duncit/i18n": "workspace:*",
    "@duncit/logs": "workspace:*",
    "@duncit/regex": "workspace:*",
    "@duncit/table": "workspace:*",
    "@duncit/tabs": "workspace:*",
    "@duncit/theme": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/user-core": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/nunito": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@react-oauth/google": "^0.13.5",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  }
}
