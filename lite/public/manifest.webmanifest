{
  "name": "Duncit Lite",
  "short_name": "Duncit Lite",
  "description": "Create an event page, invite people and manage guests in minutes.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0e1012",
  "theme_color": "#0e1012",
  "categories": ["events", "social", "lifestyle"],
  "icons": [
    { "src": "/icons/mark-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/mark-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/mark-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Create event", "url": "/create", "icons": [{ "src": "/icons/mark-192.png", "sizes": "192x192" }] },
    { "name": "My events", "url": "/home", "icons": [{ "src": "/icons/mark-192.png", "sizes": "192x192" }] },
    { "name": "Discover", "url": "/discover", "icons": [{ "src": "/icons/mark-192.png", "sizes": "192x192" }] }
  ]
}
