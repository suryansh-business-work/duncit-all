    "@apollo/client": {
      "optional": true
    },
    "@duncit/app-settings": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^2.1.9",
    "graphql": "^16.14.2",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@duncit/buttons": "workspace:*"
