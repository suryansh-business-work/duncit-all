    ".": "./src/index.ts",
    "./mui": "./src/mui/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/ai-monitoring"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": ">=5",
