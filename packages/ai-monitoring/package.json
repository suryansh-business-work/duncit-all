{
  "name": "@duncit/ai-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One AI Monitoring notice for every upload field: framework-free copy resolution at the root, the MUI chip + dialog behind ./mui. The native app renders the same copy through its own Tamagui view.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mui": "./src/mui/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/ai-monitoring"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@duncit/app-settings": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^4.2.12",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@duncit/buttons": "workspace:*",
    "@duncit/utils": "workspace:*"
  }
}
