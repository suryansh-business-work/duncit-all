    "@duncit/table": "workspace:*",
    "@duncit/tabs": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@hookform/resolvers": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@duncit/dialogs": {
      "optional": true
    },
    "@duncit/forms": {
      "optional": true
    },
    "@duncit/table": {
      "optional": true
    },
    "@duncit/tabs": {
      "optional": true
    },
