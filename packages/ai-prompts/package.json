{
  "name": "@duncit/ai-prompts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The AI Library: two kinds of prompt (CODE, seeded from the server catalogue and read back on every call; AI, authored in the portal and served by the public GET feed), the {{ var }} rules they share, and the MUI views behind ./mui.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mui": "./src/mui/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/ai-prompts"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@duncit/dialogs": "workspace:*",
