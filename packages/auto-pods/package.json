{
  "name": "@duncit/auto-pods",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The MUI Auto Pod queue every role-facing surface renders: the three-enrolment card (Venue / Host / Club Admin) plus the accept, assign and claim dialogs. mWeb, the Partners portal and Admin share these views; the native app keeps Tamagui twins over the same @duncit/utils logic.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/auto-pods"
  },
  "dependencies": {
    "@duncit/datetime": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@apollo/client": "^3.10.4",
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "graphql": "^16.8.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
