{
  "name": "@duncit/auto-pods",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The MUI Auto Pod queue every role-facing surface renders: the three-enrolment card (Venue / Host / Club Admin) plus the accept, assign and claim dialogs. mWeb, the Partners portal and Admin share these views; the native app keeps Tamagui twins over the same @duncit/utils logic.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/auto-pods"
  },
  "dependencies": {
    "@duncit/buttons": "workspace:*",
    "@duncit/datetime": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@hookform/resolvers": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "@mui/x-date-pickers": ">=6",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=4"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.12",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
