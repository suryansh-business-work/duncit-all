{
  "name": "@duncit/brand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Astro chrome for the Duncit websites: the brand mark and the newsletter signup, so the admin's logo and the subscribe form are drawn one way in one place.",
  "exports": {
    "./BrandLogo.astro": "./src/BrandLogo.astro",
    "./FooterLogo.astro": "./src/FooterLogo.astro",
    "./NewsletterSignup.astro": "./src/NewsletterSignup.astro",
    "./PolicyStrip.astro": "./src/PolicyStrip.astro",
    "./SocialLinks.astro": "./src/SocialLinks.astro",
    "./SiteMenu.astro": "./src/SiteMenu.astro",
    "./AppDownload.astro": "./src/AppDownload.astro",
    "./AppPhone.astro": "./src/AppPhone.astro",
    "./EarnShowcase.astro": "./src/EarnShowcase.astro",
    "./site-i18n": "./src/site-i18n.ts",
    "./SiteMeta.astro": "./src/SiteMeta.astro",
    "./GoogleAnalytics.astro": "./src/GoogleAnalytics.astro",
    "./google-analytics": "./src/google-analytics.ts",
    "./ConsentBanner.astro": "./src/ConsentBanner.astro",
    "./consent-banner": "./src/consent-banner.ts",
    "./site-meta": "./src/site-meta.ts",
    "./ReelSlider.astro": "./src/ReelSlider.astro",
    "./reel-slider": "./src/reel-slider.ts",
    "./cms-block": "./src/cms-block.ts",
    "./CareersApply.astro": "./src/CareersApply.astro",
    "./ApplyButton.astro": "./src/ApplyButton.astro",
    "./widgets/careers-apply": "./src/widgets/careers-apply.ts",
    "./widgets": "./src/widgets/index.ts",
    "./widgets/earnings-calculator": "./src/widgets/earnings-calculator.ts",
    "./widgets/campaign-calculator": "./src/widgets/campaign-calculator.ts",
    "./widgets/contact-form": "./src/widgets/contact-form.ts",
    "./widgets/faq": "./src/widgets/faq.ts",
    "./widgets/help-center": "./src/widgets/help-center.ts",
    "./widgets/grievance-form": "./src/widgets/grievance-form.ts",
    "./widgets/policy-list": "./src/widgets/policy-list.ts",
    "./widgets/policy-reader": "./src/widgets/policy-reader.ts",
    "./widgets/site-nav": "./src/widgets/site-nav.ts",
    "./widgets/site-header": "./src/widgets/site-header.ts",
    "./cms-design": "./src/cms-design.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/brand"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "dependencies": {
    "@duncit/captcha": "workspace:*",
    "@duncit/i18n": "workspace:*",
    "@duncit/utils": "workspace:*"
  }
}
