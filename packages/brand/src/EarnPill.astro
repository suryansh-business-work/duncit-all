---
/**
 * The floating "Earn with Duncit" pill (inside EarnShowcase.astro).
 *
 * Ships hidden; earn-section-dom.ts shows it when Website portal > Earn with
 * Duncit has the pill on. It slides in once the visitor is past the hero, steps
 * aside while the Earn section is on screen, and stays closed for the visit
 * once dismissed. The link jumps to the section, where the real CTA is.
 */
import { siteT, type SiteTranslate } from './site-i18n';

interface Props {
  /** The Earn section's anchor, e.g. "#earn-with-duncit". */
  target: string;
  t?: SiteTranslate;
}

const { target, t = siteT } = Astro.props;
---

<div class="earn-pill" data-earn-pill hidden>
  <a class="earn-pill-link" href={target}>
    <span class="earn-pill-icon" aria-hidden="true"><i class="fa-solid fa-sack-dollar"></i></span>
    <span data-earn-pill-label>{t('website.brand.earnShowcase.floating')}</span>
    <i class="fa-solid fa-arrow-down earn-pill-arrow" aria-hidden="true"></i>
  </a>
  <button type="button" class="earn-pill-close" data-earn-pill-close aria-label={t('website.brand.earnShowcase.floatingClose')}>
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
</div>

<style>
  .earn-pill {
    position: fixed;
    z-index: 40;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    border-radius: 999px;
    background: var(--color-ink, #16131a);
    color: var(--color-cream, #faf6f0);
    box-shadow: 0 18px 40px -16px color-mix(in srgb, var(--color-frame, #100e14) 70%, transparent);
    transform: translateY(140%);
    opacity: 0;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
  }
  .earn-pill.is-visible {
    transform: none;
    opacity: 1;
  }
  .earn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0 0.875rem 0 0.25rem;
    border-radius: 999px;
    font-family: var(--font-head, system-ui, sans-serif);
    font-weight: 800;
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: none;
  }
  .earn-pill-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--earn-accent, var(--color-primary, #ff5757));
    /* The accent never inverts, so the glyph on it must not either. */
    color: #16131a;
    animation: earn-pill-pulse 2.4s ease-in-out infinite;
  }
  .earn-pill-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .earn-pill-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    opacity: 0.7;
    cursor: pointer;
  }
  .earn-pill-close:hover {
    opacity: 1;
  }
  .earn-pill-link:focus-visible,
  .earn-pill-close:focus-visible {
    outline: 3px solid var(--color-primary, #ff5757);
    outline-offset: 2px;
  }
  @keyframes earn-pill-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--earn-accent, #ff5757) 55%, transparent);
    }
    50% {
      box-shadow: 0 0 0 8px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .earn-pill,
    .earn-pill-icon {
      transition: none;
      animation: none;
    }
  }
</style>
