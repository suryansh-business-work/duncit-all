{
  "name": "@duncit/buttons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The MUI half of Duncit's press system: DuncitButton and DuncitIconButton, plus the theme layer that gives every other MUI pressable the same active, hover, focus, disabled and loading states.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/buttons"
  },
  "dependencies": {
    "@duncit/buttons-native": "workspace:*"
  },
  "peerDependencies": {
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@mui/material": "^9.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
