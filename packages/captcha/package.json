{
  "name": "@duncit/captcha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The human check every public form uses: the framework-free client + DOM helpers at the root, the Astro widget as a component, the MUI field behind ./mui. One widget, one wire format, one set of words.",
