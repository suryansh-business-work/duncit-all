{
  "name": "@duncit/captcha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The human check every public form uses: the framework-free client + DOM helpers at the root, the Astro widget as a component, the MUI field behind ./mui. One widget, one wire format, one set of words.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mui": "./src/mui/index.ts",
    "./Captcha.astro": "./src/Captcha.astro"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/captcha"
  },
  "dependencies": {
    "@duncit/i18n": "workspace:*"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "astro": "^5.7.10",
    "react": ">=18",
    "react-hook-form": ">=7",
    "@duncit/forms": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "@duncit/forms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duncit/forms": "workspace:*",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
