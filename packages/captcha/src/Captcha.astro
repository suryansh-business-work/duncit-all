---
/**
 * The human check, as plain HTML.
 *
 * Drop it INSIDE a `<form>` and it needs nothing else: the two inputs it
 * renders are named `captcha_token` and `captcha_answer`, so the form's own
 * `new FormData(form)` already carries them. The submit handler merges them
 * into its mutation input with `captchaFieldsFrom(form)` and, after every
 * attempt, calls `reloadCaptcha(form)` — a code is spent whether the answer
 * was right or wrong.
 *
 * Plain CSS on purpose, like every other component here that ships to an Astro
 * site: this package sits outside each site's Tailwind source scan, so
 * utilities written here would compile to nothing. Only the brand tokens are
 * borrowed, and every site declares those.
 */
import { CAPTCHA_FALLBACK_COPY, type CaptchaCopy } from '@duncit/i18n';

interface Props {
  /** Where to POST. The site already has this resolved per environment. */
  graphqlUrl: string;
  /** The widget's words. Sites with a translator pass `captchaCopy(t)`. */
  copy?: CaptchaCopy;
  /**
   * Stay hidden until the visitor starts filling the form in.
   *
   * For a one-field row — a footer newsletter box — a code picture sitting
   * there before anyone has typed anything reads as a wall rather than a
   * check. It appears on the first keystroke, which is still long before
   * there is anything to submit.
   */
  defer?: boolean;
  class?: string;
}

const {
  graphqlUrl,
  copy = CAPTCHA_FALLBACK_COPY,
  defer = false,
  class: className = '',
} = Astro.props;

// One id per instance, so two forms on a page cannot capture each other's
// label or input.
const id = `captcha-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['captcha', className]}
  data-captcha-root
  data-graphql={graphqlUrl}
  data-defer={defer ? '1' : ''}
  data-msg-required={copy.required}
  data-msg-wrong={copy.wrong}
  data-msg-expired={copy.expired}
  data-msg-unavailable={copy.unavailable}
  hidden={defer}
>
  <span class="captcha-title">{copy.title}</span>
  <div class="captcha-row">
    <img class="captcha-image" data-captcha-image alt={copy.imageAlt} width="180" height="60" />
    <button
      type="button"
      class="captcha-refresh"
      data-captcha-refresh
      title={copy.refresh}
      aria-label={copy.refresh}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M17.65 6.35A8 8 0 1 0 19.73 14h-2.09A6 6 0 1 1 12 6a5.94 5.94 0 0 1 4.22 1.78L13 11h7V4z"
        ></path>
      </svg>
    </button>
    <div class="captcha-entry">
      <label class="captcha-label" for={id}>{copy.label}</label>
      {/* `required` is set by the script once the widget is actually visible:
          a hidden required control makes `form.reportValidity()` fail with
          nothing to focus, which would deadlock a deferred newsletter row. */}
      <input
        id={id}
        class="captcha-input"
        name="captcha_answer"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="8"
      />
    </div>
  </div>
  <input type="hidden" name="captcha_token" data-captcha-token value="" />
  <p class="captcha-hint">{copy.hint}</p>
  <p class="captcha-error" data-captcha-error role="alert" aria-live="polite"></p>
</div>

<script>
  import { CAPTCHA_RELOAD_EVENT, requestCaptchaChallenge } from '@duncit/captcha';

  // Every instance wires itself from its own data attributes, so one script
  // serves a contact form and a footer newsletter without either knowing
  // about the other.
  for (const root of document.querySelectorAll<HTMLElement>('[data-captcha-root]')) {
    const image = root.querySelector<HTMLImageElement>('[data-captcha-image]');
    const token = root.querySelector<HTMLInputElement>('[data-captcha-token]');
    const answer = root.querySelector<HTMLInputElement>('[name="captcha_answer"]');
    const error = root.querySelector<HTMLElement>('[data-captcha-error]');
    const refresh = root.querySelector<HTMLButtonElement>('[data-captcha-refresh]');
    const graphqlUrl = root.dataset.graphql ?? '';
    if (!image || !token || !answer || !error || !refresh) continue;

    const say = (message: string) => {
      error.textContent = message;
    };
    const unavailable = () => say(root.dataset.msgUnavailable ?? '');

    // `defaultValue` tracks `value` throughout, so a form calling `reset()`
    // after a successful send keeps the code we just fetched instead of
    // restoring the empty one this input was rendered with.
    const setToken = (value: string) => {
      token.value = value;
      token.defaultValue = value;
    };

    let inFlight = false;
    const load = async () => {
      if (inFlight) return;
      inFlight = true;
      refresh.disabled = true;
      setToken('');
      try {
        const challenge = await requestCaptchaChallenge(graphqlUrl);
        if (challenge) {
          image.src = challenge.image;
          setToken(challenge.token);
        } else {
          unavailable();
        }
      } finally {
        inFlight = false;
        refresh.disabled = false;
      }
    };
    const reload = () => {
      load().catch(unavailable);
    };

    refresh.addEventListener('click', () => {
      say('');
      answer.value = '';
      answer.focus();
      reload();
    });

    // `required` is only ever set on a VISIBLE control: the browser refuses to
    // report a validity error it cannot focus, which would deadlock the form.
    const reveal = () => {
      root.hidden = false;
      answer.required = true;
    };

    // The form asks for a new code after every attempt — a code is spent
    // whether the answer was right or wrong — and says why when it knows.
    root.addEventListener(CAPTCHA_RELOAD_EVENT, (event) => {
      const code = (event as CustomEvent<{ code?: string | null }>).detail?.code;
      const messages: Record<string, string | undefined> = {
        required: root.dataset.msgRequired,
        wrong: root.dataset.msgWrong,
        expired: root.dataset.msgExpired,
      };
      say((code && messages[code]) || '');
      answer.value = '';
      // A deferred widget that never revealed itself — an address filled in by
      // a password manager, say — must appear NOW, or the server's refusal
      // lands on a form with nothing on it to explain the refusal.
      reveal();
      reload();
    });

    if (root.dataset.defer) {
      // Revealed on the first keystroke anywhere in the form, and only once.
      root.closest('form')?.addEventListener(
        'input',
        () => {
          reveal();
          reload();
        },
        { once: true }
      );
    } else {
      reveal();
      reload();
    }
  }
</script>

<style>
  .captcha {
    display: block;
    margin-top: 0.5rem;
  }
  .captcha[hidden] {
    display: none;
  }

  .captcha-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft, #4b4651);
  }

  .captcha-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .captcha-image {
    display: block;
    width: 180px;
    height: 60px;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line, rgba(22, 19, 26, 0.08));
    background: #f2f2f4;
  }

  .captcha-refresh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line, rgba(22, 19, 26, 0.08));
    border-radius: 999px;
    background: var(--color-surface, #fff);
    color: var(--color-ink-soft, #4b4651);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .captcha-refresh:hover {
    color: var(--color-primary, #ff5757);
    border-color: var(--color-primary, #ff5757);
  }
  .captcha-refresh:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .captcha-entry {
    display: grid;
    gap: 0.25rem;
    flex: 1 1 10rem;
    min-width: 0;
  }
  .captcha-label {
    font-size: 0.75rem;
    color: var(--color-ink-soft, #4b4651);
  }
  .captcha-input {
    width: 100%;
    border: 1px solid var(--color-line, rgba(22, 19, 26, 0.08));
    border-radius: 0.75rem;
    background: var(--color-surface, #fff);
    padding: 0.625rem 0.875rem;
    font: inherit;
    font-size: 0.9375rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink, #16131a);
    outline: none;
    transition: border-color 150ms ease;
  }
  .captcha-input:focus {
    border-color: var(--color-primary, #ff5757);
  }

  .captcha-hint {
    margin: 0.375rem 0 0;
    font-size: 0.75rem;
    color: var(--color-ink-soft, #4b4651);
  }

  /* Reserved height, so a message appearing does not shift the form. */
  .captcha-error {
    margin: 0.25rem 0 0;
    min-height: 1.1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #c0392b;
  }
</style>
