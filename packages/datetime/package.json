{
  "name": "@duncit/datetime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admin-driven date/time core — one clock and one formatter for mobile, mWeb and every portal. Zero runtime deps (date-fns are peers) so React Native, browser and Node can all consume it.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/datetime"
  },
  "peerDependencies": {
    "date-fns": ">=2",
    "date-fns-tz": ">=2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
