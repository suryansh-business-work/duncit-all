{
  "name": "@duncit/docs-demos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One runnable demo set per shared package — realistic mock data, the live component, and the exact source. Read by the Tech portal’s Package Documentation and by the docs site, so an example exists once.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./demos/*": "./src/demos/*",
    "./examples/*": "./src/examples/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/docs-demos"
  },
