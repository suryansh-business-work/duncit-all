{
  "name": "@duncit/entity-consoles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The four directory consoles — venues, clubs, club admins, hosts. One brief-dashboard-then-list-then-detail scaffold over four entities, mounted by the four dedicated portals and by admin and onboarding, so a column added here shows up everywhere instead of in a third copy.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/entity-consoles"
  },
  "dependencies": {
    "@duncit/app-settings": "workspace:*",
    "@duncit/availability-calendar": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/category": "workspace:*",
    "@duncit/dialogs": "workspace:*",
    "@duncit/forms": "workspace:*",
    "@duncit/location": "workspace:*",
    "@duncit/logs": "workspace:*",
    "@duncit/media-picker": "workspace:*",
    "@duncit/shell": "workspace:*",
    "@duncit/table": "workspace:*",
    "@duncit/tabs": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/user-context": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@mui/x-date-pickers": "^9.12.0",
    "date-fns": "^4.4.0",
    "react-router": "^8.3.1",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "graphql": ">=16",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=8"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.12",
    "@duncit/app-settings": "workspace:*",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
