{
  "name": "@duncit/forms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared RHF+Zod form scaffold for the portals: RhfTextField (MUI TextField wired into react-hook-form), the legacy FormProvider-based FormField, and the zodRules validation fragment builders. One copy, not eighteen.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "peerDependencies": {
    "@duncit/regex": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=3"
  },
  "devDependencies": {
    "@duncit/regex": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@mui/material": "^9.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  },
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/forms"
  },
  "module": "./src/index.ts",
  "react-native": "./src/schemas/index.ts",
  "files": [
    "src"
  ],
  "peerDependenciesMeta": {
    "@duncit/regex": {
      "optional": true
    },
    "@duncit/utils": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
