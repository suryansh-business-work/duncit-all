{
  "name": "@duncit/gig-jobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gig Jobs as one MUI set for mWeb and the Partners console: the board, a gig's page with contact sharing, the post form, My posts and the freelancer profile. The contract (documents, labels, form conversion) lives framework-free in @duncit/utils so the native app reads the same.",
  "main": "./src/index.ts",
