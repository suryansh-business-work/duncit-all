{
  "name": "@duncit/i18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The localization parser + runtime. One t() for every portal, mWeb, the native app, the Astro websites and MJML emails. Zero runtime deps so React, React Native, Astro build steps and Node can all consume it.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "node ../../scripts/verify-translation-keys.mjs ../.. && vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:keys": "node ../../scripts/verify-translation-keys.mjs ../..",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/i18n"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
