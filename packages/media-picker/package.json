{
  "name": "@duncit/media-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ImageKit + Pexels media picker dialog (device upload, Pexels photos, Pexels videos) used by mWeb and every portal. One copy, not six.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/media-picker"
  },
  "dependencies": {
    "@duncit/ai-monitoring": "workspace:*",
    "@duncit/app-settings": "workspace:*",
    "@duncit/i18n": "workspace:*",
    "@duncit/tabs": "workspace:*",
    "@duncit/utils": "workspace:*",
    "react-easy-crop": "^5.5.7"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "graphql": ">=16",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^2.1.9",
    "graphql": "^16.14.2",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
