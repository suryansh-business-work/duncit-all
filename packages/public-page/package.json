{
  "name": "@duncit/public-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Publish a venue or host page: the tracked duncit.com link, its QR, the printable A4 poster and the owner's tracking numbers, as one MUI card for mWeb and the Partners console. The contract lives framework-free in @duncit/utils so the native app renders the same card through its own Tamagui view.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@duncit/app-settings": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/logs": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@duncit/ui": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^16.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/public-page"
  }
}
