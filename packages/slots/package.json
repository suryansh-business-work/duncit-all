{
  "name": "@duncit/slots",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One slot-selection experience for every surface: framework-free grouping/labelling logic plus the MUI calendar that renders it. Import the root for logic, ./mui in portals and mWeb; the app renders the same logic through its own Tamagui view.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mui": "./src/mui/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/slots"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "@mui/x-date-pickers": ">=6",
    "date-fns": ">=2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^2.1.9",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
