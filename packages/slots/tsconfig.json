{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  // The Tamagui views need react-native and @expo/vector-icons types, which only
  // the mobile app installs. It compiles this package from source, so `src/native`
  // is typechecked there rather than pulling an RN toolchain into every portal.
  "exclude": ["src/native/**"]
}
