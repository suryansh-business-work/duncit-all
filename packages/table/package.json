{
  "name": "@duncit/table",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared server-driven AG Grid + MUI table (search, sort, filters, pagination, column prefs) used by every portal. One table, one path.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-setup": "./src/test-setup.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/table"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "@mui/x-date-pickers": ">=6",
    "ag-grid-community": ">=34",
    "ag-grid-react": ">=34",
    "date-fns": ">=2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^2.1.9",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "date-fns": "^4.4.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@duncit/app-settings": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/datetime": "workspace:*"
  }
}
