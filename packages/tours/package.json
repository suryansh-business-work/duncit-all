{
  "name": "@duncit/tours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared guided-tour registry — tour definitions, step copy and completion state. Zero runtime deps so mWeb (Joyride) and native (tour-guide) share one source of truth.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/tours"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
