{
  "name": "@duncit/utils",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic browser utilities shared by mWeb and every portal (DUID device id, …). One copy, not seventeen.",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/utils"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "jsdom": "^30.0.1",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
