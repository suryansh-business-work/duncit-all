{
  "name": "@duncit/venue-food",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A venue's food desk as its owner works it — the Food Dashboard, the food menu editor, the order board and the venue's food coupons — as one MUI set the Partners console, the Venues console and mWeb all mount. The contract (documents, labels, tiles, status flow) lives framework-free in @duncit/utils and the form rules in @duncit/forms/schemas, so the native app's Tamagui twins read the same ones.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@duncit/app-settings": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/dialogs": "workspace:*",
    "@duncit/forms": "workspace:*",
    "@duncit/logs": "workspace:*",
    "@duncit/media-picker": "workspace:*",
    "@duncit/table": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@hookform/resolvers": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "@mui/x-date-pickers": ">=6",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=4"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^16.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "e2e": "node ../../scripts/e2e-no-surface.mjs @duncit/venue-food"
  }
}
