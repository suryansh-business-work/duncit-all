    "@duncit/dialogs": "workspace:*",
    "@duncit/forms": "workspace:*",
    "@duncit/media-picker": "workspace:*",
    "@duncit/table": "workspace:*",
    "@duncit/tabs": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@duncit/venue-food": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": ">=3",
    "@hookform/resolvers": ">=3",
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
