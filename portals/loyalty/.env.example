# Duncit Loyalty (dev port 2047)
#
# Every Duncit web app shares the same env shape. Local `vite dev` needs NONE
# of these — it defaults to http://localhost:2001/graphql. CI injects the
# real values at build time; .env.staging / .env.production hold the
# non-secret URLs for local `vite build --mode staging|production`.

# API endpoint. Empty = dev localhost / build-time production default.
VITE_GRAPHQL_URL=

# Shared Google OAuth client id (secret — injected by CI, blank locally).
VITE_GOOGLE_CLIENT_ID=

# Roles allowed into this console (SUPER_ADMIN always passes). Duncit Coin and
# gift cards moved here from Finance, so the Finance seats keep a way in.
VITE_REQUIRED_ROLES=LOYALTY_MANAGER,FINANCE_MANAGER,FINANCE_USER

# The Finance console, for the payment behind a virtual gift card. Blank = the
# Finance console of the same environment as VITE_GRAPHQL_URL.
VITE_FINANCE_URL=
