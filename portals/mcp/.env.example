# Duncit MCP console (dev port 2046)
#
# Every Duncit web app shares the same env shape. Local `vite dev` needs NONE
# of these — it defaults to http://localhost:2001/graphql. CI injects the
# real values at build time; .env.staging / .env.production hold the
# non-secret URLs for local `vite build --mode staging|production`.

# API endpoint. Empty = dev localhost / build-time production default.
VITE_GRAPHQL_URL=

# Shared Google OAuth client id (secret — injected by CI, blank locally).
VITE_GOOGLE_CLIENT_ID=

# Roles allowed into this console (SUPER_ADMIN always passes).
VITE_REQUIRED_ROLES=MCP_MANAGER,MCP_USER

# Roles that see everyone's activity and the Settings page (SUPER_ADMIN always
# does). Mirrors the server's MCP_MANAGER_ROLES, which is what actually decides.
VITE_MANAGER_ROLES=MCP_MANAGER

# Where the MCP endpoints live, for the Guide's connector URL pattern. Blank =
# this console's own origin: nginx serves /mcp and /<console>/mcp on the same
# host as the console. Set http://localhost:2001 for local development.
VITE_MCP_URL=
