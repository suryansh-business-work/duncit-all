# Duncit Server (port 2001)
#
# This lists ONLY the values the server reads from process.env. All managed
# service credentials (SMTP / ImageKit / Pexels / Google / OpenAI / Twilio /
# Razorpay / ShipRocket / Servam) are configured in the Tech portal and
# resolved from the database at runtime — see the note at the bottom.
#
# Production/staging server.env is rendered by the deploy workflow from GitHub
# secrets; there is intentionally no committed .env.production / .env.staging.

# ---- Core (required) ----
NODE_ENV=development
PORT=2001
MONGO_URI=
# Optional: DNS resolver(s) for the MongoDB Atlas SRV lookup, comma-separated.
# Set this if the server fails with "querySrv ECONNREFUSED" while Compass still
# connects — that means Node's DNS resolver is being refused for the mongodb+srv
# SRV record, and a public resolver fixes it. Outside production the server
# auto-applies these after the first such failure, so this is usually only
# needed to make attempt #1 succeed. Leave EMPTY in production — it would
# override Docker's internal DNS (signoz-otel-collector, open-wa, …).
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=change-me-in-production

# ---- Deployment identity ----
# APP_ENV self-identifies the deployment (health, telemetry, staging-aware
# status probes). MONGO_DB_NAME overrides the database — staging uses
# duncit-staging so its data is fully separate from production.
# APP_ENV=production
# MONGO_DB_NAME=

# ---- Data clone (Tech portal > Server > Data Clone) ----
# Copies production into staging, server-side. The endpoints now LIVE IN THE DB:
# both are saved and proved from Data Clone > Settings, and a clone refuses to
# start until each one has actually been reached with the exact string saved for
# it. Nothing is ever hardcoded.
#
# These four vars are only the SEED for a role that has never been configured:
# they pre-fill the dialog the first time it is opened on an existing stack, and
# are ignored from then on (editing them later changes nothing — edit the
# settings). A seeded connection is never "connected" until an operator presses
# Connect. SOURCE_URI falls back to MONGO_URI; SOURCE_DB falls back to
# MONGO_DB_NAME and then to the database this server is connected to (production
# omits MONGO_DB_NAME on purpose); TARGET_URI falls back to the source URI, since
# staging shares the cluster. A target that resolves to the source cluster AND
# database is refused outright, wherever the values came from.
# DATA_CLONE_SOURCE_URI=
# DATA_CLONE_SOURCE_DB=
# DATA_CLONE_TARGET_URI=
# DATA_CLONE_TARGET_DB=duncit-staging

# ---- Runtime URL/config (unmapped keys, read from process.env) ----
IS_DEVELOPMENT=true
SERVER_URL=http://localhost:2001
GRAPHQL_URL=http://localhost:2001/graphql
MWEB_BASE_URL=http://localhost:2003
PUBLIC_APP_URL=http://localhost:2003
PUBLIC_SITE_URL=http://localhost:2000

# ---- OpenWA gateway + telemetry ----
OPENWA_API_MASTER_KEY=
# OPENWA_INTERNAL_URL=http://open-wa:2024
# OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
# OTEL_SERVICE_NAME=duncit-server

# ---- Super-admin bootstrap (created on first boot if missing) ----
DEFAULT_SUPER_ADMIN_EMAIL=admin@duncit.com
DEFAULT_SUPER_ADMIN_PASSWORD=12345678

# ---- Status page ----
# STATUS_PROBES_DISABLED=1 turns off the 5-minute prober.
# STATUS_SEED_INCIDENTS=1 seeds sample incidents (auto-on for staging).

# ---- Optional ----
# NGROK_AUTHTOKEN=

# =====================================================================
# MANAGED IN THE TECH PORTAL — DO NOT set these here (read from the DB):
#   SMTP_HOST/PORT/USER/PASS/FROM, IMAGEKIT_PUBLIC_KEY/PRIVATE_KEY/URL_ENDPOINT,
#   PEXELS_API_KEY, GOOGLE_CLIENT_ID/SECRET, GOOGLE_MAP_API, OPENAI_API_KEY/
#   BASE_URL/MODEL, TWILIO_*, SERVAM_*, RAZORPAY_*, SHIPROCKET_*.
# =====================================================================
