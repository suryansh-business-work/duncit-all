    "migrate:email-chrome:dry": "ts-node -r tsconfig-paths/register --transpile-only scripts/migrate-email-chrome.ts --dry-run",
    "migrate:email-chrome:local": "ts-node -r tsconfig-paths/register --transpile-only scripts/migrate-email-chrome.ts --uri mongodb://127.0.0.1:27017/duncit-local",
