{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "deps:check": "node ../scripts/deps.mjs check",
    "deps:update": "node ../scripts/deps.mjs update",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "dev:main": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "dev:staging": "cross-env MONGO_DB_NAME=duncit-staging ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/copy-email-templates.js",
