<mjml>
  <mj-head>
    <mj-title>You received a gift card</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#222222" font-size="14px" line-height="22px" />
      <mj-button background-color="#3b82f6" color="#ffffff" border-radius="8px" font-weight="700" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#222">
          {{t:email.giftCard.title}}, {{recipient_name}} 🎁
        </mj-text>
        <mj-text font-size="14px" color="#555">
          <strong>{{sender_name}}</strong> {{t:email.giftCard.intro}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#1e1b4b" border-radius="12px" padding="24px 20px">
      <mj-column>
        <mj-text font-size="13px" color="#c7d2fe" align="center" letter-spacing="1px">
          {{scope_label}}
        </mj-text>
        <mj-text font-size="34px" font-weight="bold" color="#ffffff" align="center" padding-top="4px">
          {{amount}}
        </mj-text>
        <mj-text font-size="18px" font-weight="bold" color="#fbbf24" align="center" letter-spacing="2px" padding-top="8px">
          {{code}}
        </mj-text>
        <mj-text font-size="12px" color="#c7d2fe" align="center" padding-top="4px">
          {{t:email.giftCard.expires}} {{expires_on}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#555" font-style="italic">
          {{message_line}}
        </mj-text>
        <mj-button href="{{redeem_url}}" align="center">
          {{t:email.giftCard.redeemCta}}
        </mj-button>
        <mj-text font-size="13px" color="#888">
          {{t:email.giftCard.howItWorks}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
