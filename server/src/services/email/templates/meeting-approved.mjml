<mjml>
  <mj-head>
    <mj-title>Your Duncit onboarding is approved</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#222222" font-size="14px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#222">
          Congratulations, {{name}}! 🎉
        </mj-text>
        <mj-text font-size="14px" color="#555">
          Your {{kind}} onboarding has been approved after your meeting with the Duncit team. You're all set — open the Duncit app to start.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
