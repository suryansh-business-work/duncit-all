<mjml>
  <mj-head>
    <mj-title>{{t:email.podCalculator.title}}</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#222222" font-size="14px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#222222">{{t:email.podCalculator.title}}</mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#ff4f73">{{calculation_name}}</mj-text>
        <mj-text color="#555555">{{t:email.podCalculator.intro}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff1f4" padding="16px 20px" border-left="4px solid #ff4f73">
      <mj-column>
        <mj-text color="#7c2d12">{{t:email.podCalculator.estimateNote}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="12px 20px">
      <mj-column>
        <mj-text font-size="12px" color="#888888">{{t:email.podCalculator.footer}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
