<mjml>
  <mj-head>
    <mj-title>Signed contract</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#222222" font-size="14px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#222222">{{contract_name}}</mj-text>
        <mj-text color="#555555">{{sender_name}} has shared a signed contract with you. The signed PDF is attached to this email.</mj-text>
        <mj-text color="#555555">{{message}}</mj-text>
        <mj-text font-size="12px" color="#888888">Keep this copy for your records. If you were not expecting it, reply to this email and let us know.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
