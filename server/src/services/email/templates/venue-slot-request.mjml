<mjml>
  <mj-head>
    <mj-title>New slot booking request</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#222222" font-size="14px" line-height="22px" />
      <mj-button background-color="#3b82f6" color="#ffffff" border-radius="8px" font-weight="700" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section padding="20px 0 0 0">
      <mj-column>
        <mj-image src="{{brand_logo_url}}" alt="Duncit" width="110px" align="center" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#222">
          {{t:email.venueSlotRequest.title}}, {{owner_name}}
        </mj-text>
        <mj-text font-size="14px" color="#555">
          <strong>{{host_name}}</strong> {{t:email.venueSlotRequest.intro}} <strong>{{venue_name}}</strong>. {{t:email.venueSlotRequest.hold}}
        </mj-text>
        <mj-text font-size="14px" color="#555">
          {{t:email.venueSlotRequest.pod}}: <strong>{{pod_title}}</strong><br />
          {{t:email.venueSlotRequest.slot}}: <strong>{{when}}</strong>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="50%" padding="0 6px 0 0">
        <mj-button href="{{approve_url}}" background-color="#16a34a" align="center" padding="0">
          {{t:email.venueSlotRequest.approve}}
        </mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 0 0 6px">
        <mj-button href="{{decline_url}}" background-color="#dc2626" align="center" padding="0">
          {{t:email.venueSlotRequest.decline}}
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column>
        <mj-text font-size="13px" color="#888">
          {{t:email.venueSlotRequest.earningsNote}}
        </mj-text>
        <mj-text font-size="13px" color="#888">
          <a href="{{review_url}}" style="color:#3b82f6;">{{t:email.venueSlotRequest.reviewAll}}</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 0 24px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#888888">&copy; Duncit. {{t:email.venueSlotRequest.footer}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
