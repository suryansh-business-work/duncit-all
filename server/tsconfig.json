{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node 20 runs ES2022. The inherited target is ES2020, whose lib has no
    // String#replaceAll — which is why 15 replace(/g) calls could not be
    // modernised (Sonar S7781). Widening only the LIB (not the target) gives us
    // the newer runtime APIs while the emit stays exactly as it was.
    "lib": ["ES2022"],
    "module": "CommonJS",
    // Node resolution, with baseUrl-relative paths, because this project stays
    // on TypeScript 5 (see the typescript pin in package.json): its lazy
    // `await import('@modules/…')` calls resolve through tsconfig-paths at
    // RUNTIME, which node16 module semantics would require extensions for.
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@config/*": ["./src/config/*"],
      "@services/*": ["./src/services/*"],
      "@utils/*": ["./src/utils/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@realtime/*": ["./src/realtime/*"],
      "@generated/*": ["./src/generated/*"],
      "@modules/*": ["./src/modules/*"],
      "@observability/*": ["./src/observability/*"],
      "@context": ["./src/context.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
