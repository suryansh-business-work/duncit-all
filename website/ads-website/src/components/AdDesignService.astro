---
import { siteContent } from '../config/site-config';
import SectionHead from './SectionHead.astro';
import SmartLink from './SmartLink.astro';

const { design } = await siteContent();
---

<!-- The most common reason a small brand never books an ad is that it has
     nothing to run. This answers that right after the price. -->
<section id="design" class="scroll-mt-28 py-20 sm:py-28 lg:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="relative" data-reveal="left">
      <img
        src={design.image}
        alt={design.imageAlt}
        loading="lazy"
        class="aspect-[4/5] w-full rounded-panel-lg object-cover shadow-lift"
      />
      <!-- A designer's frame over the photograph: the thing being offered,
           sitting on the desk it comes from. Decorative. -->
      <div
        class="bob absolute -bottom-6 -right-3 hidden w-48 rounded-3xl border border-line bg-surface p-4 shadow-lift sm:block"
        aria-hidden="true"
      >
        <div class="flex items-center gap-2">
          <span class="h-8 w-8 rounded-xl bg-primary"></span>
          <div class="flex-1">
            <div class="h-2 w-16 rounded-full bg-ink/25"></div>
            <div class="mt-1.5 h-1.5 w-10 rounded-full bg-ink/15"></div>
          </div>
        </div>
        <div class="mt-3 h-16 rounded-xl bg-linear-to-br from-primary-light to-accent-light"></div>
        <div class="mt-3 h-7 w-24 rounded-full bg-primary"></div>
      </div>
      <span
        class="absolute -left-2 top-6 -rotate-6 rounded-full bg-accent px-4 py-2 font-head text-sm font-extrabold text-on-accent shadow-soft"
        aria-hidden="true"
      >
        {design.items[0].title}
      </span>
    </div>

    <div>
      <SectionHead eyebrow={design.eyebrow} heading={design.heading} text={design.text} layout="stack" />

      <ul class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal-group>
        {
          design.items.map((item) => (
            <li class="lift rounded-3xl border border-line bg-surface p-6 shadow-soft" data-reveal>
              <span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary-light text-primary-strong">
                <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
              </span>
              <h3 class="mt-5 text-lg text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-5" data-reveal>
        <SmartLink
          href={design.cta.href}
          label={design.cta.label}
          glyph={false}
          class="btn-primary inline-flex min-h-12 px-7 text-base"
        >
          {design.cta.label}
        </SmartLink>
        <p class="max-w-xs text-sm text-ink-soft">{design.note}</p>
      </div>
    </div>
  </div>
</section>
