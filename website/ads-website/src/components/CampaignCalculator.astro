---
import { siteContent } from '../config/site-config';
import { fetchAdRateCard } from '../lib/site-data';
import PlacementPreview from './PlacementPreview.astro';
import SectionHead from './SectionHead.astro';
import SmartLink from './SmartLink.astro';

const { calculator, graphqlUrl } = await siteContent();
// The card as it was at build time: the chips and the slider render with real
// placements and real prices before any JavaScript runs. The widget refreshes
// it, so a price Marketing changed after this deploy is still the one quoted —
// and if this build could not reach the API at all, the refresh builds the
// chips itself.
const rateCard = await fetchAdRateCard();
const initial = rateCard ?? {
  currency_symbol: '₹',
  entries: [],
  min_days: 1,
  max_days: 30,
  from_per_day: 0,
  to_per_day: 0,
};
const defaultDays = Math.min(7, initial.max_days);
const defaultPick = 'HOME_BOTTOM';
// The strings the widget shows (@duncit/brand/widgets/campaign-calculator).
const widgetCopy = {
  perDaySuffix: calculator.perDaySuffix,
  note: calculator.note,
  emptyNote: calculator.emptyNote,
  failedNote: calculator.failedNote,
  dayOne: calculator.dayOne,
  daysMany: calculator.daysMany,
};
---

<!-- Tick the placements, choose the days, watch the phone light up and the
     price add itself. Every figure comes from the platform's own rate card. -->
<section
  id="calculator"
  class="scroll-mt-28 px-3 py-6 sm:px-5"
  data-cms-widget="campaign-calculator"
  data-graphql-url={graphqlUrl}
  data-config={JSON.stringify({ initial, defaultPick })}
  data-copy={JSON.stringify(widgetCopy)}
>
  <div class="relative isolate mx-auto max-w-7xl overflow-hidden rounded-panel-lg bg-surface px-5 py-16 shadow-soft sm:px-10 lg:px-16 lg:py-24">
    <div class="blob -left-32 -top-32 -z-10 h-80 w-80 bg-accent opacity-20" aria-hidden="true"></div>
    <SectionHead eyebrow={calculator.eyebrow} heading={calculator.heading} text={calculator.text} layout="stack" />

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-16">
      <form class="grid gap-8" data-ads-form novalidate data-reveal>
        <fieldset class="border-0 p-0">
          <legend class="font-head text-sm font-extrabold text-ink">{calculator.placementsLabel}</legend>
          <p class="mt-1 text-sm text-ink-soft">{calculator.placementsHint}</p>
          <div class="mt-4 flex flex-wrap gap-2" data-placements>
            {
              initial.entries.map((entry) => (
                <label class="placement-chip cursor-pointer">
                  <input
                    type="checkbox"
                    name="placement"
                    value={entry.position}
                    checked={entry.position === defaultPick}
                    class="sr-only"
                  />
                  <span class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink-soft transition">
                    {entry.label}
                    <span class="text-xs font-bold opacity-70" data-chip-price={entry.position}>
                      {initial.currency_symbol}
                      {Math.round(entry.price_per_day).toLocaleString('en-IN')}
                      {calculator.perDaySuffix}
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <label class="block">
          <span class="flex items-baseline justify-between gap-3">
            <span class="font-head text-sm font-extrabold text-ink">{calculator.daysLabel}</span>
            <output class="font-head text-2xl font-extrabold text-primary-strong" data-days-out for="days"></output>
          </span>
          <input
            class="mt-4 h-11 w-full cursor-pointer accent-[var(--color-primary)]"
            type="range"
            id="days"
            name="days"
            min={initial.min_days}
            max={initial.max_days}
            step="1"
            value={defaultDays}
          />
          <span class="mt-1 block text-sm text-ink-soft">{calculator.daysHint}</span>
        </label>

        <div class="rounded-panel border border-line bg-cream p-6 sm:p-8" aria-live="polite">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="font-head text-sm font-extrabold text-ink-soft">{calculator.totalLabel}</span>
            <span class="font-head text-5xl font-extrabold tracking-tight text-ink" data-total>—</span>
          </div>
          <dl class="mt-5 space-y-2 text-sm" data-rows></dl>
          <p class="mt-5 text-xs text-ink-soft" data-note>{calculator.note}</p>
          <SmartLink
            href={calculator.cta.href}
            label={calculator.cta.label}
            glyph={false}
            class="btn-primary mt-6 inline-flex min-h-12 px-7 text-sm"
          >
            {calculator.cta.label}
            <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
          </SmartLink>
        </div>
      </form>

      <div data-reveal="right">
        <PlacementPreview />
      </div>
    </div>

    <p class="mt-10 max-w-3xl text-xs text-ink-soft">{calculator.disclaimer}</p>
  </div>
</section>

<style is:global>
  /* Global on purpose: the widget redraws the chips from the live card, and
     redrawn chips carry no component scope. The checkbox is off-screen; the
     chip beside it carries the state, so it stays keyboard-operable. */
  .placement-chip > span {
    min-height: 2.75rem;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 300ms var(--ease-smooth);
  }
  .placement-chip:hover > span {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }
  .placement-chip input:checked + span {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-accent);
  }
  .placement-chip input:focus-visible + span {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  /* The widget marks a warning note `text-primary-dark`; on this panel that
     step falls short of 4.5:1 in both themes, so warnings take the strong one. */
  [data-cms-widget='campaign-calculator'] [data-note].text-primary-dark {
    color: var(--color-primary-strong);
  }
</style>

<script>
  import { mount } from '@duncit/brand/widgets/campaign-calculator';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="campaign-calculator"]')) mount(root);
</script>
