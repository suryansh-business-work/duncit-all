---
import { siteContent } from '../config/site-config';
import SmartLink from './SmartLink.astro';

const { cta, hero } = await siteContent();
// Orbiting marks around the closing line. Decoration only.
const orbits = [
  { icon: 'fa-bullhorn', place: 'left-[6%] top-14 -rotate-12 bg-frame text-on-frame' },
  { icon: 'fa-eye', place: 'right-[8%] top-10 rotate-6 bg-accent text-on-accent [animation-delay:-3s]' },
  { icon: 'fa-calendar-check', place: 'bottom-12 left-[12%] rotate-6 bg-surface text-primary-strong [animation-delay:-1.5s]' },
  { icon: 'fa-hand-pointer', place: 'bottom-16 right-[10%] -rotate-6 bg-frame text-accent [animation-delay:-4.5s]' },
];
---

<section class="px-3 py-6 sm:px-5" aria-labelledby="cta-heading">
  <div
    class="relative isolate mx-auto max-w-7xl overflow-hidden rounded-panel-lg bg-primary px-6 py-20 text-center sm:px-16 lg:py-28"
    data-reveal="scale"
  >
    {
      orbits.map((orbit) => (
        <span
          class:list={['bob absolute -z-10 hidden h-16 w-16 place-items-center rounded-2xl shadow-soft xl:grid', orbit.place]}
          aria-hidden="true"
        >
          <i class:list={['fa-solid', orbit.icon, 'text-2xl']} />
        </span>
      ))
    }
    <p class="font-head text-sm font-extrabold uppercase tracking-[0.14em] text-on-accent">{hero.eyebrow}</p>
    <h2 id="cta-heading" class="display mx-auto mt-4 max-w-3xl text-on-accent">{cta.heading}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg font-semibold text-on-accent">{cta.text}</p>
    <SmartLink
      href={cta.button.href}
      label={cta.button.label}
      glyph={false}
      class="mt-10 inline-flex min-h-14 items-center gap-2 rounded-full bg-frame px-9 font-head text-base font-extrabold text-on-frame transition duration-300 hover:-translate-y-0.5 hover:scale-[1.02]"
    >
      {cta.button.label}
      <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
    </SmartLink>
  </div>
</section>
