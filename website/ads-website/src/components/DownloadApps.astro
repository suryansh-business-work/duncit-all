---
// This site's words on the shared download band. The band, the store buttons,
// the "coming soon" state and the phone live in @duncit/brand — four sites had
// four versions of the same two store listings.
import AppDownload from '@duncit/brand/AppDownload.astro';
import { fetchBranding } from '../lib/site-data';
import { getSiteTranslator } from '@duncit/brand/site-i18n';
import { siteContent, siteUrls } from '../config/site-config';

const branding = await fetchBranding();
const { download } = await siteContent();
const { t } = await getSiteTranslator(siteUrls.graphqlUrl);
const stores = [
  {
    icon: 'fa-google-play',
    eyebrow: download.googlePlayEyebrow,
    name: download.googlePlayName,
    url: branding.android_app_url,
  },
  {
    icon: 'fa-apple',
    eyebrow: download.appStoreEyebrow,
    name: download.appStoreName,
    url: branding.ios_app_url,
  },
];
---

<!-- The band eases in as one piece, like every other section on the page. -->
<div class="py-10 sm:py-16" data-reveal>
  <AppDownload
    heading={download.heading}
    headingAccent={download.headingAccent}
    text={download.text}
    perks={download.perks}
    stores={stores}
    webUrl={siteUrls.mwebUrl}
    graphqlUrl={siteUrls.graphqlUrl}
    t={t}
  />
</div>
