---
import { siteContent } from '../config/site-config';
import { fetchAdRateCard } from '../lib/site-data';
import SmartLink from './SmartLink.astro';
import HeroSlot from './home/HeroSlot.astro';
import Marquee from './home/Marquee.astro';

const { hero, proof, preview } = await siteContent();
// The same memoised request the rate table and the calculator make.
const rateCard = await fetchAdRateCard();
const placements = (rateCard?.entries ?? []).filter((entry) => entry.position !== 'AUTO');

interface Proof {
  value: string;
  label: string;
  hint: string;
}
// Facts only the rate card can vouch for are shown only when it answered.
const facts: Proof[] = [
  ...(placements.length > 0
    ? [{ value: String(placements.length), label: proof.placementsLabel, hint: proof.placementsHint }]
    : []),
  ...(rateCard ? [{ value: String(rateCard.max_days), label: proof.daysLabel, hint: proof.daysHint }] : []),
  { value: proof.liveValue, label: proof.liveLabel, hint: proof.liveHint },
];
// The band under the banner names the places an ad can run: the server's
// list when it answered, the phone's own zone labels when it did not.
const bandItems =
  placements.length > 0
    ? placements.map((entry) => entry.label)
    : Object.entries(preview)
        .filter(([key]) => key !== 'caption')
        .map(([, label]) => label);
---

<section class="overflow-x-clip p-2 sm:p-3" aria-labelledby="hero-heading">
  <div class="relative isolate overflow-hidden rounded-panel-lg bg-frame">
    <img
      src={hero.image}
      alt={hero.imageAlt}
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-wash absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="blob -right-24 -top-32 -z-10 h-[26rem] w-[26rem] bg-primary opacity-30" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 pb-24 pt-32 sm:px-8 lg:grid-cols-[1.2fr_1fr] lg:pb-32 lg:pt-40">
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-on-frame/20 bg-on-frame/10 py-1.5 pl-1.5 pr-4 font-head text-sm font-bold text-on-frame backdrop-blur"
          data-reveal="fade"
        >
          <span class="grid h-6 w-6 place-items-center rounded-full bg-primary text-on-accent">
            <i class="fa-solid fa-bullhorn text-[0.7rem]" aria-hidden="true"></i>
          </span>
          {hero.eyebrow}
        </span>
        <h1
          id="hero-heading"
          class="mt-7 max-w-3xl text-[clamp(2.75rem,1.5rem+5.4vw,5.75rem)] leading-[0.98] text-on-frame"
          data-reveal
        >
          {hero.headingLead}{' '}
          <span class="relative inline-block text-primary">
            {hero.headingAccent}
            <svg
              class="hero-underline absolute -bottom-3 left-0 h-4 w-full"
              viewBox="0 0 300 16"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M3 11 C 70 3, 170 3, 297 9" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
            </svg>
          </span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-on-frame-soft sm:text-xl" data-reveal>{hero.subheading}</p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <SmartLink
            href={hero.primaryCta.href}
            label={hero.primaryCta.label}
            glyph={false}
            class="btn-primary inline-flex min-h-14 px-8 text-base"
          >
            {hero.primaryCta.label}
            <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
          </SmartLink>
          <a
            href={hero.secondaryCta.href}
            class="inline-flex min-h-14 items-center rounded-full border border-on-frame/30 px-8 font-head text-base font-bold text-on-frame transition hover:bg-on-frame/10"
          >
            {hero.secondaryCta.label}
          </a>
        </div>

        <dl class="mt-12 grid gap-6 border-t border-on-frame/15 pt-8 sm:grid-cols-3" data-reveal-group>
          {
            facts.map((item) => (
              <div data-reveal>
                <dt class="font-head text-3xl font-extrabold tracking-tight text-on-frame">
                  {item.value} <span class="text-base font-bold text-on-frame-soft">{item.label}</span>
                </dt>
                <dd class="mt-1 text-sm text-on-frame-soft">{item.hint}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <HeroSlot />
    </div>
  </div>

  <Marquee items={bandItems} />
</section>

<style>
  /* A literal dark from the frame token, not ink: ink inverts with the theme,
     and the words on this are always light. */
  .hero-wash {
    background:
      radial-gradient(120% 90% at 15% 20%, color-mix(in srgb, var(--color-primary) 26%, transparent) 0%, transparent 60%),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-frame) 95%, transparent) 0%,
        color-mix(in srgb, var(--color-frame) 78%, transparent) 55%,
        color-mix(in srgb, var(--color-frame) 60%, transparent) 100%
      );
  }
  /* The hand-drawn line under the accent words draws itself in. */
  .hero-underline path {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: underline-draw 1.2s 0.5s var(--ease-smooth) forwards;
  }
  @keyframes underline-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-underline path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
