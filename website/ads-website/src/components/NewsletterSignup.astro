---
// This site's copy, on the shared form. The markup, the mutation and the
// status handling live in @duncit/brand — three sites had written them three
// times, each with its own idea of what happens when the API says no.
import SharedNewsletter from '@duncit/brand/NewsletterSignup.astro';
import { siteContent } from '../config/site-config';

const siteConfig = await siteContent();

const { newsletter, graphqlUrl, mainSiteUrl } = siteConfig;
---

<SharedNewsletter
  graphqlUrl={graphqlUrl}
  source={newsletter.source}
  heading={newsletter.heading}
  text={newsletter.text}
  placeholder={newsletter.placeholder}
  button={newsletter.button}
  consent={newsletter.consent}
  consentLinkLabel={newsletter.consentLinkLabel}
  consentLinkHref={`${mainSiteUrl}/policies`}
/>
