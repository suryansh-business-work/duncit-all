---
/**
 * A phone showing where each placement actually sits in the app.
 *
 * The ads site's own device — a picture of the product being sold. The
 * calculator toggles `is-live` on the zone whose placement is ticked, so
 * choosing a placement and seeing where it lands are the same action.
 */
import { siteContent } from '../config/site-config';

const { preview } = await siteContent();
---

<div class="phone-shell mx-auto w-full max-w-[280px]">
  <div class="relative rotate-2 rounded-[2.6rem] bg-frame p-2.5 shadow-lift">
    <span class="absolute left-1/2 top-2.5 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-frame"></span>

    <div class="flex h-[440px] flex-col gap-1.5 overflow-hidden rounded-[2.1rem] bg-cream p-2.5 pt-9">
      <div class="zone h-11" data-zone="STATUS"><span>{preview.STATUS}</span></div>

      <div class="flex min-h-0 flex-1 gap-1.5">
        <div class="flex min-h-0 flex-1 flex-col gap-1.5">
          <div class="zone h-16" data-zone="EXPLORE_SCROLL"><span>{preview.EXPLORE_SCROLL}</span></div>
          <div class="zone h-10" data-zone="POD_LIST"><span>{preview.POD_LIST}</span></div>
          <div class="zone h-10" data-zone="VENUE_LIST"><span>{preview.VENUE_LIST}</span></div>
          <div class="zone h-10" data-zone="CLUB_LIST"><span>{preview.CLUB_LIST}</span></div>
          <div class="zone flex-1" data-zone="POD_DETAILS"><span>{preview.POD_DETAILS}</span></div>
        </div>
        <div class="zone w-9 shrink-0" data-zone="SIDEBAR"><span class="vertical">{preview.SIDEBAR}</span></div>
      </div>

      <div class="zone h-12" data-zone="HOME_BOTTOM"><span>{preview.HOME_BOTTOM}</span></div>
    </div>
  </div>
  <p class="mt-5 text-center text-sm text-ink-soft" data-preview-caption>
    {preview.caption}
  </p>
</div>

<style>
  .zone {
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    border: 1px dashed var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    font-family: var(--font-head);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
    text-align: center;
    padding: 0 0.25rem;
    overflow: hidden;
    transition:
      background-color 250ms ease,
      color 250ms ease,
      border-color 250ms ease,
      transform 400ms var(--ease-smooth);
  }

  /* A bought placement stops looking like an empty slot — it fills and pops. */
  .zone.is-live {
    border-style: solid;
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-accent);
    box-shadow: 0 6px 18px -8px var(--color-primary);
    transform: scale(1.02);
  }
  @media (prefers-reduced-motion: reduce) {
    .zone.is-live {
      transform: none;
    }
  }

  .vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
</style>
