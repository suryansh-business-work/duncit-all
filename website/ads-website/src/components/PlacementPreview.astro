---
/**
 * A phone showing where each placement actually sits in the app.
 *
 * This is the ads site's own device — not a slogan strip, a picture of the
 * product being sold. The calculator toggles `is-live` on the zone whose
 * placement is ticked, so choosing a placement and seeing where it lands are
 * the same action.
 */
import { siteContent } from '../config/site-config';

const { preview } = await siteContent();
---

<div class="phone-shell mx-auto w-full max-w-[280px]">
  <div class="relative rounded-[2rem] border-[10px] border-[#16131a] bg-cream shadow-2xl">
    <span class="absolute left-1/2 top-0 z-10 h-4 w-20 -translate-x-1/2 rounded-b-xl bg-[#16131a]"></span>

    <div class="flex h-[430px] flex-col gap-1.5 overflow-hidden rounded-[1.4rem] p-2 pt-5">
      <div class="zone h-11" data-zone="STATUS"><span>{preview.STATUS}</span></div>

      <div class="flex min-h-0 flex-1 gap-1.5">
        <div class="flex min-h-0 flex-1 flex-col gap-1.5">
          <div class="zone h-16" data-zone="EXPLORE_SCROLL"><span>{preview.EXPLORE_SCROLL}</span></div>
          <div class="zone h-10" data-zone="POD_LIST"><span>{preview.POD_LIST}</span></div>
          <div class="zone h-10" data-zone="VENUE_LIST"><span>{preview.VENUE_LIST}</span></div>
          <div class="zone h-10" data-zone="CLUB_LIST"><span>{preview.CLUB_LIST}</span></div>
          <div class="zone flex-1" data-zone="POD_DETAILS"><span>{preview.POD_DETAILS}</span></div>
        </div>
        <div class="zone w-9 shrink-0" data-zone="SIDEBAR"><span class="vertical">{preview.SIDEBAR}</span></div>
      </div>

      <div class="zone h-12" data-zone="HOME_BOTTOM"><span>{preview.HOME_BOTTOM}</span></div>
    </div>
  </div>
  <p class="mt-3 text-center text-xs text-ink-soft" data-preview-caption>
    {preview.caption}
  </p>
</div>

<style>
  .zone {
    display: grid;
    place-items: center;
    border-radius: 0.6rem;
    border: 1px dashed var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    font-family: var(--font-head);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
    text-align: center;
    padding: 0 0.25rem;
    overflow: hidden;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  /* A bought placement stops looking like an empty slot. */
  .zone.is-live {
    border-style: solid;
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 6px 18px -8px var(--color-primary);
  }

  .vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
</style>
