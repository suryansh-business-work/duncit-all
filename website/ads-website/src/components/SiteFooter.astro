---
// Footer — links managed from the Website portal (Navigation → ADS) and the
// Policy Hub from the Legal portal; branding assets from Admin. The configured
// groups are the fallback the portal overrides.
import { siteConfig } from '../config/site-config';
import { fetchBranding, fetchNavGroups, fetchPolicies, type SiteNavGroup } from '../lib/site-data';
import NewsletterSignup from './NewsletterSignup.astro';
import SmartLink from './SmartLink.astro';
import PolicyStrip from '@duncit/brand/PolicyStrip.astro';
import SocialLinks from '@duncit/brand/SocialLinks.astro';
import FooterLogo from '@duncit/brand/FooterLogo.astro';

const { brand, footer, mainSiteUrl } = siteConfig;

const FALLBACK_GROUPS: SiteNavGroup[] = footer.groups.map((group) => ({
  label: group.label,
  links: group.links.map((link, index) => ({
    id: `fallback-${group.label}-${index}`,
    area: 'FOOTER' as const,
    group_label: group.label,
    label: link.label,
    url: link.href,
    sort_order: index,
  })),
}));

const [branding, portalGroups, policies] = await Promise.all([
  fetchBranding(),
  fetchNavGroups('FOOTER', []),
  fetchPolicies(),
]);

// The portal wins per GROUP, not all-or-nothing: anything it names is its own,
// the rest come from here. All-or-nothing meant one portal group collapsed the
// site's own into a thinner footer than either source describes.
const portalLabels = new Set(portalGroups.map((group) => group.label.toLowerCase()));
const navGroups = [
  ...portalGroups,
  ...FALLBACK_GROUPS.filter((group) => !portalLabels.has(group.label.toLowerCase())),
];
const supportEmail = branding.support_email || 'support@duncit.com';
const year = new Date().getFullYear();
// Admin's footer logo, then the header one it also manages, and only then the
// bundled file: a brand that set ONE logo should not see the local default
// down here while its own mark sits at the top of the page.

---

<footer class="mt-8 border-t border-line bg-surface/60">
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-12 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <FooterLogo
        footerSrc={branding.website_footer_logo_url}
        headerSrc={branding.website_header_logo_url}
        name={branding.app_name}
        height={112}
      />
      <p class="mt-3 font-head text-lg font-extrabold text-ink">{brand.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-soft">{footer.tagline}</p>
      <a
        href={`mailto:${supportEmail}`}
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
      >
        <i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>
        {supportEmail}
      </a>

      <SocialLinks class="mt-5" />
    </div>
    <NewsletterSignup />
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-12">
    <div class="grid grid-cols-2 gap-8 border-t border-line pt-10 sm:grid-cols-3">
      {
        navGroups.map((group) => (
          <nav aria-label={group.label}>
            <h3 class="mb-3 font-head text-xs font-extrabold uppercase tracking-wider text-ink">
              {group.label}
            </h3>
            <ul class="space-y-2">
              {group.links.map((link) => (
                <li>
                  <SmartLink
                    href={link.url}
                    label={link.label}
                    class="text-sm text-ink-soft transition hover:text-ink"
                  >
                    {link.label}
                  </SmartLink>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <PolicyStrip policies={policies} baseUrl={mainSiteUrl} class="mt-10" />
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-5 text-xs text-ink-soft"
    >
      <span>© {year} Duncit. All rights reserved.</span>
      <span>Advertising on the Duncit network.</span>
    </div>
  </div>
</footer>
