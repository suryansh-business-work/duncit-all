---
import { siteContent } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';
import SmartLink from './SmartLink.astro';
import BrandLogo from '@duncit/brand/BrandLogo.astro';
import SiteMenu from '@duncit/brand/SiteMenu.astro';
import ThemeToggle from '@duncit/brand/ThemeToggle.astro';

interface Props {
  /** Float over a full-bleed banner instead of pushing the page down. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const siteConfig = await siteContent();
const { nav } = siteConfig;
const branding = await fetchBranding();

// The bar is a frosted pill in every state, so it reads the same over the
// banner photograph and over the cream page, with no transparent phase to get
// wrong. Over a banner it takes no layout space; elsewhere it is sticky.
const position = overlay ? 'fixed inset-x-0 top-0' : 'sticky top-0';
---

<header
  class={`site-header ${position} z-30 px-3 pt-3 sm:px-5 sm:pt-4`}
  data-overlay={overlay ? 'true' : undefined}
  data-cms-widget="site-header"
>
  <nav class="glass mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 rounded-full pl-3 pr-2 sm:pl-5">
    <a href="/" class="flex min-h-11 items-center gap-2 font-head text-lg font-extrabold text-ink">
      <BrandLogo
        src={branding.website_header_logo_url}
        name={branding.app_name}
        height={40}
        href={null}
        graphqlUrl={siteConfig.graphqlUrl}
      />
      <span class="hidden tracking-tight sm:inline">
        {siteConfig.footer.duncit} <span class="text-primary-strong">{siteConfig.header.wordmarkAds}</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        nav.links.map((link) => (
          <SmartLink
            href={link.href}
            label={link.label}
            class="rounded-full px-3 py-2.5 text-sm font-semibold text-ink-soft xl:px-4 transition hover:bg-primary-light hover:text-ink"
          >
            {link.label}
          </SmartLink>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Always on screen, at every width: the theme is one tap away. -->
      <ThemeToggle label={siteConfig.header.themeToggle} />
      <SmartLink
        href={nav.login.href}
        label={nav.login.label}
        glyph={false}
        class="hidden min-h-11 items-center whitespace-nowrap rounded-full px-4 text-sm font-bold text-ink transition hover:bg-primary-light lg:inline-flex"
      >
        {nav.login.label}
      </SmartLink>
      <SmartLink
        href={nav.signup.href}
        label={nav.signup.label}
        glyph={false}
        class="btn-primary hidden min-h-11 whitespace-nowrap px-5 text-sm sm:inline-flex"
      >
        {nav.signup.label}
      </SmartLink>
      <!-- Below `lg` the drawer carries the links plus Sign in / Sign up. -->
      <SiteMenu links={nav.links} actions={[nav.signup, nav.login]} />
    </div>
  </nav>
</header>

<style>
  /* The bar settles a little deeper once the page moves under it. */
  .site-header nav {
    transition: box-shadow 300ms var(--ease-smooth);
  }
  .site-header:not(.at-top) nav {
    box-shadow: var(--shadow-lift);
  }
  /* The shared burger is 40px; a phone thumb needs 44. :global because the
     button carries SiteMenu's scope, not this component's. */
  .site-header :global(.site-menu-button) {
    width: 2.75rem;
    height: 2.75rem;
  }
</style>

<script>
  // The CMS widget @duncit/brand/widgets/site-header keeps `at-top` on the
  // header for the shadow above (it also wires the theme button).
  import { mount } from '@duncit/brand/widgets/site-header';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="site-header"]')) mount(root);
</script>
