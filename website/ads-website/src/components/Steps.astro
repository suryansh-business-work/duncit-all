---
import { siteContent } from '../config/site-config';
import SectionHead from './SectionHead.astro';

const { steps, stepsSection } = await siteContent();
---

<section id="how" class="scroll-mt-28 px-3 py-6 sm:px-5">
  <div class="mx-auto max-w-7xl rounded-panel-lg bg-surface px-5 py-16 shadow-soft sm:px-10 lg:px-16 lg:py-24">
    <SectionHead eyebrow={stepsSection.eyebrow} heading={stepsSection.heading} layout="center" />
    <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        steps.map((step, index) => (
          <li class="lift relative flex flex-col overflow-hidden rounded-panel bg-cream p-7" data-reveal>
            <span class="step-number font-head text-8xl font-extrabold leading-[0.8] tracking-tighter" aria-hidden="true">
              {index + 1}
            </span>
            <span class="mt-6 grid h-12 w-12 place-items-center rounded-2xl bg-primary text-on-accent">
              <i class={`fa-solid ${step.icon} text-lg`} aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-xl text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* An outlined numeral: the order is there at a glance without shouting. */
  .step-number {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-ink);
    opacity: 0.18;
  }
</style>
