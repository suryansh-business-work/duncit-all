---
import { siteContent } from '../config/site-config';
import SectionHead from './SectionHead.astro';

const { why } = await siteContent();
---

<section id="why" class="scroll-mt-28 px-3 py-6 sm:px-5">
  <div class="relative isolate mx-auto max-w-7xl overflow-hidden rounded-panel-lg bg-frame px-5 py-16 sm:px-10 lg:px-16 lg:py-28">
    <div class="blob -right-40 -top-40 -z-10 h-[34rem] w-[34rem] bg-primary opacity-25" aria-hidden="true"></div>
    <div class="blob -bottom-48 -left-32 -z-10 h-96 w-96 bg-accent opacity-15 [animation-delay:-9s]" aria-hidden="true"></div>

    <SectionHead eyebrow={why.eyebrow} heading={why.heading} text={why.text} onFrame />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        why.items.map((item, index) => (
          <li
            class="lift flex items-start gap-4 rounded-panel border border-on-frame/10 bg-on-frame/5 p-6"
            data-reveal
          >
            <span
              class:list={[
                'grid h-12 w-12 shrink-0 place-items-center rounded-2xl text-on-accent',
                index % 2 === 0 ? 'bg-primary' : 'bg-accent',
              ]}
            >
              <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
            </span>
            <span class="pt-1 font-head text-lg font-bold leading-snug text-on-frame">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
