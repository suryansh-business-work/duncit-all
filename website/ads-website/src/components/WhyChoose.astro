---
import { siteContent } from '../config/site-config';

const siteConfig = await siteContent();
const { why } = siteConfig;
---

<section id="why" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl text-ink sm:text-4xl">{why.heading}</h2>
    <p class="mt-4 text-ink-soft">{why.text}</p>
  </div>
  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      why.items.map((item) => (
        <li class="flex items-start gap-3 rounded-2xl border border-line bg-surface p-5 shadow-sm">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-light text-primary-dark">
            <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
          </span>
          <span class="text-sm font-semibold text-ink">{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>
