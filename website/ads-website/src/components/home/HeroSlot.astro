---
/**
 * The banner's right-hand side: an empty ad slot measured out the way a media
 * kit shows one, with the two things a campaign reports floating beside it.
 * Pure decoration — the same facts are in the copy — so it is hidden from
 * assistive tech and from narrow screens.
 */
import { siteContent } from '../../config/site-config';

const { hero } = await siteContent();
const [impressions, clicks] = hero.floats;
---

<div class="relative hidden lg:block" aria-hidden="true" data-reveal="right">
  <div class="slot-card rotate-2 rounded-panel border-2 border-dashed border-primary/70 p-4">
    <div class="rounded-[1.6rem] bg-on-frame/5 p-6 backdrop-blur">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-primary"></div>
        <div class="flex-1">
          <div class="h-2.5 w-28 rounded-full bg-on-frame/70"></div>
          <div class="mt-2 h-2 w-16 rounded-full bg-on-frame/35"></div>
        </div>
        <span class="rounded-full bg-on-frame/15 px-2.5 py-0.5 font-head text-[0.7rem] font-bold text-on-frame">
          {hero.adBadge}
        </span>
      </div>
      <div class="mt-6 h-36 rounded-2xl bg-linear-to-br from-primary/60 via-accent/40 to-primary/20"></div>
      <div class="mt-5 space-y-2.5">
        <div class="h-2.5 w-full rounded-full bg-on-frame/35"></div>
        <div class="h-2.5 w-4/5 rounded-full bg-on-frame/25"></div>
      </div>
      <div class="mt-6 h-10 w-36 rounded-full bg-primary"></div>
    </div>
  </div>
  <p class="mt-5 text-center font-head text-sm font-extrabold uppercase tracking-[0.2em] text-primary">
    {hero.slotLabel}
  </p>

  {
    [impressions, clicks].map((card, index) => (
      <div
        class:list={[
          'bob absolute flex items-center gap-3 rounded-2xl bg-surface px-4 py-3 shadow-lift',
          index === 0 ? '-left-10 top-16' : '-right-6 bottom-24 [animation-delay:-3s]',
        ]}
      >
        <span
          class:list={[
            'grid h-10 w-10 place-items-center rounded-xl text-on-accent',
            index === 0 ? 'bg-accent' : 'bg-primary',
          ]}
        >
          <i class={`fa-solid ${card.icon}`} />
        </span>
        <span>
          <b class="block font-head text-sm font-extrabold text-ink">{card.title}</b>
          <span class="text-xs font-semibold text-ink-soft">{card.text}</span>
        </span>
      </div>
    ))
  }
</div>

<style>
  /* The empty slot breathes, the way a placement waiting to be bought should. */
  .slot-card {
    animation: slot-pulse 3.6s ease-in-out infinite;
  }
  @keyframes slot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 35%, transparent);
    }
    50% {
      box-shadow: 0 0 0 14px color-mix(in srgb, var(--color-primary) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slot-card {
      animation: none;
    }
  }
</style>
