---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteContent } from '../config/site-config';

const { brand, notFound } = await siteContent();
---

<Layout title={`${notFound.title} — ${brand.name}`} noindex>
  <SiteHeader />
  <main class="relative isolate overflow-hidden px-5 py-28 sm:py-36">
    <div class="blob left-1/2 top-10 -z-10 h-80 w-80 -translate-x-1/2 bg-primary opacity-20" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <span
        class="not-found-code font-head font-extrabold leading-[0.85] tracking-tighter"
        aria-hidden="true"
        data-reveal="scale"
      >
        404
      </span>
      <h1 class="display mt-6 text-ink" data-reveal>{notFound.heading}</h1>
      <p class="mt-4 max-w-md text-lg text-ink-soft" data-reveal>{notFound.text}</p>
      <a href="/" class="btn-primary mt-10 inline-flex min-h-14 px-8 text-base" data-reveal>
        <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
        {notFound.cta}
      </a>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .not-found-code {
    font-size: clamp(6rem, 4rem + 14vw, 13rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--color-primary);
  }
</style>
