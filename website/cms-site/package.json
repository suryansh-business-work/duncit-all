{
  "name": "cms-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "The Website CMS renderer: one Astro server that serves every CMS site, chosen by hostname, from pages designed in the Website portal.",
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "dev": "node scripts/sync-legacy-assets.mjs && astro dev",
    "build": "node scripts/sync-legacy-assets.mjs && astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "astro": "astro",
    "e2e": "node ../../scripts/e2e-no-surface.mjs cms-site"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@duncit/brand": "workspace:*",
    "@duncit/captcha": "workspace:*",
    "@duncit/i18n": "workspace:*",
    "@duncit/regex": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@duncit/gql-types": "workspace:*",
    "@types/node": "^26.6.3"
  }
}
