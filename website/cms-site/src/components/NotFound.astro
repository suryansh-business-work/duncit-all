---
/**
 * The renderer's own fallback pages: no site answers on this hostname, the
 * site has no page at this path (and no designed /404), the API is down (and
 * the site has no designed /503), or rendering failed (and no /500).
 * `bare` draws only the message, inside a site's own header and footer.
 */
import type { SiteTranslate } from '@duncit/brand/site-i18n';
import { SITE_LOCALE } from '../lib/translator';
import '../styles/cms.css';

interface Props {
  kind: 'missing' | 'unavailable' | 'error';
  t: SiteTranslate;
  bare?: boolean;
}

const { kind, t, bare = false } = Astro.props;
// Literal keys, one per branch: the translation-key gate can only see a
// t('…') it can read.
const COPY = {
  missing: { title: t('website.cms.notFound.title'), text: t('website.cms.notFound.text') },
  unavailable: { title: t('website.cms.unavailable.title'), text: t('website.cms.unavailable.text') },
  error: { title: t('website.cms.error.title'), text: t('website.cms.error.text') },
};
const { title, text } = COPY[kind];
---

{bare ? (
  <section class="cms-message">
    <h1>{title}</h1>
    <p>{text}</p>
    {kind === 'missing' && <p><a href="/">{t('website.cms.notFound.home')}</a></p>}
  </section>
) : (
  <html lang={SITE_LOCALE.split('-')[0]}>
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex" />
      <title>{title}</title>
    </head>
    <body>
      <main id="main" class="cms-message">
        <h1>{title}</h1>
        <p>{text}</p>
      </main>
    </body>
  </html>
)}
