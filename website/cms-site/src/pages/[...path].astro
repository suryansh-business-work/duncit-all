---
/**
 * Every address of every CMS site. The hostname picks the site, the path picks
 * the page (or a collection list / entry), and the API answers with the page
 * already composed — this route only renders it into the site's document.
 */
import NotFound from '../components/NotFound.astro';
import { CmsUnavailableError, publicGraphqlUrl, renderPage, renderPreview, requestHost } from '../lib/cms-api';
import { fromLegacy, legacyOrigin } from '../lib/legacy-fallback';
import { isUrlSlug } from '@duncit/regex';
import CmsDocument from '../components/CmsDocument.astro';
import BlockFrame from '../components/BlockFrame.astro';
import { blockFrameRequest } from '../lib/block-frame';
import { cachedErrorPage, rememberErrorPages } from '../lib/error-pages';
import { translator } from '../lib/translator';

const host = requestHost(Astro.request);
const path = `/${Astro.params.path ?? ''}`;
// One live block for the portal's designer (lib/block-frame.ts): the render below only supplies its site.
const frame = blockFrameRequest(path, Astro.url, Astro.request);
if (frame === 'refused') return new Response(null, { status: 404 });

// The hand-built blog read posts from /blog/post?slug=…; a migrated site
// serves them at /blog/<slug>. Shared links and search results keep working.
const legacySlug = path === '/blog/post' ? Astro.url.searchParams.get('slug') : null;
if (legacySlug && isUrlSlug(legacySlug)) return Astro.redirect(`/blog/${legacySlug}`, 301);
const pageNumber = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1;
const t = await translator();
const graphqlUrl = publicGraphqlUrl();

// `?cms_preview=<signed token>` (from the Website portal) shows a draft or one saved
// version at the page's real address; without it this is the live page.
const previewToken = Astro.url.searchParams.get('cms_preview');
let preview: 'none' | 'active' | 'expired' = 'none';

let result: Awaited<ReturnType<typeof renderPage>> | null = null;
try {
  if (previewToken) {
    result = await renderPreview(previewToken);
    preview = result ? 'active' : 'expired';
  }
  result ??= await renderPage(host, path, pageNumber);
} catch (error) {
  if (!(error instanceof CmsUnavailableError)) throw error;
  console.error('[cms-site] render failed', { host, path, reason: error.message });
}

// Not a CMS page: the site's old server may still answer it (a short link, a newer policy).
const fallbackOrigin = result?.status === 404 && preview === 'none' && !frame ? legacyOrigin(result.site?.legacy_site) : null;
if (fallbackOrigin) {
  const legacy = await fromLegacy(fallbackOrigin, Astro.request);
  if (legacy) return legacy;
}

// The API is unreachable: the site's own maintenance page, from the last good copy.
result ??= cachedErrorPage(host, 503);
if (result?.status === 200 && preview === 'none') rememberErrorPages(host);

if (!result) {
  Astro.response.status = 503;
  Astro.response.headers.set('retry-after', '30');
} else {
  Astro.response.status = result.status;
  if (result.status === 503) Astro.response.headers.set('retry-after', '30');
  // Revalidated on every visit: a publish is live on the next load. The API's
  // Redis render cache (retired by every CMS write) keeps that cheap.
  if (result.status === 200) Astro.response.headers.set('cache-control', 'public, max-age=0, must-revalidate');
}
if (frame && result?.site) Astro.response.status = 200;
if (previewToken || frame) {
  // A preview is for the people it was shared with: never stored, never indexed.
  Astro.response.headers.set('cache-control', 'private, no-store');
  Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
}

const site = result?.site ?? null;
// TLS ends at nginx, so the scheme the visitor used comes from its forwarded header.
const scheme = Astro.request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim() || Astro.url.protocol.replace(':', '');
const url = `${scheme}://${host}${path === '/' ? '' : path}`;
const liveUrl = `${scheme}://${host}${path}`;
---

{!result && <NotFound kind="unavailable" t={t} />}
{result && !site && <NotFound kind="missing" t={t} />}
{result && site && frame && <BlockFrame site={site} frame={frame} url={url} graphqlUrl={graphqlUrl} t={t} />}
{result && site && !frame && <CmsDocument result={{ ...result, site }} url={url} graphqlUrl={graphqlUrl} t={t} preview={preview} liveUrl={liveUrl} />}
