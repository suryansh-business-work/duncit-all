---
import { siteConfig } from '../config/site-config';
const { platform } = siteConfig;
---

<!-- The closing band: what Duncit is, next to the people it is for. -->
<section class="mx-auto max-w-6xl px-5 py-14">
  <div class="grid items-center gap-8 rounded-3xl border border-black/5 bg-white p-5 shadow-sm sm:p-8 lg:grid-cols-2">
    <img
      src={platform.image}
      alt={platform.imageAlt}
      width="900"
      height="600"
      class="aspect-3/2 w-full rounded-2xl object-cover"
      loading="lazy"
    />
    <div class="relative">
      <h2 class="text-3xl text-ink sm:text-4xl">
        India's <span class="text-primary">Community</span><br />Earning Platform
      </h2>
      <p class="mt-4 max-w-md text-ink-soft">{platform.text}</p>
      <a
        href={platform.button.href}
        class="mt-7 inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3 text-base font-bold text-white shadow-lg shadow-primary/30 transition hover:bg-primary-dark"
      >
        {platform.button.label}
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
