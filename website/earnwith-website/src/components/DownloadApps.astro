---
// This site's words on the shared download band. The earn site had no download
// section at all — the one place a host actually runs their pods from was never
// offered on the page that recruits them.
import AppDownload from '@duncit/brand/AppDownload.astro';
import { siteContent } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';

const siteConfig = await siteContent();
const { download } = siteConfig;
const branding = await fetchBranding();
const stores = [
  {
    icon: 'fa-google-play',
    eyebrow: download.googlePlayEyebrow,
    name: download.googlePlayName,
    url: branding.android_app_url,
  },
  {
    icon: 'fa-apple',
    eyebrow: download.appStoreEyebrow,
    name: download.appStoreName,
    url: branding.ios_app_url,
  },
];
---

<AppDownload
  heading={download.heading}
  headingAccent={download.headingAccent}
  text={download.text}
  perks={download.perks}
  stores={stores}
/>
