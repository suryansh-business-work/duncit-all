---
import { siteContent } from '../config/site-config';
import SmartLink from './SmartLink.astro';
import SectionHead from './home/SectionHead.astro';

const siteConfig = await siteContent();
const { paths, pathsSection } = siteConfig;

// Each journey gets its own colourway so the cards read as different
// doors. `frame-scope` on the dark one hands its contents the dark palette.
const LOOKS = [
  { card: 'bg-primary-fill text-on-primary', chip: 'bg-frame/20', arrow: 'bg-on-primary text-primary-fill', tag: 'bg-accent text-on-accent -rotate-6' },
  { card: 'border border-line bg-surface text-ink', chip: 'bg-primary-light', arrow: 'bg-primary-fill text-on-primary', tag: 'bg-primary-fill text-on-primary rotate-6' },
  { card: 'frame-scope bg-frame text-ink', chip: 'bg-surface', arrow: 'bg-primary text-frame', tag: 'bg-surface text-ink -rotate-3' },
  { card: 'bg-accent text-on-accent', chip: 'bg-on-primary/40', arrow: 'bg-on-accent text-accent', tag: 'bg-on-primary text-on-accent rotate-3' },
];
---

<section id="paths" class="scroll-mt-24 py-20 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-6xl px-4 sm:px-5">
    <SectionHead
      kicker={pathsSection.eyebrow}
      headingLead={pathsSection.headingLead}
      headingAccent={pathsSection.headingAccent}
      text={pathsSection.text}
    />

    <!-- A slider instead of a grid: five doors no longer fit one row, and a fifth card
         alone on a second row reads as an afterthought. Native scroll-snap, so
         touch, trackpad and keyboard (the track is focusable) all work without
         the script; the arrows are a convenience on top. -->
    <div class="mt-2 flex justify-end gap-2">
      <button type="button" class="paths-arrow" data-paths-prev aria-controls="pathsTrack" aria-label={pathsSection.previous}>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      </button>
      <button type="button" class="paths-arrow" data-paths-next aria-controls="pathsTrack" aria-label={pathsSection.next}>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </button>
    </div>

    <div
      id="pathsTrack"
      class="paths-track -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pt-4 pb-6 sm:-mx-5 sm:scroll-px-5 sm:px-5"
      role="region"
      aria-label={`${pathsSection.headingLead} ${pathsSection.headingAccent}`}
      tabindex="0"
      data-paths-track
      data-reveal-group
    >
      {
        paths.map((path, index) => {
          const look = LOOKS[index % LOOKS.length];
          return (
            <div class="paths-slide shrink-0 snap-start" data-reveal>
              <SmartLink
                href={path.href}
                label={path.cta}
                glyph={false}
                class={`path-card group relative flex h-full flex-col overflow-hidden rounded-card p-3 shadow-soft ${look.card}`}
              >
                <span class="relative block">
                  <img
                    src={path.image}
                    alt={path.imageAlt}
                    width="800"
                    height="600"
                    class="aspect-4/3 w-full rounded-[1.25rem] object-cover transition duration-700 ease-smooth group-hover:scale-[1.04]"
                    loading="lazy"
                  />
                  <span class={`absolute -top-1 right-3 inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 font-head text-xs font-extrabold uppercase tracking-wider shadow-soft ${look.tag}`}>
                    <i class={`fa-solid ${path.icon}`} aria-hidden="true" />
                    {path.tag}
                  </span>
                </span>
                <span class="flex grow flex-col px-3 pt-5 pb-3">
                  <span class="font-head text-2xl leading-tight font-extrabold tracking-tight sm:text-[1.7rem]">{path.title}</span>
                  <span class="mt-3 block text-[0.95rem] leading-relaxed">{path.text}</span>
                  <span class="mt-5 flex flex-wrap gap-2">
                    {path.chips.map((chip) => (
                      <span class={`rounded-full px-3 py-1.5 text-xs font-bold ${look.chip}`}>{chip}</span>
                    ))}
                  </span>
                  <span class="mt-auto flex items-center justify-between gap-3 pt-7 font-head text-base font-extrabold">
                    {path.cta}
                    <span class={`path-arrow grid h-12 w-12 shrink-0 place-items-center rounded-full ${look.arrow}`}>
                      <i class="fa-solid fa-arrow-right" aria-hidden="true" />
                    </span>
                  </span>
                </span>
              </SmartLink>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* One card and a peek on a phone, two on a tablet, four on a desktop. The
     next card always shows a sliver, so the row reads as "there is more". */
  .paths-slide {
    width: 85%;
  }
  @media (min-width: 640px) {
    .paths-slide {
      width: calc((100% - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .paths-slide {
      width: calc((100% - 3 * 1.25rem) / 4);
    }
  }
  .paths-track {
    scrollbar-width: none;
  }
  .paths-track::-webkit-scrollbar {
    display: none;
  }
  .paths-track:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }
  .paths-arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }
  .paths-arrow:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .paths-arrow:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .paths-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* The whole card is the link: it lifts, and its arrow turns to point out. */
  :global(.path-card) {
    transition:
      transform 500ms var(--ease-smooth),
      box-shadow 500ms var(--ease-smooth);
  }
  :global(.path-card:hover),
  :global(.path-card:focus-visible) {
    transform: translateY(-8px) rotate(-0.6deg);
    box-shadow: var(--shadow-lift);
  }
  :global(.path-card:focus-visible) {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }
  :global(.path-card .path-arrow) {
    transition: transform 400ms var(--ease-smooth);
  }
  :global(.path-card:hover .path-arrow),
  :global(.path-card:focus-visible .path-arrow) {
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.path-card),
    :global(.path-card .path-arrow) {
      transition: none;
    }
    :global(.path-card:hover),
    :global(.path-card:focus-visible),
    :global(.path-card:hover .path-arrow) {
      transform: none;
    }
  }
</style>

<script>
  // The arrows page the track by one card and grey out at either end.
  const track = document.querySelector<HTMLElement>('[data-paths-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-paths-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-paths-next]');

  if (track && prev && next) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const step = () => {
      const slide = track.querySelector<HTMLElement>('.paths-slide');
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      return (slide?.offsetWidth ?? track.clientWidth) + gap;
    };
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };
    const go = (direction: number) =>
      track.scrollBy({ left: direction * step(), behavior: still.matches ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>
