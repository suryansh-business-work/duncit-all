---
import { siteContent } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';

const siteConfig = await siteContent();

const { calculator, graphqlUrl } = siteConfig;
// The printed sheet carries the admin's own logo, like every other surface.
const branding = await fetchBranding();
const printLogo = branding.website_header_logo_url || '/duncit-logo.svg';
// What the calculator's script reads off the section (the CMS widget contract:
// @duncit/brand/widgets/earnings-calculator).
const widgetConfig = {
  roles: calculator.roles,
  fields: calculator.fields,
  rowLabels: calculator.rowLabels,
  currency: calculator.currency,
};
const widgetCopy = {
  note: calculator.note,
  shortfallNote: calculator.shortfallNote,
  noShareNote: calculator.noShareNote,
  loadError: calculator.loadError,
  disclaimer: calculator.disclaimer,
  pdf: calculator.pdf,
};
---

<!-- The interactive piece: move the inputs and see what a pod pays, either
     as a host, or as the club admin whose club it runs under. Every figure
     comes from the server's own settlement waterfall, so this page cannot
     drift from what either of them is really paid. -->
<section
  id="calculator"
  class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-5 sm:py-28"
  data-cms-widget="earnings-calculator"
  data-graphql-url={graphqlUrl}
  data-print-logo={printLogo}
  data-config={JSON.stringify(widgetConfig)}
  data-copy={JSON.stringify(widgetCopy)}
>
  <div class="relative overflow-hidden rounded-[2rem] border border-line bg-surface p-5 shadow-soft sm:rounded-panel sm:p-10 lg:p-12" data-reveal>
    <div class="blob -top-32 -right-24 h-80 w-80 bg-primary opacity-15" aria-hidden="true"></div>
    <p class="kicker relative">{calculator.eyebrow}</p>
    <h2 class="relative mt-4 max-w-3xl text-4xl text-ink sm:text-5xl lg:text-6xl">{calculator.heading}</h2>
    <p class="relative mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{calculator.text}</p>

    <div
      class="relative mt-8 inline-flex flex-wrap gap-1 rounded-full border border-line bg-cream p-1.5"
      role="tablist"
      aria-label={calculator.rolesAriaLabel}
    >
      {
        calculator.roles.map((role, index) => (
          <button
            type="button"
            role="tab"
            id={`earn-tab-${role.key}`}
            data-role-tab={role.key}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="earn-result"
            class="min-h-11 rounded-full px-5 font-head text-sm font-bold text-ink-soft transition duration-300 ease-smooth hover:text-ink aria-selected:bg-primary-fill aria-selected:text-on-primary aria-selected:shadow-soft"
          >
            {role.label}
          </button>
        ))
      }
    </div>

    <div class="relative mt-8 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-10">
      <form class="grid content-start gap-7" data-earn-form novalidate>
        {
          calculator.fields.map((field) => (
            <label class="block" data-field={field.name} data-field-roles={(field.roles ?? []).join(',')}>
              <span class="flex items-baseline justify-between gap-3">
                <span class="text-sm font-bold text-ink">{field.label}</span>
                <output class="font-head text-xl font-extrabold text-primary-strong" data-out={field.name} for={field.name} />
              </span>
              <input
                class="mt-1 h-11 w-full cursor-pointer accent-primary"
                type="range"
                id={field.name}
                name={field.name}
                min={field.min}
                max={field.max}
                step={field.step}
                value={field.value}
                data-prefix={field.prefix}
              />
              <span class="block text-xs text-ink-soft">{field.hint}</span>
            </label>
          ))
        }
      </form>

      <div class="grid content-start gap-4">
        <!-- The answer sits on the dark matte in both themes; frame-scope gives
             the classes the widget writes (text-ink, text-ink-soft) their dark
             values. -->
        <div id="earn-result" role="tabpanel" class="frame-scope rounded-card bg-frame p-6 text-ink shadow-lift sm:p-8" aria-live="polite">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="text-sm font-bold text-ink-soft" data-earn-label>
              {calculator.roles[0].takeHomeLabel}
            </span>
            <span class="font-head text-4xl font-extrabold text-ink" data-earn-takehome>—</span>
          </div>
          <dl class="mt-6 space-y-2.5 border-t border-line pt-5 text-sm" data-earn-rows></dl>
          <p class="mt-5 text-xs text-ink-soft" data-earn-note>{calculator.note}</p>
        </div>

        <!-- Beside the money, the job: what that role is signing up for. The
             two move together, so neither is read on its own. -->
        <div class="rounded-card border border-line bg-cream p-6">
          <h3 class="font-head text-lg font-extrabold text-ink" data-duties-title>
            {calculator.roles[0].dutiesTitle}
          </h3>
          <ul class="mt-3 space-y-2" data-duties></ul>
        </div>
      </div>
    </div>

    <div class="relative mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="max-w-3xl text-xs leading-relaxed text-ink-soft">{calculator.disclaimer}</p>
      <button type="button" data-print-estimate class="btn shrink-0 border border-line bg-cream text-sm text-ink hover:border-primary">
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
        {calculator.pdf.button}
      </button>
    </div>
  </div>
</section>

<script>
  import { mount } from '@duncit/brand/widgets/earnings-calculator';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="earnings-calculator"]')) mount(root);
</script>
