---
import { siteConfig } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';

const { calculator, graphqlUrl } = siteConfig;
// The printed sheet carries the admin's own logo, like every other surface.
const branding = await fetchBranding();
const printLogo = branding.website_header_logo_url || '/duncit-logo.svg';
---

<!-- The interactive piece: move the three inputs, watch what a pod actually
     pays — as a host, or as the club admin whose club it runs under. Every
     figure comes from the server's own settlement waterfall, so this page
     cannot drift from what either of them is really paid. -->
<section id="calculator" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-14">
  <div class="rounded-3xl border border-line bg-surface p-6 shadow-sm sm:p-10">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary">{calculator.eyebrow}</p>
    <h2 class="mt-2 text-3xl text-ink sm:text-4xl">{calculator.heading}</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">{calculator.text}</p>

    <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Whose earnings">
      {
        calculator.roles.map((role, index) => (
          <button
            type="button"
            role="tab"
            id={`earn-tab-${role.key}`}
            data-role-tab={role.key}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="earn-result"
            class="rounded-full border border-ink/15 px-5 py-2 text-sm font-bold text-ink-soft transition aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white"
          >
            {role.label}
          </button>
        ))
      }
    </div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_1.1fr]">
      <form class="grid gap-6" data-earn-form novalidate>
        {
          calculator.fields.map((field) => (
            <label class="block" data-field={field.name} data-field-roles={(field.roles ?? []).join(',')}>
              <span class="flex items-baseline justify-between gap-3">
                <span class="text-sm font-bold text-ink">{field.label}</span>
                <output class="font-head text-lg font-extrabold text-primary" data-out={field.name} for={field.name} />
              </span>
              <input
                class="mt-3 w-full accent-[var(--color-primary)]"
                type="range"
                id={field.name}
                name={field.name}
                min={field.min}
                max={field.max}
                step={field.step}
                value={field.value}
                data-prefix={field.prefix}
              />
              <span class="mt-1 block text-xs text-ink-soft">{field.hint}</span>
            </label>
          ))
        }
      </form>

      <div class="grid gap-4">
        <div id="earn-result" role="tabpanel" class="rounded-2xl bg-cream p-6" aria-live="polite">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-bold text-ink-soft" data-earn-label>
              {calculator.roles[0].takeHomeLabel}
            </span>
            <span class="font-head text-4xl font-extrabold text-ink" data-earn-takehome>—</span>
          </div>
          <dl class="mt-5 space-y-2 text-sm" data-earn-rows></dl>
          <p class="mt-5 text-xs text-ink-soft" data-earn-note>{calculator.note}</p>
        </div>

        <!-- Beside the money, the job: what that role is actually signing up
             for. The two move together, so neither is read on its own. -->
        <div class="rounded-2xl border border-line p-6">
          <h3 class="font-head text-base font-extrabold text-ink" data-duties-title>
            {calculator.roles[0].dutiesTitle}
          </h3>
          <ul class="mt-3 space-y-2" data-duties></ul>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <p class="max-w-3xl text-xs text-ink-soft">{calculator.disclaimer}</p>
      <button
        type="button"
        data-print-estimate
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-primary/40 px-5 py-2 text-sm font-bold text-primary transition hover:bg-primary hover:text-white"
      >
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
        {calculator.pdf.button}
      </button>
    </div>
  </div>

  <!-- The sheet the printer sees. It is built for paper, not squeezed from the
       page: the logo, what was assumed, where the money goes, and the same
       disclaimer — filled from the live numbers the moment it is asked for. -->
  <div class="print-sheet" hidden data-print-sheet>
    <img src={printLogo} alt="Duncit" class="print-logo" />
    <h1>{calculator.pdf.title}</h1>
    <p class="print-role" data-print-role></p>

    <h2>{calculator.pdf.inputsTitle}</h2>
    <dl data-print-inputs></dl>

    <h2>{calculator.pdf.breakdownTitle}</h2>
    <dl data-print-rows></dl>

    <p class="print-total"><span data-print-label></span><strong data-print-total></strong></p>

    <h2 data-print-duties-title></h2>
    <ul data-print-duties></ul>

    <p class="print-note">{calculator.disclaimer}</p>
    <p class="print-note" data-print-footer></p>
  </div>
</section>

<script
  is:inline
  define:vars={{
    graphqlUrl,
    roles: calculator.roles,
    rowLabels: calculator.rowLabels,
    currency: calculator.currency,
    standardNote: calculator.note,
    shortfallNote: calculator.shortfallNote,
    noShareNote: calculator.noShareNote,
    fields: calculator.fields,
    pdfFooter: calculator.pdf.footer,
  }}
>
  (() => {
    const form = document.querySelector('[data-earn-form]');
    if (!form) return;
    const rows = document.querySelector('[data-earn-rows]');
    const takeHome = document.querySelector('[data-earn-takehome]');
    const label = document.querySelector('[data-earn-label]');
    const dutiesTitle = document.querySelector('[data-duties-title]');
    const duties = document.querySelector('[data-duties]');
    const note = document.querySelector('[data-earn-note]');
    const tabs = [...document.querySelectorAll('[data-role-tab]')];

    let role = roles[0];
    let latest = null;
    const money = (value) => `${currency}${Math.round(value).toLocaleString('en-IN')}`;

    const QUERY = `query PublicPodEarnings($amount: Float!, $spots: Int!, $venue: Float) {
      publicPodEarningsEstimate(pod_amount: $amount, no_of_spots: $spots, venue_amount: $venue) {
        payable_spots
        waterfall {
          amount
          gst_amount
          platform_fee_amount
          venue_amount
          club_admin_pct
          club_admin_amount
          host_commission_amount
          host_receives
        }
      }
    }`;

    // Which waterfall line each row shows. One map, so a row can never be
    // labelled as one thing and filled from another.
    const ROW_FIELD = {
      gross: 'amount',
      gst: 'gst_amount',
      platform: 'platform_fee_amount',
      venue: 'venue_amount',
      clubAdmin: 'club_admin_amount',
      hostCommission: 'host_commission_amount',
    };

    const sliderValue = (name) => Number(new FormData(form).get(name)) || 0;
    /** How many pods this role's earnings run across — one, unless the role
     * says otherwise (a club admin earns from every pod under the club). */
    const multiplier = () => (role.multiplier ? sliderValue(role.multiplier) : 1);

    // Only a club admin's sliders include the pod count; a host is looking at
    // the one pod in front of them.
    const syncFields = () => {
      for (const field of form.querySelectorAll('[data-field]')) {
        const only = field.dataset.fieldRoles;
        field.hidden = Boolean(only) && !only.split(',').includes(role.key);
      }
    };

    const paintDuties = () => {
      dutiesTitle.textContent = role.dutiesTitle;
      duties.innerHTML = role.duties
        .map(
          (duty) =>
            `<li class="flex gap-2 text-sm text-ink-soft"><i class="fa-solid fa-check mt-1 text-xs text-primary" aria-hidden="true"></i><span>${duty}</span></li>`
        )
        .join('');
    };

    /**
     * What one row shows. The money lines are for the MONTH, like the take-home
     * above them — a venue billed per pod is billed once per pod all month, and
     * a column that mixed one pod's costs with a month's earnings would not add
     * up. The per-pod share stays per pod, which is what its label says.
     */
    const rowValue = (key, w) => {
      if (key === 'perPod') return { text: money(w[role.field]), deduction: false };
      if (key === 'pods') return { text: `× ${multiplier()}`, deduction: false };
      const value = w[ROW_FIELD[key]] * multiplier();
      const deduction = key !== 'gross';
      return {
        text: deduction && value > 0 ? `− ${money(value)}` : money(value),
        deduction,
      };
    };

    /** The panel's own message: the standard note, or the reason this pod
     * cannot pay this role. Warnings are red because they change the answer. */
    const setNote = (text, warning) => {
      note.textContent = text;
      note.className = `mt-5 text-xs ${warning ? 'font-semibold text-primary-dark' : 'text-ink-soft'}`;
    };

    const paint = () => {
      if (!latest) return;
      const w = latest.waterfall;
      label.textContent = role.takeHomeLabel;
      rows.innerHTML = role.rows
        .map((key) => {
          const { text, deduction } = rowValue(key, w);
          const tone = deduction ? 'text-ink-soft' : 'font-bold text-ink';
          return `<div class="flex items-baseline justify-between gap-3"><dt class="${tone}">${rowLabels[key]}</dt><dd class="${tone}">${text}</dd></div>`;
        })
        .join('');

      // The rate this role is paid on is zero — there is no estimate to make,
      // and a confident ₹0 would read as "this pays nothing" rather than "this
      // is not set up yet".
      if (role.rateField && !w[role.rateField]) {
        takeHome.textContent = '—';
        takeHome.className = 'font-head text-4xl font-extrabold text-ink-soft';
        setNote(noShareNote, true);
        return;
      }

      const total = w[role.field] * multiplier();
      takeHome.textContent = money(total);
      // Nothing left, or a shortfall: the server reports the real gap rather
      // than clamping it, so the page says what to do about it.
      const short = total <= 0;
      takeHome.className = `font-head text-4xl font-extrabold ${short ? 'text-primary-dark' : 'text-ink'}`;
      setNote(short ? shortfallNote : standardNote, short);
    };

    // A blip after the numbers are up leaves them alone; a failure before any
    // numbers exist has to SAY so — an em dash and an empty list read as a
    // broken page, which is exactly what it looks like from the outside.
    const failed = () => {
      if (latest) return;
      takeHome.textContent = '—';
      setNote(
        'The estimate could not be loaded right now. The figures come from Duncit itself, so nothing is shown rather than a guess — please try again shortly.',
        true
      );
    };

    let timer;
    const request = async () => {
      const values = new FormData(form);
      const variables = {
        amount: Number(values.get('ticket')),
        spots: Number(values.get('spots')),
        venue: Number(values.get('venue')),
      };
      try {
        const res = await fetch(graphqlUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: QUERY, variables }),
        });
        const json = await res.json();
        const data = json?.data?.publicPodEarningsEstimate;
        if (data) {
          latest = data;
          paint();
        } else {
          failed();
        }
      } catch {
        failed();
      }
    };

    const syncLabels = () => {
      for (const input of form.querySelectorAll('input[type="range"]')) {
        const out = document.querySelector(`[data-out="${input.name}"]`);
        if (out) {
          const prefix = input.dataset.prefix ?? '';
          out.textContent = `${prefix}${Number(input.value).toLocaleString('en-IN')}`;
        }
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        role = roles.find((r) => r.key === tab.dataset.roleTab) ?? roles[0];
        for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
        paintDuties();
        syncFields();
        // Same figures, different line of them — switching roles asks the
        // server nothing.
        paint();
      });
    }

    form.addEventListener('input', (event) => {
      syncLabels();
      // The pod count is not part of the pod's own maths — it multiplies the
      // answer, so it repaints without asking the server again.
      if (event.target?.name === role.multiplier) {
        paint();
        return;
      }
      // The server does the maths; dragging a slider must not fire a request
      // per pixel.
      clearTimeout(timer);
      timer = setTimeout(request, 180);
    });

    // The printed sheet is filled at the moment it is asked for, from the same
    // numbers on screen — never a second calculation that could disagree.
    const printButton = document.querySelector('[data-print-estimate]');
    if (printButton) {
      const line = (term, value) => `<div><dt>${term}</dt><dd>${value}</dd></div>`;
      printButton.addEventListener('click', () => {
        if (!latest) return;
        const w = latest.waterfall;
        document.querySelector('[data-print-role]').textContent = role.label.replace(/^As /, '');
        document.querySelector('[data-print-inputs]').innerHTML = fields
          .filter((field) => !field.roles || field.roles.includes(role.key))
          .map((field) => {
            const raw = sliderValue(field.name);
            return line(field.label, `${field.prefix ?? ''}${raw.toLocaleString('en-IN')}`);
          })
          .join('');
        document.querySelector('[data-print-rows]').innerHTML = role.rows
          .map((key) => line(rowLabels[key], rowValue(key, w).text))
          .join('');
        document.querySelector('[data-print-label]').textContent = role.takeHomeLabel;
        document.querySelector('[data-print-total]').textContent = takeHome.textContent;
        document.querySelector('[data-print-duties-title]').textContent = role.dutiesTitle;
        document.querySelector('[data-print-duties]').innerHTML = role.duties
          .map((duty) => `<li>${duty}</li>`)
          .join('');
        document.querySelector('[data-print-footer]').textContent =
          `${pdfFooter} ${new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}`;
        window.print();
      });
    }

    syncLabels();
    paintDuties();
    syncFields();
    request();
  })();
</script>
