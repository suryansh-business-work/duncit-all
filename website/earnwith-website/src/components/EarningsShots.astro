---
import { siteContent } from '../config/site-config';
import SectionHead from './home/SectionHead.astro';

const siteConfig = await siteContent();
const { screenshots } = siteConfig;
---

{
  /* Renders only once real screens are configured. A marketing page showing
     stock photography where it promises product screenshots is worse than
     showing nothing. */
  screenshots.items.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-5 sm:py-28">
      <SectionHead kicker={screenshots.eyebrow} headingLead={screenshots.heading} text={screenshots.text} />

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {screenshots.items.map((shot) => (
          <figure data-reveal class="overflow-hidden rounded-card border border-line bg-surface shadow-soft">
            <img src={shot.image} alt={shot.alt} width="600" height="1200" class="w-full object-cover" loading="lazy" />
            <figcaption class="border-t border-line px-6 py-5">
              <span class="block font-head text-lg font-extrabold text-ink">{shot.title}</span>
              <span class="mt-1 block text-sm text-ink-soft">{shot.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}
