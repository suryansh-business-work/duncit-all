---
import { siteConfig } from '../config/site-config';
import SmartLink from './SmartLink.astro';
import RibbonMarquee from './RibbonMarquee.astro';
const { hero } = siteConfig;

---

<section class="relative isolate flex min-h-[86svh] items-center overflow-hidden">
  <!-- The banner runs edge to edge, from under the transparent header down to
       the ribbon. It is the page's first paint, so it loads eagerly. -->
  <img
    src={hero.image}
    alt={hero.imageAlt}
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Copy sits on the left, so the scrim is heaviest there and clears to the
       right: the photograph keeps its subject, the words keep their contrast.
       A LITERAL dark, not the ink token: ink inverts with the theme, so in dark
       mode the scrim turned near-white and washed the photograph out. The words
       on it are always white, so what darkens them must always be dark. -->
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-6xl px-5 pt-32 pb-36 sm:pt-36 sm:pb-40">
    <span
      class="inline-block rounded-full border border-white/30 bg-white/15 px-4 py-1 text-sm font-bold text-white backdrop-blur"
    >
      {hero.eyebrow}
    </span>
    <h1 class="mt-6 max-w-2xl text-5xl text-white sm:text-6xl lg:text-7xl">{hero.heading}</h1>
    {hero.paragraphs.map((paragraph) => <p class="mt-5 max-w-lg text-lg text-white/85">{paragraph}</p>)}
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <SmartLink
        href={hero.primaryCta.href}
        label={hero.primaryCta.label}
        class="inline-flex items-center gap-1 rounded-full bg-primary px-7 py-3 text-base font-bold text-white shadow-lg shadow-primary/40 transition hover:bg-primary-dark"
      >
        {hero.primaryCta.label}
      </SmartLink>
      <a
        href={hero.secondaryCta.href}
        class="rounded-full border border-white/40 bg-white/10 px-7 py-3 text-base font-bold text-white backdrop-blur transition hover:bg-white/20"
      >
        {hero.secondaryCta.label}
      </a>
    </div>
  </div>

  <!-- The band straddles the banner's lower edge; the component owns the band
       and its motion, this owns where it sits. -->
  <div class="absolute right-[-4%] bottom-14 left-[-4%]">
    <RibbonMarquee />
  </div>
</section>

<style>
  .hero-scrim {
    background: linear-gradient(
      90deg,
      rgba(9, 7, 18, 0.9) 0%,
      rgba(9, 7, 18, 0.7) 45%,
      rgba(9, 7, 18, 0.25) 100%
    );
  }

</style>
