---
import { siteContent } from '../config/site-config';

const siteConfig = await siteContent();

interface Props {
  /** Degrees of backward tilt. The hero's band leans off the photograph; a
   * band sitting in the page flow wants less. */
  tilt?: number;
  /** Seconds for one full pass. */
  seconds?: number;
}

const { tilt = 10, seconds = 40 } = Astro.props;

// The marquee runs forever by scrolling exactly half the track and resetting —
// the copies land where the previous ones were, so the reset is invisible.
// FOUR copies, not two: half a two-copy track is barely a desktop width, and a
// track narrower than the band would run out and show the gap it resets across.
const words = siteConfig.hero.ribbon;
const copies = [0, 1, 2, 3];
---

<!-- Decorative: the words are marketing copy that already appears as prose on
     the page, and a screen reader reading a loop of slogans helps nobody. -->
<div class="ribbon-stage" style={`--ribbon-tilt:${tilt}deg;--ribbon-seconds:${seconds}s`} aria-hidden="true">
  <div class="ribbon-band">
    <div class="ribbon-track">
      {
        copies.map(() => (
          <span class="ribbon-run">
            {words.map((word) => (
              <>
                <span>{word}</span>
                <i class="fa-solid fa-bolt ribbon-mark" />
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* A physical band tilted away from the reader: perspective on the stage, the
     tilt on the band, so the text inside inherits the same plane and the whole
     thing reads as one ribbon rather than skewed lettering.

     The stage OWNS the clip and the widening: the band is wider than the stage
     so both ends run past the clip, and nothing sticks out of the page. The
     vertical padding is the tilt's own room, so the ends are not sliced off. */
  .ribbon-stage {
    perspective: 700px;
    pointer-events: none;
    overflow: hidden;
    padding-block: 1.5rem;
  }

  .ribbon-band {
    width: 112%;
    margin-inline-start: -6%;
    padding: 1.1rem 0;
    /* The AA pink: the words on it are large, white, and must read in both
       themes — the band does not invert. */
    background: linear-gradient(180deg, var(--color-primary-fill) 0%, var(--color-primary-dark) 100%);
    transform: rotateX(var(--ribbon-tilt)) rotate(-1.5deg);
    transform-style: preserve-3d;
    box-shadow: var(--shadow-lift);
  }

  .ribbon-track {
    display: flex;
    width: max-content;
    animation: ribbon-marquee var(--ribbon-seconds) linear infinite;
  }

  .ribbon-run {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--color-on-primary);
  }

  .ribbon-mark {
    font-size: 1.4rem;
    color: var(--color-frame);
  }

  /* Exactly half the track — the second pair of copies has arrived where the
     first started, so the reset is invisible. */
  @keyframes ribbon-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ribbon-track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .ribbon-run {
      gap: 1.6rem;
      padding-right: 1.6rem;
      font-size: 1.25rem;
    }
    .ribbon-mark {
      font-size: 1rem;
    }
  }
</style>
