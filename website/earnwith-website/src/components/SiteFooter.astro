---
// Footer — links managed from the Website portal (Navigation → EARNWITH) and
// the Policy Hub from the Legal portal; branding assets from Admin. The
// configured groups are the fallback the portal overrides.
import { siteConfig } from '../config/site-config';
import { fetchBranding, fetchNavGroups, fetchPolicies, type SiteNavGroup } from '../lib/site-data';
import NewsletterSignup from './NewsletterSignup.astro';
import RibbonMarquee from './RibbonMarquee.astro';
import SmartLink from './SmartLink.astro';
import FooterLogo from '@duncit/brand/FooterLogo.astro';

const { footer, mainSiteUrl } = siteConfig;

const FALLBACK_GROUPS: SiteNavGroup[] = footer.groups.map((group) => ({
  label: group.label,
  links: group.links.map((link, index) => ({
    id: `fallback-${group.label}-${index}`,
    area: 'FOOTER' as const,
    group_label: group.label,
    label: link.label,
    url: link.href,
    sort_order: index,
  })),
}));

const [branding, portalGroups, policies] = await Promise.all([
  fetchBranding(),
  fetchNavGroups('FOOTER', []),
  fetchPolicies(),
]);

// The portal wins per GROUP, not all-or-nothing. It carries two groups today,
// and an all-or-nothing fallback meant the site's own five collapsed to those
// two — a thinner footer than either source describes. Anything the portal
// names is its own; the rest come from here.
const portalLabels = new Set(portalGroups.map((group) => group.label.toLowerCase()));
const navGroups = [
  ...portalGroups,
  ...FALLBACK_GROUPS.filter((group) => !portalLabels.has(group.label.toLowerCase())),
];
const supportEmail = branding.support_email || 'support@duncit.com';
const year = new Date().getFullYear();
// Admin's footer logo, then the header one it also manages, and only then the
// bundled file: a brand that set ONE logo should not see the local default
// down here while its own mark sits at the top of the page.

---

<footer class="mt-8 bg-surface/60">
  <!-- The same band that closes the banner opens the footer, so the page ends
       on the note it started with. It replaces the footer's top hairline. -->
  <div class="mx-[-4%] overflow-hidden pt-2 pb-6">
    <RibbonMarquee tilt={8} seconds={32} />
  </div>
  <!-- Brand and the one thing we ask for, side by side: the address field is
       the footer's job, not a strip bolted above it. -->
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-12 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <!-- Four times the header mark: the footer is where the brand signs off,
           so it is the one place the logo is allowed to be large. Capped to the
           column width so a wide logo cannot push the layout on a phone. -->
      <FooterLogo
        footerSrc={branding.website_footer_logo_url}
        headerSrc={branding.website_header_logo_url}
        name={branding.app_name}
        height={144}
      />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-soft">{footer.tagline}</p>
      <a
        href={`mailto:${supportEmail}`}
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
      >
        <i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>
        {supportEmail}
      </a>

      <ul class="mt-5 flex items-center gap-3">
        {
          footer.social.map((account) => (
            <li>
              <SmartLink
                href={account.href}
                label={account.label}
                glyph={false}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink-soft transition hover:border-primary hover:text-primary"
              >
                <i class={`fa-brands ${account.icon}`} aria-hidden="true" />
              </SmartLink>
            </li>
          ))
        }
      </ul>
    </div>
    <NewsletterSignup />
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-12">
    <div class="grid grid-cols-2 gap-8 border-t border-line pt-10 sm:grid-cols-3 lg:grid-cols-5">
      {
        navGroups.map((group) => (
          <nav aria-label={group.label}>
            <h3 class="mb-3 font-head text-xs font-extrabold uppercase tracking-wider text-ink">
              {group.label}
            </h3>
            <ul class="space-y-2">
              {group.links.map((link) => (
                <li>
                  <SmartLink
                    href={link.url}
                    label={link.label}
                    class="text-sm text-ink-soft transition hover:text-ink"
                  >
                    {link.label}
                  </SmartLink>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      {
        policies.length > 0 && (
          <nav aria-label="Legal">
            <h3 class="mb-3 font-head text-xs font-extrabold uppercase tracking-wider text-ink">
              Legal
            </h3>
            <ul class="space-y-2">
              {policies.slice(0, 4).map((policy) => (
                <li>
                  <SmartLink
                    href={`${mainSiteUrl}/policy/${encodeURIComponent(policy.slug)}`}
                    label={policy.title}
                    class="text-sm text-ink-soft transition hover:text-ink"
                  >
                    {policy.title}
                  </SmartLink>
                </li>
              ))}
              <li>
                <SmartLink
                  href={`${mainSiteUrl}/policies`}
                  label="All policies"
                  class="text-sm font-semibold text-primary hover:underline"
                >
                  All policies
                </SmartLink>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-5 text-xs text-ink-soft"
    >
      <span>© {year} Duncit. All rights reserved.</span>
      <span>Built for communities in India.</span>
    </div>
  </div>
</footer>
