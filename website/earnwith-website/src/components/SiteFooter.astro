---
// Footer: links managed from the Website portal (Navigation > EARNWITH) and
// the Policy Hub from the Legal portal; branding assets from Admin. The
// configured groups are the fallback the portal overrides.
import { siteContent } from '../config/site-config';
import { fetchBranding, fetchNavGroups, fetchPolicies, type SiteNavGroup } from '../lib/site-data';
import NewsletterSignup from './NewsletterSignup.astro';
import RibbonMarquee from './RibbonMarquee.astro';
import SmartLink from './SmartLink.astro';
import PolicyStrip from '@duncit/brand/PolicyStrip.astro';
import SocialLinks from '@duncit/brand/SocialLinks.astro';
import FooterLogo from '@duncit/brand/FooterLogo.astro';

const siteConfig = await siteContent();

const { footer, mainSiteUrl } = siteConfig;

const FALLBACK_GROUPS: SiteNavGroup[] = footer.groups.map((group) => ({
  label: group.label,
  links: group.links.map((link, index) => ({
    id: `fallback-${group.label}-${index}`,
    area: 'FOOTER' as const,
    group_label: group.label,
    label: link.label,
    url: link.href,
    sort_order: index,
  })),
}));

const [branding, portalGroups, policies] = await Promise.all([
  fetchBranding(),
  fetchNavGroups('FOOTER', []),
  fetchPolicies(),
]);

// The portal wins per GROUP. It carries two groups today, and an
// all-or-nothing fallback meant the site's own five collapsed to those two,
// a thinner footer than either source describes. Anything the portal
// names is its own; the rest come from here.
const portalLabels = new Set(portalGroups.map((group) => group.label.toLowerCase()));
const navGroups = [
  ...portalGroups,
  ...FALLBACK_GROUPS.filter((group) => !portalLabels.has(group.label.toLowerCase())),
];
const supportEmail = branding.support_email || 'support@duncit.com';
const year = new Date().getFullYear();
// Admin's footer logo, then the header one it also manages, and only then the
// bundled file: a brand that set ONE logo should not see the local default
// down here while its own mark sits at the top of the page.

---

<!-- The same band that crosses under the banner opens the footer, so the page
     ends on the note it started with. -->
<div class="relative z-10 -mb-12 sm:-mb-14">
  <RibbonMarquee tilt={6} seconds={46} />
</div>
<!-- The footer is a panel on the dark matte in both themes; frame-scope hands
     the shared newsletter, policy strip and social links the dark palette. -->
<footer class="frame-scope mx-2 overflow-hidden rounded-t-[2rem] bg-frame text-ink sm:mx-4 sm:rounded-t-panel">
  <!-- Brand and the one thing we ask for, side by side: the address field
       belongs inside the footer instead of a strip bolted above it. -->
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 pt-24 pb-12 sm:pt-28 lg:grid-cols-[1fr_1.1fr]" data-reveal>
    <div>
      <!-- The footer is where the brand signs off, so it is the one place the
           logo is allowed to be large. Capped to the column width so a wide
           logo cannot push the layout on a phone. -->
      <FooterLogo
        footerSrc={branding.website_footer_logo_url}
        headerSrc={branding.website_header_logo_url}
        name={branding.app_name}
        height={120}
        graphqlUrl={siteConfig.graphqlUrl}
      />
      <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">{footer.tagline}</p>
      <a
        href={`mailto:${supportEmail}`}
        class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary-strong hover:underline"
      >
        <i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>
        {supportEmail}
      </a>

      <SocialLinks class="mt-4" />
    </div>
    <div class="rounded-card border border-line bg-surface p-6 sm:p-8">
      <NewsletterSignup />
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-10">
    <div class="grid grid-cols-2 gap-8 border-t border-line pt-10 sm:grid-cols-3 lg:grid-cols-5" data-reveal-group>
      {
        navGroups.map((group) => (
          <nav aria-label={group.label} data-reveal>
            <h3 class="mb-4 font-head text-xs font-extrabold uppercase tracking-[0.14em] text-ink">
              {group.label}
            </h3>
            <ul class="space-y-1">
              {group.links.map((link) => (
                <li>
                  <SmartLink
                    href={link.url}
                    label={link.label}
                    class="inline-flex min-h-9 items-center text-sm font-semibold text-ink-soft transition hover:text-ink"
                  >
                    {link.label}
                  </SmartLink>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <PolicyStrip policies={policies} baseUrl={mainSiteUrl} class="mt-10" />

    <!-- The brand name, huge and outlined: a decorative sign-off. -->
    <p class="footer-wordmark mt-14 text-center font-head font-extrabold" aria-hidden="true">{branding.app_name}</p>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} {branding.app_name}. {footer.rights}</span>
      <span>{footer.builtFor}</span>
    </div>
  </div>
</footer>

<style>
  .footer-wordmark {
    font-size: clamp(4rem, 17vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-line);
    white-space: nowrap;
    overflow: hidden;
  }
</style>
