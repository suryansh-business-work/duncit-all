---
import { getSiteTranslator } from '@duncit/brand/site-i18n';
import { siteContent } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';
import SmartLink from './SmartLink.astro';
import BrandLogo from '@duncit/brand/BrandLogo.astro';
import SiteMenu from '@duncit/brand/SiteMenu.astro';
import ThemeToggle from '@duncit/brand/ThemeToggle.astro';

const siteConfig = await siteContent();
// The theme toggle sentence is shared site chrome (website.nav.*), not this
// site's own copy, so it comes straight off the translator.
const { t } = await getSiteTranslator(siteConfig.graphqlUrl);

interface Props {
  /** Float over a full-bleed banner instead of pushing the page down. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { nav } = siteConfig;
const branding = await fetchBranding();

// An overlay bar takes no layout space, which is what lets the banner start at
// the top of the page and run underneath the floating pill; a page without a
// banner keeps an ordinary sticky bar that pushes content down.
const position = overlay ? 'fixed inset-x-0 top-0' : 'sticky top-0';
---

<!-- A floating glass pill rather than a full-width bar. It is a solid, blurred
     surface in every state, so its words never depend on what is behind it.
     The strip around the pill lets clicks through to the page. -->
<header
  class={`site-header ${position} pointer-events-none z-40 px-3 pt-3 sm:px-6 sm:pt-4`}
  data-overlay={overlay ? 'true' : undefined}
  data-cms-widget="site-header"
>
  <nav
    class="site-pill pointer-events-auto mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 rounded-full border border-line bg-surface/80 pr-2 pl-2 shadow-soft backdrop-blur-xl backdrop-saturate-150 sm:pl-3"
    aria-label={siteConfig.brand.name}
  >
    <div class="flex min-w-0 items-center gap-2">
      <!-- Below `lg` the drawer carries every link plus Log In and Sign Up. -->
      <SiteMenu links={nav.links} actions={[nav.signup, nav.login]} t={t} />
      <a href="/" class="flex shrink-0 items-center rounded-full px-1" aria-label={branding.app_name}>
        <BrandLogo
          src={branding.website_header_logo_url}
          name={branding.app_name}
          height={40}
          href={null}
          graphqlUrl={siteConfig.graphqlUrl}
        />
      </a>
    </div>

    <div class="hidden items-center gap-1 lg:flex">
      {
        nav.links.map((link) => (
          <SmartLink
            href={link.href}
            label={link.label}
            class="rounded-full px-3.5 py-2.5 text-sm font-semibold text-ink-soft transition hover:bg-primary-light hover:text-ink"
          >
            {link.label}
          </SmartLink>
        ))
      }
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <!-- Always visible, on every width: the theme is never more than a tap away. -->
      <ThemeToggle label={t('website.nav.theme')} />
      <SmartLink
        href={nav.login.href}
        label={nav.login.label}
        glyph={false}
        class="hidden min-h-11 items-center rounded-full border border-line px-5 text-sm font-bold text-ink transition hover:border-ink-soft xl:inline-flex"
      >
        {nav.login.label}
      </SmartLink>
      <!-- The wrapper owns the breakpoint so `btn`'s own display never has to
           out-rank `hidden`. On a phone the drawer carries Sign Up. -->
      <span class="hidden sm:inline-flex">
        <SmartLink
          href={nav.signup.href}
          label={nav.signup.label}
          glyph={false}
          class="btn bg-primary-fill text-sm text-on-primary shadow-soft"
        >
          {nav.signup.label}
          <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </SmartLink>
      </span>
    </div>
  </nav>
</header>

<style>
  /* Once the page scrolls the pill lifts off it with a deeper shadow. */
  .site-pill {
    transition: box-shadow 300ms var(--ease-smooth);
  }
  .site-header:not(.at-top) .site-pill {
    box-shadow: var(--shadow-lift);
  }
</style>

<script>
  // Keeps `at-top` on the header for the shadow above (the CMS widget
  // @duncit/brand/widgets/site-header).
  import { mount } from '@duncit/brand/widgets/site-header';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="site-header"]')) mount(root);
</script>
