---
import { siteConfig } from '../config/site-config';
import { fetchBranding } from '../lib/site-data';
import SmartLink from './SmartLink.astro';
import BrandLogo from '@duncit/brand/BrandLogo.astro';

interface Props {
  /** Sit over a full-bleed banner instead of on the page background. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { nav } = siteConfig;
const branding = await fetchBranding();

// An overlay header takes no layout space, which is what lets the banner start
// at the very top of the page and run underneath it; a page without a banner
// keeps the ordinary sticky bar that pushes content down.
const position = overlay ? 'fixed inset-x-0 top-0' : 'sticky top-0';
---

<!-- The solid bar is the DEFAULT, and the transparent state is added at the top
     of the page by script. The other way round, a failed script would leave
     white nav text on the cream background — invisible. -->
<header
  class={`site-header ${position} z-30 bg-cream/85 backdrop-blur`}
  data-overlay={overlay ? 'true' : undefined}
>
  <!-- Tighter padding than before: the mark grew, so the bar keeps its height
       from the logo rather than adding to it. -->
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="flex items-center gap-2" aria-label="Duncit">
      <BrandLogo src={branding.website_header_logo_url} name={branding.app_name} height={64} href={null} />
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {
        nav.links.map((link) => (
          <SmartLink
            href={link.href}
            label={link.label}
            class="nav-link text-sm font-semibold text-ink-soft transition hover:text-ink"
          >
            {link.label}
          </SmartLink>
        ))
      }
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="theme-toggle flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink transition hover:border-ink/30"
        data-theme-toggle
        aria-label="Switch between light and dark"
        aria-pressed="false"
      >
        <i class="fa-solid fa-moon text-sm" data-theme-icon aria-hidden="true"></i>
      </button>
      <SmartLink
        href={nav.login.href}
        label={nav.login.label}
        class="login-link rounded-full border border-ink/15 px-5 py-2 text-sm font-bold text-ink transition hover:border-ink/30"
      >
        {nav.login.label}
      </SmartLink>
      <SmartLink
        href={nav.signup.href}
        label={nav.signup.label}
        class="rounded-full bg-primary px-5 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-primary-dark"
      >
        {nav.signup.label}
      </SmartLink>
    </div>
  </nav>
</header>

<style>
  /* No hairline under the bar. Once the page scrolls, a soft shadow does the
     separating instead — the bar still ends somewhere, without a drawn line. */
  .site-header {
    transition: box-shadow 200ms ease, background-color 200ms ease;
  }
  .site-header:not(.at-top) {
    box-shadow: 0 6px 24px -12px rgba(9, 7, 18, 0.35);
  }

  /* Only a header declared as an overlay ever goes transparent, and only while
     the page is still at the top. */
  .site-header[data-overlay].at-top {
    /* Not flat transparent: the banner behind it can be bright, and white nav
       on a bright photograph is the same unreadable as dark nav was. A top-down
       scrim keeps the picture visible and the words legible. */
    background: linear-gradient(180deg, rgba(9, 7, 18, 0.55) 0%, rgba(9, 7, 18, 0) 100%);
    backdrop-filter: none;
    border-color: transparent;
  }
  /* :global on purpose — these anchors are rendered by SmartLink, so they carry
     ITS scope id, not this component's. A plain scoped selector compiles to
     `.nav-link[data-astro-cid-header]`, matches nothing, and the nav stays
     dark-on-photograph: exactly the bug this fixes. */
  .site-header[data-overlay].at-top :global(.nav-link),
  .site-header[data-overlay].at-top :global(.login-link),
  .site-header[data-overlay].at-top .theme-toggle {
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }
  .site-header[data-overlay].at-top .theme-toggle {
    border-color: rgba(255, 255, 255, 0.45);
  }
  .site-header[data-overlay].at-top :global(.login-link) {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header[data-overlay].at-top :global(.nav-link:hover) {
    opacity: 0.75;
  }
  /* The logo is a coloured mark on a photograph — a soft shadow keeps its
     edges off a bright frame without recolouring it. */
  .site-header[data-overlay].at-top img {
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.45));
  }
</style>

<script>
  // Transparent while the banner is behind it, solid once the page scrolls.
  // The class is on every header so the scrolled shadow works on pages with
  // no banner too; only an overlay header reads it for transparency.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const sync = () => header.classList.toggle('at-top', window.scrollY <= 24);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // The theme itself is applied before first paint by the layout; this button
  // only changes and remembers it.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const icon = document.querySelector<HTMLElement>('[data-theme-icon]');
  if (toggle && icon) {
    const paint = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      toggle.setAttribute('aria-pressed', String(dark));
      // The icon shows what a press GIVES you, not where you are.
      icon.className = `fa-solid ${dark ? 'fa-sun' : 'fa-moon'} text-sm`;
    };
    paint();
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('duncit-theme', next);
      paint();
    });
  }
</script>
