---
import { siteContent } from '../config/site-config';
import SmartLink from './SmartLink.astro';
import SectionHead from './home/SectionHead.astro';

const siteConfig = await siteContent();
const { steps, hero } = siteConfig;
---

<!-- The journey on one raised panel: five numbered cards, then the door in. -->
<section id="how" class="mx-2 scroll-mt-24 rounded-[2rem] bg-surface py-20 sm:mx-4 sm:rounded-panel sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-5">
    <SectionHead kicker={steps.eyebrow} headingLead={steps.heading} text={steps.text} />

    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5" data-reveal-group>
      {
        steps.items.map((step, index) => (
          <li data-reveal class="relative flex flex-col overflow-hidden rounded-card bg-cream p-7 sm:p-8">
            <span class="step-number font-head text-8xl leading-[0.8] font-extrabold" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="absolute top-7 right-7 grid h-12 w-12 place-items-center rounded-2xl bg-primary-light text-primary-strong">
              <i class={`fa-solid ${step.icon}`} aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-2xl text-ink">
              <span class="sr-only">{index + 1}.</span>
              {step.title}
            </h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))
      }
      <li data-reveal class="flex">
        <SmartLink
          href={hero.primaryCta.href}
          label={hero.primaryCta.label}
          glyph={false}
          class="step-cta group flex w-full flex-col justify-between gap-8 rounded-card border-2 border-dashed border-primary/40 p-7 text-ink sm:p-8"
        >
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-primary-fill text-xl text-on-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </span>
          <span class="flex items-center justify-between gap-3 font-head text-2xl font-extrabold">
            {hero.primaryCta.label}
            <span class="step-arrow grid h-12 w-12 shrink-0 place-items-center rounded-full bg-ink text-cream">
              <i class="fa-solid fa-arrow-right text-base" aria-hidden="true"></i>
            </span>
          </span>
        </SmartLink>
      </li>
    </ol>
  </div>
</section>

<style>
  /* The big outlined numeral — a shape, not a word, so it is hidden from
     screen readers; the heading carries the number for them. */
  .step-number {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-ink);
    opacity: 0.16;
    letter-spacing: -0.06em;
  }
  :global(.step-cta) {
    transition:
      background-color 300ms ease,
      border-color 300ms ease;
  }
  :global(.step-cta:hover) {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  :global(.step-cta .step-arrow) {
    transition: transform 400ms var(--ease-smooth);
  }
  :global(.step-cta:hover .step-arrow) {
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.step-cta .step-arrow) {
      transition: none;
    }
  }
</style>
