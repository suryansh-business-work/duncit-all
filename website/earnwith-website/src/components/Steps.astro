---
import { siteContent } from '../config/site-config';

const siteConfig = await siteContent();
const { steps } = siteConfig;
---

<section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-10">
  <div class="rounded-3xl bg-surface px-6 py-12 shadow-sm sm:px-12">
    <p class="text-center text-xs font-black uppercase tracking-[0.2em] text-primary">{steps.eyebrow}</p>
    <h2 class="mt-2 text-center text-3xl text-ink sm:text-4xl">{steps.heading}</h2>

    <ol class="mt-10 grid gap-8 sm:grid-cols-3 lg:grid-cols-5">
      {
        steps.items.map((step, index) => (
          <li class="relative text-center">
            {/* The dashed run to the next step, on the wide layout only —
                stacked columns have no gap for it to cross. */}
            {index < steps.items.length - 1 && (
              <span
                class="pointer-events-none absolute top-8 left-[calc(50%+2.5rem)] hidden h-px w-[calc(100%-5rem)] border-t-2 border-dashed border-primary/30 lg:block"
                aria-hidden="true"
              />
            )}
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-light text-primary-dark">
              <i class={`fa-solid ${step.icon} text-xl`} aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-base text-ink">
              {index + 1}. {step.title}
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
