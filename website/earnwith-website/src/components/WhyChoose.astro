---
import { siteContent } from '../config/site-config';
import SectionHead from './home/SectionHead.astro';

const siteConfig = await siteContent();
const { why } = siteConfig;

// A bento of reasons: two wide tiles over three narrow ones, each in its own
// colourway. Text on the filled tiles uses the colour's own on-* token.
const TILES = [
  { span: 'sm:col-span-2 lg:col-span-3', look: 'bg-primary-fill text-on-primary', glyph: 'bg-frame/20' },
  { span: 'lg:col-span-3', look: 'frame-scope bg-frame text-ink', glyph: 'bg-primary-fill text-on-primary' },
  { span: 'lg:col-span-2', look: 'border border-line bg-surface text-ink', glyph: 'bg-primary-light text-primary-strong' },
  { span: 'lg:col-span-2', look: 'bg-accent text-on-accent', glyph: 'bg-on-primary/50' },
  { span: 'sm:col-span-2 lg:col-span-2', look: 'bg-primary-light text-ink', glyph: 'bg-surface text-primary-strong' },
];
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-5">
    <SectionHead kicker={why.eyebrow} headingLead={why.heading} />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6 lg:gap-5" data-reveal-group>
      {
        why.items.map((item, index) => {
          const tile = TILES[index % TILES.length];
          return (
            <li data-reveal class={tile.span}>
              {/* The reveal moves the <li>; the hover lift moves this, so the
                  two transitions never fight over one transform. */}
              <div class={`why-tile relative flex h-full min-h-60 flex-col overflow-hidden rounded-card p-7 sm:min-h-72 ${tile.look}`}>
                <span class="why-ring" aria-hidden="true" />
                <span class={`grid h-14 w-14 place-items-center rounded-2xl text-xl ${tile.glyph}`}>
                  <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
                </span>
                <h3 class="mt-auto pt-10 text-2xl sm:text-3xl">{item.label}</h3>
                <p class="mt-3 max-w-md text-[0.95rem] leading-relaxed font-semibold">{item.text}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .why-tile {
    transition: transform 500ms var(--ease-smooth);
  }
  .why-tile:hover {
    transform: translateY(-6px) rotate(-0.6deg);
  }
  /* The soft ring in the corner, drawn in the tile's own text colour. */
  .why-ring {
    position: absolute;
    top: -4rem;
    right: -4rem;
    width: 13rem;
    height: 13rem;
    border-radius: 999px;
    border: 1.75rem solid currentColor;
    opacity: 0.08;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .why-tile {
      transition: none;
    }
    .why-tile:hover {
      transform: none;
    }
  }
</style>
