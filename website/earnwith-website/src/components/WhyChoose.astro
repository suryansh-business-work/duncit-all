---
import { siteConfig } from '../config/site-config';
const { why } = siteConfig;
---

<!-- One quiet strip of reasons between the four paths and the steps: what a
     partner gets, before being asked how to sign up. -->
<section class="mx-auto max-w-6xl px-5 pb-4 pt-10">
  <div class="rounded-3xl border border-line bg-surface px-6 py-8 shadow-sm">
    <p class="text-center text-xs font-black uppercase tracking-[0.2em] text-ink-soft">
      {why.eyebrow}
    </p>
    <ul class="mt-6 grid gap-6 sm:grid-cols-3 lg:grid-cols-5 lg:divide-x lg:divide-black/5">
      {
        why.items.map((item) => (
          <li class="flex items-center justify-center gap-3 px-2 text-center lg:text-left">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
              <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
            </span>
            <span class="text-sm font-bold text-ink">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
