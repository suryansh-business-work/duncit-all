---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteContent } from '../config/site-config';

const siteConfig = await siteContent();
---

<Layout title={`${siteConfig.notFound.title} — ${siteConfig.brand.name}`}>
  <SiteHeader />
  <main class="relative mx-auto flex max-w-3xl flex-col items-center overflow-hidden px-5 pt-20 pb-32 text-center sm:pt-28">
    <div class="blob top-0 left-1/2 h-80 w-80 -translate-x-1/2 bg-primary opacity-20" aria-hidden="true"></div>
    <span data-reveal="scale" class="not-found-code relative font-head text-[7rem] leading-none font-extrabold sm:text-[11rem]" aria-hidden="true">404</span>
    <h1 data-reveal class="relative mt-4 text-4xl text-ink sm:text-6xl">{siteConfig.notFound.heading}</h1>
    <p data-reveal class="relative mt-5 max-w-md text-lg text-ink-soft">{siteConfig.notFound.text}</p>
    <div data-reveal class="relative mt-10">
      <a href="/" class="btn bg-primary-fill text-on-primary shadow-lift">
        <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
        {siteConfig.notFound.cta}
      </a>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .not-found-code {
    color: transparent;
    -webkit-text-stroke: 3px var(--color-primary);
    letter-spacing: -0.06em;
  }
</style>
