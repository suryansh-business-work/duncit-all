---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import EarnPaths from '../components/EarnPaths.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Steps from '../components/Steps.astro';
import EarningsCalculator from '../components/EarningsCalculator.astro';
import EarningsShots from '../components/EarningsShots.astro';
import CtaBand from '../components/CtaBand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config/site-config';
---

<Layout title={siteConfig.brand.title}>
  <SiteHeader overlay />
  <main>
    <Hero />
    <EarnPaths />
    <WhyChoose />
    <Steps />
    <EarningsCalculator />
    <EarningsShots />
    <CtaBand />
  </main>
  <SiteFooter />
</Layout>
