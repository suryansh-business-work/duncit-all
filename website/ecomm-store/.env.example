# Duncit Pet Store storefront (dev port 2039) — ecomm.duncit.com.
#
# Local `vite dev` needs none of these — it defaults to
# http://localhost:2001/graphql. CI injects the real values at build time.

# API endpoint. Empty = dev localhost / build-time production default.
VITE_GRAPHQL_URL=

# Shared Google OAuth client id (secret — injected by CI, blank locally).
VITE_GOOGLE_CLIENT_ID=

# Where "Create an account" sends a new shopper (the Duncit signup).
VITE_MWEB_URL=

# The store's own public address, for canonical links.
VITE_SITE_URL=
