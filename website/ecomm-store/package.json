{
  "name": "ecomm-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:check": "node ../../scripts/deps.mjs check",
    "deps:update": "node ../../scripts/deps.mjs update",
    "dev": "vite",
    "dev:main": "cross-env VITE_GRAPHQL_URL=https://server.duncit.com/graphql vite",
    "dev:staging": "cross-env VITE_GRAPHQL_URL=https://staging.server.duncit.com/graphql vite",
    "dev:local": "cross-env VITE_GRAPHQL_URL=http://localhost:2001/graphql vite",
    "build": "tsc -b && vite build && vite build --config vite.config.server.ts && node ../../scripts/verify-fallback-icons.mjs src/fallback-icons",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.server.json",
    "start": "node dist-server/main.mjs",
    "e2e": "node ../../scripts/e2e-no-surface.mjs ecomm-store"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@duncit/app-settings": "workspace:*",
    "@duncit/auth-tokens": "workspace:*",
    "@duncit/brand": "workspace:*",
    "@duncit/buttons": "workspace:*",
    "@duncit/captcha": "workspace:*",
    "@duncit/datetime": "workspace:*",
    "@duncit/dialogs": "workspace:*",
    "@duncit/fallback-icons": "workspace:*",
    "@duncit/forms": "workspace:*",
    "@duncit/i18n": "workspace:*",
    "@duncit/location": "workspace:*",
    "@duncit/logs": "workspace:*",
    "@duncit/regex": "workspace:*",
    "@duncit/ui": "workspace:*",
    "@duncit/user-context": "workspace:*",
    "@duncit/user-core": "workspace:*",
    "@duncit/utils": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/nunito": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@react-oauth/google": "^0.13.5",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
