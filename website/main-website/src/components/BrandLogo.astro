---
// The site's header mark. The DRAWING lives in @duncit/brand so all five
// websites render the admin's logo — and the wordmark that stands in when
// there is none — the same way and at the same size; this wrapper only knows
// where this site's branding comes from.
import SharedBrandLogo from '@duncit/brand/BrandLogo.astro';
import { fetchBranding } from '../lib/site-data';

interface Props {
  class?: string;
  height?: number;
}
const { class: className = '', height = 56 } = Astro.props;
const branding = await fetchBranding();
---

<SharedBrandLogo
  src={branding.website_header_logo_url}
  name={branding.app_name}
  height={height}
  class={className}
/>
