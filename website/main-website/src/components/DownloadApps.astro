---
// This site's words on the shared download band. The band, the store buttons,
// the "coming soon" state and the phone live in @duncit/brand — four sites had
// four versions of the same two store listings.
import AppDownload from '@duncit/brand/AppDownload.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();
const branding = await fetchBranding();
const stores = [
  {
    icon: 'fa-google-play',
    eyebrow: t('website.main.download.googlePlayEyebrow'),
    name: t('website.main.download.googlePlayName'),
    url: branding.android_app_url,
  },
  {
    icon: 'fa-apple',
    eyebrow: t('website.main.download.appStoreEyebrow'),
    name: t('website.main.download.appStoreName'),
    url: branding.ios_app_url,
  },
];
---

<AppDownload
  heading={t('website.main.download.headingLead')}
  headingAccent={t('website.main.download.headingAccent')}
  text={t('website.main.download.text')}
  perks={[
    t('website.main.download.perk1'),
    t('website.main.download.perk2'),
    t('website.main.download.perk3'),
  ]}
  stores={stores}
/>
