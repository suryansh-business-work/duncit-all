---
// The rest of Duncit. Three sites sit alongside this one: a host looking to
// earn, a brand looking to advertise and a venue looking to list should not
// have to already know the subdomain.
//
// Every URL comes from url-configs, so a local run links to localhost and a
// deploy links to the real host; SmartLink marks them as leaving the site.
import { urlConfigs } from '../config/url-configs';
import SmartLink from './SmartLink.astro';
import SectionHead from './SectionHead.astro';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();

const destinations = [
  {
    icon: 'fa-coins',
    eyebrow: t('website.main.network.earnEyebrow'),
    title: t('website.main.network.earnTitle'),
    text: t('website.main.network.earnText'),
    cta: t('website.main.network.earnCta'),
    href: urlConfigs.earnwithUrl,
    art: 'bg-tertiary text-on-accent',
    arrow: 'bg-tertiary text-on-accent',
  },
  {
    icon: 'fa-bullhorn',
    eyebrow: t('website.main.network.adsEyebrow'),
    title: t('website.main.network.adsTitle'),
    text: t('website.main.network.adsText'),
    cta: t('website.main.network.adsCta'),
    href: urlConfigs.adsSiteUrl,
    art: 'bg-secondary-light text-secondary',
    arrow: 'bg-secondary text-white',
  },
  {
    icon: 'fa-handshake',
    eyebrow: t('website.main.network.partnersEyebrow'),
    title: t('website.main.network.partnersTitle'),
    text: t('website.main.network.partnersText'),
    cta: t('website.main.network.partnersCta'),
    href: urlConfigs.partnersSiteUrl,
    art: 'bg-primary-light text-primary-ink',
    arrow: 'bg-primary-dark text-white',
  },
];
---

<section id="network" class="mt-3 scroll-mt-24 rounded-panel bg-cream px-5 py-20 sm:px-10 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHead kicker={t('website.main.network.eyebrow')} title={t('website.main.network.heading')} text={t('website.main.network.text')} />

    <ul data-reveal-group class="grid gap-5 md:grid-cols-3">
      {
        destinations.map((place) => (
          <li data-reveal>
            <SmartLink
              href={place.href}
              label={place.title}
              glyph={false}
              class="group flex h-full flex-col rounded-card border border-line bg-surface p-6 transition duration-500 ease-soft hover:-translate-y-1.5 hover:shadow-lift sm:p-8 md:min-h-[26rem]"
            >
              <span class={`mb-7 flex h-28 items-end rounded-[1.25rem] p-4 ${place.art}`} aria-hidden="true">
                <i class={`fa-solid ${place.icon} text-4xl`} />
              </span>
              <span class="font-head text-xs font-extrabold tracking-[0.12em] text-ink-soft uppercase">{place.eyebrow}</span>
              <h3 class="headline mt-3 text-3xl text-ink sm:text-[2.5rem]">{place.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{place.text}</p>
              {/* Pushed to the bottom so cards of different lengths still end
                  on the same line. */}
              <span class="mt-auto flex items-center justify-between gap-4 pt-8 font-head font-extrabold text-ink">
                {place.cta}
                <span
                  class={`inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full transition duration-500 ease-soft group-hover:-rotate-45 ${place.arrow}`}
                  aria-hidden="true"
                >
                  <i class="fa-solid fa-arrow-right" />
                </span>
              </span>
            </SmartLink>
          </li>
        ))
      }
    </ul>
  </div>
</section>
