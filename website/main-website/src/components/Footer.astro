---
// Shared footer used across all pages. Link columns come from the Website
// portal (Navigation manager) and the Policy Hub strip from the Legal portal's
// active policies, both baked in at build time with localized fallbacks.
import { fetchBranding, fetchNavGroups, fetchPolicies } from '../lib/site-data';
import { navFallback } from '../lib/nav-fallback';
import { getTranslator } from '../lib/i18n';
import FooterLogo from '@duncit/brand/FooterLogo.astro';
import SharedNewsletter from '@duncit/brand/NewsletterSignup.astro';
import PolicyStrip from '@duncit/brand/PolicyStrip.astro';
import SocialLinks from '@duncit/brand/SocialLinks.astro';
import SmartLink from './SmartLink.astro';
import { urlConfigs } from '../config/url-configs';

// Chrome copy comes from Admin > Localization, baked in at build time with the
// bundled fallback behind it (rule 38). The fallback columns are the same list
// the header uses, plus the support mailbox.
const { t } = await getTranslator();
const branding = await fetchBranding();
const columns = await fetchNavGroups('MAIN', 'FOOTER', navFallback(t, branding.support_email));
const policies = await fetchPolicies();
const year = new Date().getFullYear();
---

<footer class="mt-3 overflow-hidden rounded-panel bg-cream px-5 pt-16 pb-8 sm:px-10 sm:pt-24">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <FooterLogo
          footerSrc={branding.website_footer_logo_url}
          headerSrc={branding.website_header_logo_url}
          name={branding.app_name}
          height={72}
          graphqlUrl={urlConfigs.graphqlUrl}
        />
        <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">{t('website.main.layout.siteDescription')}</p>
        <SocialLinks heading={t('website.footer.followUs')} class="mt-6" />
      </div>
      <!-- The same form the other Duncit sites use; the copy is this site's
           (Admin > Localization), the mechanism is shared. -->
      <SharedNewsletter
        graphqlUrl={urlConfigs.graphqlUrl}
        source="WEBSITE_FOOTER"
        variant="card"
        heading={t('website.footer.newsletterTitle')}
        placeholder={t('website.footer.emailPlaceholder')}
        button={t('website.footer.notify')}
        busyText={t('website.footer.sending')}
        okText={t('website.footer.subscribed')}
        errorText={t('website.footer.tryAgain')}
      />
    </div>

    <div data-reveal-group class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line pt-12 md:grid-cols-4">
      {
        columns.map((column) => (
          <div data-reveal>
            <h2 class="mb-4 font-head text-xs font-extrabold tracking-[0.12em] text-ink uppercase">{column.label}</h2>
            <ul class="space-y-1 text-[0.95rem] font-semibold text-ink-soft">
              {column.links.map((link) => (
                <li>
                  {/* The Navigation manager can point a column at another
                      Duncit surface; SmartLink decides from the URL. */}
                  <SmartLink href={link.url} label={link.label} class="inline-flex min-h-9 items-center transition hover:text-primary-ink">
                    {link.label}
                  </SmartLink>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Policies get the full width: as a narrow column they were a scroll of
         one-word-per-line links; across the footer they are a list. -->
    <PolicyStrip
      policies={policies}
      heading={t('website.footer.policyHub')}
      allLabel={t('website.footer.allPolicies')}
      class="mt-12"
    />

    <p
      class="headline outline-text mt-14 overflow-hidden text-center text-[clamp(4.5rem,21vw,13.5rem)] leading-[0.8] tracking-[-0.07em] whitespace-nowrap lowercase select-none"
      aria-hidden="true"
    >
      {branding.app_name}
    </p>

    <div class="mt-8 border-t border-line pt-6 text-center text-sm text-ink-soft">
      © {branding.app_name} {year} | {t('website.footer.rights')}
    </div>
  </div>
</footer>
