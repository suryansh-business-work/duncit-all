---
// Site-wide side navigation drawer, opened by any element with
// [data-nav-toggle] (the TopBar's menu button). Sections come from the Website
// portal (Navigation manager); the Policy Hub group is the Legal portal's
// active policies.
import BrandLogo from './BrandLogo.astro';
import { fetchNavGroups, fetchPolicies } from '../lib/site-data';
import { navFallback, type FallbackNavGroup } from '../lib/nav-fallback';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';
import SmartLink from './SmartLink.astro';

// Chrome copy from Admin > Localization; link labels stay Navigation-manager
// content (rule 38).
const { t } = await getTranslator();

// The Navigation manager owns the labels when it answers, and its groups are
// stored in English, so the icon for a PORTAL group is still looked up by its
// English label. A FALLBACK group carries its own icon instead.
const GROUP_ICONS: Record<string, string> = {
  About: 'fa-circle-info',
  Community: 'fa-people-group',
  'Safety Hub': 'fa-shield-heart',
  Support: 'fa-life-ring',
  'Policy Hub': 'fa-lock',
};

const navGroups: FallbackNavGroup[] = await fetchNavGroups('MAIN', 'HEADER', navFallback(t));
const policies = await fetchPolicies();
const sections = [
  ...navGroups.map((group) => ({
    title: group.label,
    icon: group.icon ?? GROUP_ICONS[group.label] ?? 'fa-hashtag',
    links: group.links.map((link) => ({ href: link.url, label: link.label, more: false })),
  })),
  {
    title: t('website.footer.policyHub'),
    icon: 'fa-lock',
    links: [
      ...policies.map((policy) => ({ href: `/policy/${policy.slug}`, label: policy.title, more: false })),
      { href: '/policies', label: t('website.footer.allPolicies'), more: true },
    ],
  },
];
const chip =
  'inline-flex min-h-11 items-center rounded-2xl border px-3.5 py-2 text-sm font-bold transition duration-200 ease-soft hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-cream';
const iconButton = 'inline-flex h-11 w-11 items-center justify-center rounded-full border transition';
---

<!-- Backdrop -->
<div
  id="navBackdrop"
  data-nav-backdrop
  class="fixed inset-0 z-40 bg-frame/55 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity duration-500 ease-soft"
>
</div>

<!-- Drawer: a floating panel. Closed, it slides fully past the screen edge
     and turns invisible, so its links leave the tab order too. -->
<aside
  id="siteNav"
  data-cms-widget="site-nav"
  aria-label={t('website.main.nav.drawer')}
  class="group fixed inset-y-3 left-3 z-50 flex w-[calc(100%-1.5rem)] max-w-[27rem] -translate-x-full flex-col overflow-hidden rounded-panel bg-cream shadow-lift transition-[transform,visibility] duration-500 ease-soft aria-[hidden=true]:invisible aria-[hidden=true]:-translate-x-[calc(100%+2rem)]"
  aria-hidden="true"
>
  <div class="flex items-center justify-between px-5 pt-5 pb-4">
    <BrandLogo height={40} />
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class={`${iconButton} border-line bg-surface text-ink hover:border-primary hover:text-primary-ink`}
        aria-label={t('website.nav.theme')}
        aria-pressed="false"
      >
        <i class="fa-solid fa-moon text-sm" data-theme-icon aria-hidden="true"></i>
      </button>
      <button
        type="button"
        data-nav-close
        class={`${iconButton} border-ink bg-ink text-cream hover:border-primary-dark hover:bg-primary-dark hover:text-white`}
        aria-label={t('website.nav.closeMenu')}
      >
        <i class="fa-solid fa-xmark text-lg" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto px-5 pb-5">
    <a
      href="/#download"
      class="relative mb-6 block overflow-hidden rounded-3xl bg-primary-dark p-5 text-white transition duration-300 ease-soft hover:-translate-y-0.5 hover:shadow-soft"
    >
      <i class="fa-solid fa-mobile-screen-button absolute -right-2 -bottom-5 text-[6.5rem] opacity-20" aria-hidden="true"></i>
      <span class="relative block headline text-[1.375rem]">{t('website.main.nav.promoTitle')}</span>
      <span class="relative mt-1 block text-sm font-semibold">{t('website.main.nav.promoText')}</span>
    </a>

    {
      sections.map((section, index) => (
        <div
          class="mb-6 translate-x-0 opacity-100 transition duration-500 ease-soft group-aria-[hidden=true]:-translate-x-6 group-aria-[hidden=true]:opacity-0"
          style={`transition-delay:${Math.min(index, 6) * 60}ms`}
        >
          <p id={`nav-group-${index}`} class="mb-2.5 flex items-center gap-2.5 font-head text-xs font-extrabold uppercase tracking-[0.14em] text-ink-soft">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-primary-light text-primary-ink">
              <i class={`fa-solid ${section.icon} text-sm`} aria-hidden="true" />
            </span>
            {section.title}
          </p>
          <ul class="flex flex-wrap gap-2" aria-labelledby={`nav-group-${index}`}>
            {section.links.map((link) => (
              <li>
                {/* The Navigation manager can point an entry at another Duncit
                    surface; SmartLink decides from the URL. */}
                <SmartLink
                  href={link.href}
                  label={link.label}
                  glyph={false}
                  class={`${chip} ${link.more ? 'border-dashed border-line text-primary-ink' : 'border-line bg-surface text-ink'}`}
                >
                  {link.label}
                </SmartLink>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="flex gap-2.5 border-t border-line px-5 pt-4 pb-5">
    <a
      href={`${urlConfigs.mwebUrl}/register`}
      class="inline-flex h-12 flex-1 items-center justify-center rounded-full bg-primary-dark font-head text-sm font-bold text-white transition hover:-translate-y-0.5"
    >
      {t('website.main.home.join')}
    </a>
    <a
      href={`${urlConfigs.mwebUrl}/login`}
      class="inline-flex h-12 flex-1 items-center justify-center rounded-full border border-line font-head text-sm font-bold text-ink transition hover:border-ink"
    >
      {t('website.main.home.signIn')}
    </a>
  </div>
</aside>

<!--
  The drawer + theme button behaviour is the CMS widget
  @duncit/brand/widgets/site-nav. Openers are delegated, so any
  [data-nav-toggle] opens it.
-->
<script>
  import { mount } from '@duncit/brand/widgets/site-nav';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="site-nav"]')) mount(root);
</script>
