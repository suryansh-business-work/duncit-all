---
// Website-portal content (blog, newsroom, careers), fetched in the browser so
// a published item is live without a redeploy — see scripts/content-list.ts
// for the fetch and scripts/content-cards.ts for the card designs.
//
// Careers: each role's Apply button opens the shared @duncit/brand
// CareersApply dialog, whose `careers-apply` widget posts the application to
// the Website portal's Job Applications inbox.
import CareersApply from '@duncit/brand/CareersApply.astro';
import { urlConfigs } from '../config/url-configs';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();

interface Props {
  type: 'CAREERS' | 'NEWSROOM' | 'BLOG';
  variant?: 'jobs' | 'news' | 'cards';
}

const { type, variant = 'cards' } = Astro.props;
const copy = {
  empty: t('website.main.contentList.empty'),
  error: t('website.main.contentList.error'),
  readMore: t('website.main.contentList.readMore'),
  apply: t('website.brand.apply.button'),
};
// The rule this site has always applied to the optional phone field. It
// belongs in @duncit/regex (PHONE_INTL_PLUS) once this site depends on it.
const phonePattern = String.raw`\+?\d{6,15}`;
const skeletons = variant === 'cards' ? ['h-80', 'h-80', 'h-80'] : ['h-44', 'h-44'];
---

<div
  class="not-prose"
  data-website-content-list
  data-type={type}
  data-variant={variant}
  data-graphql-url={urlConfigs.graphqlUrl}
  data-copy={JSON.stringify(copy)}
>
  <div class:list={['grid gap-6', variant === 'cards' ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2']} aria-hidden="true">
    {skeletons.map((height) => <div class={`skeleton rounded-card ${height}`} />)}
  </div>
</div>

{variant === 'jobs' && <CareersApply graphqlUrl={urlConfigs.graphqlUrl} phonePattern={phonePattern} t={t} />}

<script>
  import { mount } from '@duncit/brand/widgets/careers-apply';
  import { loadContentList } from '../scripts/content-list';

  for (const root of document.querySelectorAll<HTMLElement>('[data-website-content-list]')) {
    loadContentList(root).catch((error: unknown) => console.error('website content list crashed', error));
  }
  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="careers-apply"]')) mount(root);
</script>
