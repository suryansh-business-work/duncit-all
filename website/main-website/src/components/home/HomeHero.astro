---
// The opening panel: the Duncit reel full-bleed under a fixed-dark scrim, the
// statement over it, and three floating cards saying what the app does.
// The TopBar floats over the top of this panel, hence the tall top padding.
import { urlConfigs } from '../../config/url-configs';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();

const floats = [
  { icon: 'fa-user-check', tint: 'bg-secondary', title: t('website.main.home.chipVerified'), text: t('website.main.home.floatVerifiedText'), place: 'top-6 left-0', delay: '-2s' },
  { icon: 'fa-bolt', tint: 'bg-primary-dark', title: t('website.main.home.chipMatched'), text: t('website.main.home.floatMatchedText'), place: 'top-44 right-0', delay: '-4s' },
  { icon: 'fa-champagne-glasses', tint: 'bg-ink', title: t('website.main.home.chipGatherings'), text: t('website.main.home.floatGatheringsText'), place: 'bottom-6 left-10', delay: '0s' },
];
const proofIcons = [
  { icon: 'fa-user-check', tint: 'bg-secondary text-white' },
  { icon: 'fa-bolt', tint: 'bg-primary-dark text-white -ml-2.5' },
  { icon: 'fa-location-dot', tint: 'bg-tertiary text-on-accent -ml-2.5' },
];
---

<section class="relative isolate overflow-hidden rounded-panel bg-frame px-5 pt-28 pb-20 text-white sm:px-10 sm:pt-36 lg:min-h-[46rem]">
  <!-- `preload="auto"`, not metadata: with metadata the browser fetches the
       header and stops, and a reel behind a poster is exactly what "the video
       is not playing" looks like. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <video
      id="heroReel"
      class="h-full w-full object-cover"
      poster="/media/duncit-reel-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/media/duncit-reel.mp4" type="video/mp4" />
    </video>
    <!-- Built from `frame`, which never inverts: the words on it are always
         white, so what darkens the reel must stay dark in both themes. -->
    <div class="absolute inset-0 bg-linear-to-r from-frame/90 via-frame/60 to-frame/20"></div>
    <div class="absolute inset-0 bg-linear-to-t from-frame/70 to-transparent to-50%"></div>
    <div class="absolute -top-40 -right-20 h-[28rem] w-[28rem] rounded-full bg-primary opacity-30 mix-blend-screen blur-[70px] motion-safe:animate-drift"></div>
    <div class="absolute top-72 -left-28 h-80 w-80 rounded-full bg-tertiary opacity-25 mix-blend-screen blur-[70px] motion-safe:animate-drift [animation-delay:-12s]"></div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]">
    <div data-reveal-group>
      <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 py-1.5 pr-4 pl-1.5 font-head text-[0.8125rem] font-bold backdrop-blur">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary-dark">
          <i class="fa-solid fa-heart text-[0.7rem]" aria-hidden="true"></i>
        </span>
        {t('website.main.home.badge')}
      </span>

      <h1 data-reveal class="headline mt-7 text-[3.25rem] sm:text-7xl lg:text-[6.25rem]">
        {t('website.main.home.headingLine1')}
        <span class="block">
          {t('website.main.home.headingLine2Lead')}
          <span class="relative inline-block text-primary">
            {t('website.main.home.headingLine2Accent')}.
            <svg class="absolute -bottom-3 -left-[2%] h-6 w-[104%] text-tertiary" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
              <path class="motion-safe:animate-draw" d="M4 16 C 80 4, 160 4, 220 12 S 340 22, 396 8" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"></path>
            </svg>
          </span>
        </span>
      </h1>

      <p data-reveal class="mt-8 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">{t('website.main.home.intro')}</p>

      <div data-reveal class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={`${urlConfigs.mwebUrl}/register`}
          class="inline-flex h-14 items-center justify-center gap-2.5 rounded-full bg-primary-dark px-7 font-head text-base font-bold text-white shadow-lift transition duration-300 ease-soft hover:-translate-y-0.5 hover:scale-[1.02]"
        >
          {t('website.main.home.join')} <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
        </a>
        <a
          href={`${urlConfigs.mwebUrl}/login`}
          class="inline-flex h-14 items-center justify-center gap-2.5 rounded-full border border-white/45 px-7 font-head text-base font-bold text-white backdrop-blur transition duration-300 ease-soft hover:-translate-y-0.5 hover:bg-white/15"
        >
          {t('website.main.home.signIn')}
        </a>
      </div>

      <div data-reveal class="mt-10 flex items-center gap-4 text-[0.95rem] font-semibold text-white/80">
        <span class="flex" aria-hidden="true">
          {proofIcons.map((item) => (
            <span class={`inline-flex h-10 w-10 items-center justify-center rounded-full border-[3px] border-frame ${item.tint}`}>
              <i class={`fa-solid ${item.icon} text-sm`} />
            </span>
          ))}
        </span>
        <span class="max-w-xs">{t('website.main.home.proof')}</span>
      </div>
    </div>

    <!-- Floating cards: decoration that repeats the copy above, so hidden from
         screen readers and from small screens where they would crowd it. -->
    <div class="relative hidden h-[26rem] lg:block" aria-hidden="true">
      {floats.map((card) => (
        <div
          class={`absolute ${card.place} flex items-center gap-3 rounded-[1.25rem] bg-surface px-4 py-3.5 text-ink shadow-lift motion-safe:animate-bob`}
          style={`animation-delay:${card.delay}`}
        >
          <span class={`inline-flex h-10 w-10 items-center justify-center rounded-xl text-white ${card.tint}`}>
            <i class={`fa-solid ${card.icon}`} />
          </span>
          <span>
            <b class="block font-head text-sm font-extrabold">{card.title}</b>
            <span class="text-xs font-semibold text-ink-soft">{card.text}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <a href="#download" class="absolute bottom-6 left-5 inline-flex min-h-11 items-center gap-2.5 font-head text-xs font-bold tracking-[0.12em] text-white/80 uppercase transition hover:text-white sm:left-10">
    <span class="h-2 w-2 rounded-full bg-primary motion-safe:animate-pulse-dot" aria-hidden="true"></span>
    {t('website.main.home.scroll')}
  </a>
</section>

<script is:inline>
  // `autoplay` is a request, not a guarantee: a browser can refuse it on a
  // metered connection or a saved data setting, and it refuses SILENTLY. So
  // ask, and if refused, ask again on the first thing the visitor touches.
  (function () {
    var video = document.getElementById('heroReel');
    if (!video) return;

    // Someone who asked their system for less motion gets the poster frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }

    function play() {
      var attempt = video.play();
      if (attempt && attempt.catch) {
        attempt.catch(function (error) {
          // Refused: the poster stays up and the next interaction asks again.
          console.info('[hero] reel autoplay refused', error && error.name);
        });
      }
    }

    play();
    video.addEventListener('canplay', play, { once: true });

    var events = ['pointerdown', 'touchstart', 'keydown'];
    function onFirstInteraction() {
      play();
      events.forEach(function (name) {
        document.removeEventListener(name, onFirstInteraction);
      });
    }
    events.forEach(function (name) {
      document.addEventListener(name, onFirstInteraction, { passive: true });
    });
  })();
</script>
