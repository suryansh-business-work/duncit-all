---
// The grievance page's left column: who reviews a grievance (the officer
// block we are required to publish, filled in by the Legal portal) and the
// escalation ladder — support first, grievance after — before the form, so a
// visitor reads it before typing. The ladder hides with the form once a
// grievance lands (`data-grievance-ladder`, see the grievance-form widget).
import { grievanceEscalationCopy } from '@duncit/i18n';
import { fetchGrievanceOfficer } from '../../lib/site-data';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();
const officer = await fetchGrievanceOfficer();

const officerRows = officer
  ? [
      [t('grievance.officerName'), officer.name],
      [t('grievance.officerEmail'), officer.email],
      [t('grievance.officerPhone'), officer.phone],
      [t('grievance.officerAddress'), officer.address],
    ].filter(([, value]) => value)
  : [];

// The same three steps and the same warning the two apps render, from the
// shared builder — a visitor told one thing here and another in the app has
// a fair argument that they were misled.
const escalation = grievanceEscalationCopy(t);
---

<div class="not-prose grid gap-6">
  <section data-reveal class="rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8">
    <span class="kicker">{t('website.main.grievance.officerKicker')}</span>
    <h2 class="mt-2 font-head text-2xl font-extrabold tracking-tight text-ink">{t('grievance.officerTitle')}</h2>
    {
      officerRows.length === 0 ? (
        <p class="mt-4 text-ink-soft">{t('grievance.officerEmpty')}</p>
      ) : (
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          {officerRows.map(([label, value]) => (
            <div class="rounded-2xl bg-lilac p-4">
              <dt class="text-xs font-bold tracking-wide text-ink-soft uppercase">{label}</dt>
              <dd class="mt-1 font-bold break-words text-ink">{value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </section>

  <section data-reveal id="grievanceLadder" data-grievance-ladder class="rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8">
    <span class="kicker">{t('website.main.grievance.processKicker')}</span>
    <h2 class="mt-2 font-head text-2xl font-extrabold tracking-tight text-ink">{escalation.title}</h2>
    <ol class="relative mt-6 grid gap-6 before:absolute before:top-2 before:bottom-2 before:left-[1.1rem] before:w-0.5 before:bg-line">
      {
        escalation.steps.map((step, index) => (
          <li class="relative flex gap-4">
            <span class="relative z-10 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink font-head text-sm font-extrabold text-cream" aria-hidden="true">
              {index + 1}
            </span>
            <span class="grid gap-1 pt-1">
              <span class="font-head font-extrabold text-ink">{step.title}</span>
              <span class="text-sm leading-relaxed text-ink-soft">{step.body}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 flex gap-3 rounded-2xl border-2 border-tertiary-dark bg-tertiary/25 p-4 text-sm font-bold text-ink" role="note">
      <i class="fa-solid fa-triangle-exclamation mt-0.5 text-tertiary-dark" aria-hidden="true"></i>
      <span>{escalation.warning}</span>
    </p>
  </section>
</div>
