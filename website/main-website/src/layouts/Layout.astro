---
import '../styles/global.css';
import { fetchBranding } from '../lib/site-data';
import { urlConfigs } from '../config/url-configs';
import { SHORT_CODE_PATTERN } from '../lib/short-link';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Duncit — the friendship platform that matches people by energy, not algorithms.',
} = Astro.props;

// Admin-managed favicon (Branding → Website Logos), baked in at build time.
const branding = await fetchBranding();
const favicon = branding.website_favicon_url || '/duncit-logo.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/*
      Short links. The apex answers every unknown path with this page (nginx
      `try_files ... /index.html`), so duncit.com/aB3xY9Zq lands here instead
      of 404ing. Hand a code-shaped path to the API resolver, which counts the
      click and redirects on to the tagged destination.

      `is:inline` and placed first on purpose: it must run before anything
      renders, so a visitor following a link never sees the home page flash.
      A real page is always a lowercase word, so the pattern cannot match one.
    */}
    <script
      is:inline
      define:vars={{
        shortLinkBase: `${urlConfigs.serverUrl.replace(/\/+$/, '')}/r`,
        shortCodePattern: SHORT_CODE_PATTERN.source,
      }}
    >
      (function () {
        var path = window.location.pathname.replace(/^\/+/, '').replace(/\/+$/, '');
        if (!new RegExp(shortCodePattern).test(path)) return;
        var params = new URLSearchParams(window.location.search);
        // Forward the ORIGINAL referrer. By the next hop document.referrer
        // says duncit.com, so without this every click would be recorded as
        // having come from our own site instead of Instagram, a post or a chat.
        if (document.referrer) params.set('dr', document.referrer);
        var query = params.toString();
        window.location.replace(shortLinkBase + '/' + path + (query ? '?' + query : ''));
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
    <script is:inline>
      // Before the first paint, so a dark-mode visitor never sees a white
      // flash: the saved choice wins, otherwise the operating system's.
      (() => {
        const saved = localStorage.getItem('duncit-theme');
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || system;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Plus+Jakarta+Sans:wght@600;700;800;900&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
  <script>
    // Short-link attribution: a duncit.com marketing link may land on this
    // site carrying dl/dlc markers. The shared helper verifies them against
    // the API and records the visit; ordinary traffic costs one no-op call.
    import {
      captureShortLinkAttribution,
      installAttributionLinkDecorator,
    } from '@duncit/utils';
    import { urlConfigs } from '../config/url-configs';
    captureShortLinkAttribution({
      search: window.location.search,
      referrer: document.referrer,
      serverUrl: urlConfigs.serverUrl,
    });
    // Keep the tags on every hyperlink out to another duncit surface —
    // storage does not cross origins, the URL does.
    installAttributionLinkDecorator();
  </script>
    <slot />
      <script>
      // Ship console errors to SignOz (via the server /logs ingest).
      import { configureLogs, httpTransport } from '@duncit/logs';
      configureLogs(httpTransport(import.meta.env.PROD ? 'https://server.duncit.com/logs' : 'http://localhost:2001/logs'), { platform: 'web' });
    </script>
  </body>
</html>
