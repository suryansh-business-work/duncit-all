---
// The shell every inner page wears: the top bar floating over a photo hero,
// the article panel, the footer.
import Layout from './Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/prose-page.css';

interface Props {
  title: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  heroImage?: string;
  accent?: 'primary' | 'secondary' | 'tertiary';
  /** Bento grids, card lists and side navs need the full panel width; a
   * page of running prose reads best at a measure. */
  wide?: boolean;
}

const {
  eyebrow,
  heading,
  intro,
  heroImage = 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1600&q=80&auto=format&fit=crop',
  accent = 'primary',
  wide = false,
} = Astro.props;

// The accent word sits on the photo's fixed-dark scrim, so the bright tones
// read in both themes.
const accentClass = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
}[accent];

// The eyebrow badge: white only on tones dark enough to carry small white
// text; yellow never inverts, so it takes the fixed dark `on-accent`.
const badgeClass = {
  primary: 'bg-primary-dark text-white',
  secondary: 'bg-secondary text-white',
  tertiary: 'bg-tertiary text-on-accent',
}[accent];

const words = heading.split(' ');
const lead = words.slice(0, -1).join(' ');
const last = words[words.length - 1];
---

<Layout title={`${heading} — Duncit`}>
  <SiteNav />
  <div class="bg-frame p-2 sm:p-3">
    <TopBar />

    <section class="relative isolate flex min-h-[26rem] items-end overflow-hidden rounded-panel bg-frame px-5 pt-32 pb-14 sm:min-h-[30rem] sm:px-10 sm:pb-16">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <img src={heroImage} alt="" class="h-full w-full object-cover" />
        <!-- The heading over this scrim is always white, so the scrim must stay
             dark in both themes: `frame` never inverts, `ink` does. -->
        <div class="absolute inset-0 bg-linear-to-r from-frame/85 via-frame/55 to-frame/25"></div>
        <div class="absolute inset-0 bg-linear-to-t from-frame/80 to-transparent to-60%"></div>
      </div>

      <div data-reveal-group class="mx-auto w-full max-w-6xl">
        {
          eyebrow && (
            <span data-reveal class={`inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 font-head text-xs font-extrabold tracking-[0.12em] uppercase ${badgeClass}`}>
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true" /> {eyebrow}
            </span>
          )
        }
        <h1 data-reveal data-page-heading class="headline mt-5 max-w-4xl text-[2.75rem] text-white sm:text-6xl lg:text-[5.25rem]">
          {lead && <Fragment>{lead} </Fragment>}<span class={accentClass}>{last}</span>
        </h1>
        {intro && <p data-reveal class="mt-5 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">{intro}</p>}
      </div>
    </section>

    <main class="mt-3 rounded-panel bg-cream px-5 py-14 sm:px-10 lg:py-24">
      <article class:list={['prose-page mx-auto text-[1.05rem] leading-relaxed text-ink-soft', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        <slot />
      </article>
    </main>

    <Footer />
  </div>
</Layout>
