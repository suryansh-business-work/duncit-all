---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();

// Stickers bobbing around the 404 — decoration, all hidden from screen readers.
const stickers = [
  { icon: 'fa-compass', label: t('website.main.notFound.lost'), place: 'top-[2%] left-[4%] sm:left-[14%] -rotate-12 bg-primary-dark text-white', delay: '0s' },
  { icon: 'fa-map-location-dot', label: t('website.main.notFound.offMap'), place: 'top-[4%] right-[4%] sm:right-[14%] rotate-12 bg-tertiary text-on-accent', delay: '-1.5s' },
  { icon: 'fa-ghost', label: t('website.main.notFound.spookyEmpty'), place: 'hidden sm:inline-flex top-[22%] right-[3%] -rotate-6 bg-ink text-cream', delay: '-3s' },
  { icon: 'fa-circle-exclamation', label: t('website.main.notFound.pageMissing'), place: 'hidden sm:inline-flex top-[20%] left-[3%] rotate-6 bg-surface text-ink', delay: '-4.5s' },
  { icon: 'fa-bolt', label: t('website.main.notFound.tryAgain'), place: 'bottom-[6%] left-[4%] sm:left-[18%] -rotate-6 bg-secondary text-white', delay: '-2s' },
  { icon: 'fa-heart', label: t('website.main.notFound.weGotYou'), place: 'bottom-[8%] right-[4%] sm:right-[18%] rotate-6 bg-surface text-ink', delay: '-3.5s' },
];

const links = [
  { href: '/', icon: 'fa-house', tint: 'bg-primary-dark text-white', title: t('website.main.nav.home'), text: t('website.main.notFound.homeText') },
  { href: '/about', icon: 'fa-circle-info', tint: 'bg-secondary text-white', title: t('website.main.nav.aboutUs'), text: t('website.main.notFound.aboutText') },
  { href: '/community', icon: 'fa-people-group', tint: 'bg-tertiary text-on-accent', title: t('website.main.nav.community'), text: t('website.main.notFound.communityText') },
  { href: '/help', icon: 'fa-life-ring', tint: 'bg-secondary text-white', title: t('website.main.nav.helpCenter'), text: t('website.main.notFound.helpText') },
  { href: '/contact', icon: 'fa-envelope', tint: 'bg-primary-dark text-white', title: t('website.main.nav.contact'), text: t('website.main.notFound.contactText') },
  { href: '/#download', icon: 'fa-rocket', tint: 'bg-tertiary text-on-accent', title: t('website.main.notFound.getAppTitle'), text: t('website.main.notFound.getAppText') },
];
const button = 'inline-flex h-14 items-center gap-2.5 rounded-full px-7 font-head font-bold transition duration-300 ease-soft hover:-translate-y-0.5';
---

<Layout title={t('website.main.notFound.title')} noindex>
  <SiteNav />
  <div class="bg-frame p-2 sm:p-3">
    <TopBar />
    <main>
      <section class="relative isolate overflow-hidden rounded-panel bg-cream px-5 pt-28 pb-16 sm:px-10 sm:pt-32">
        <div class="absolute inset-0 -z-10" aria-hidden="true">
          <div class="absolute -top-24 -left-24 h-80 w-80 rounded-full bg-primary/30 blur-3xl motion-safe:animate-drift"></div>
          <div class="absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-secondary/30 blur-3xl motion-safe:animate-drift [animation-delay:-6s]"></div>
          <div class="absolute top-1/3 right-1/4 h-40 w-40 rounded-full bg-tertiary/40 blur-2xl motion-safe:animate-drift [animation-delay:-12s]"></div>
        </div>

        <div class="relative flex flex-col items-center justify-center pt-6">
          {
            stickers.map((sticker) => (
              <span class={`absolute ${sticker.place} z-10`} aria-hidden="true">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-head text-sm font-extrabold shadow-soft motion-safe:animate-bob"
                  style={`animation-delay:${sticker.delay}`}
                >
                  <i class={`fa-solid ${sticker.icon}`} /> {sticker.label}
                </span>
              </span>
            ))
          }

          <div class="relative mx-auto w-full max-w-md" aria-hidden="true">
            <dotlottie-wc
              src="https://lottie.host/4db68bbb-08fb-4b58-9a30-f5c0d62ed28a/0pJv9MvgGP.lottie"
              style="width: 100%; height: 300px;"
              autoplay
              loop
            ></dotlottie-wc>
          </div>

          <h1 data-reveal="scale" class="headline relative z-10 text-[7rem] leading-none text-primary-ink sm:text-[9rem] md:text-[11rem]">
            4<span class="inline-block motion-safe:animate-spin motion-safe:[animation-duration:4s]">0</span>4
          </h1>

          <p data-reveal class="mt-6 max-w-md text-center text-base text-ink-soft sm:text-lg">{t('website.main.notFound.text')}</p>

          <div data-reveal class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
            <a href="/" class={`${button} bg-ink text-cream`}>
              <i class="fa-solid fa-house" aria-hidden="true"></i> {t('website.main.notFound.takeMeHome')}
            </a>
            <a href="/help" class={`${button} bg-primary-dark text-white`}>
              <i class="fa-solid fa-life-ring" aria-hidden="true"></i> {t('website.main.notFound.getHelp')}
            </a>
          </div>
        </div>
      </section>

      <section class="mt-3 rounded-panel bg-cream px-5 py-16 sm:px-10 lg:py-24">
        <div class="mx-auto max-w-6xl">
          <SectionHead kicker={t('website.main.notFound.tryOneOfThese')}>
            {t('website.main.notFound.whereHeadingLead')} <span class="text-primary-ink">{t('website.main.notFound.whereHeadingAccent')}</span>
          </SectionHead>

          <ul data-reveal-group class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              links.map((link) => (
                <li data-reveal>
                  <a
                    href={link.href}
                    class="group flex h-full items-center gap-4 rounded-card border border-line bg-surface p-5 transition duration-500 ease-soft hover:-translate-y-1 hover:shadow-lift"
                  >
                    <span class={`inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl ${link.tint}`} aria-hidden="true">
                      <i class={`fa-solid ${link.icon}`} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-head text-lg font-extrabold text-ink">{link.title}</span>
                      <span class="block text-sm text-ink-soft">{link.text}</span>
                    </span>
                    <i class="fa-solid fa-arrow-right text-ink-soft transition duration-500 ease-soft group-hover:-rotate-45 group-hover:text-ink" aria-hidden="true"></i>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<!-- Lottie web component -->
<script is:inline src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.6.2/dist/dotlottie-wc.js" type="module"></script>
