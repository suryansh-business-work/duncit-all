---
import PageLayout from '../layouts/PageLayout.astro';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();
---

<PageLayout
  title={t('website.main.about.title')}
  eyebrow={t('website.main.about.eyebrow')}
  heading={t('website.main.about.heading')}
  intro={t('website.main.about.intro')}
  heroImage="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.about.whyHeading')}</h2>
  <p>{t('website.main.about.whyText')}</p>

  <h2>{t('website.main.about.believeHeading')}</h2>
  <ul>
    <li><strong>{t('website.main.about.believe1Label')}</strong> {t('website.main.about.believe1Text')}</li>
    <li><strong>{t('website.main.about.believe2Label')}</strong> {t('website.main.about.believe2Text')}</li>
    <li><strong>{t('website.main.about.believe3Label')}</strong> {t('website.main.about.believe3Text')}</li>
    <li><strong>{t('website.main.about.believe4Label')}</strong> {t('website.main.about.believe4Text')}</li>
  </ul>

  <h2>{t('website.main.about.goingHeading')}</h2>
  <p>
    {t('website.main.about.goingText')}
    <a href="/#download">{t('website.main.about.goingLink')}</a>.
  </p>

  <h2>{t('website.main.about.teamHeading')}</h2>
  <p>{t('website.main.about.teamText')}</p>
</PageLayout>
