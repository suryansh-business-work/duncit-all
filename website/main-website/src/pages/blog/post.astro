---
// Blog detail (?slug=…) — fully dynamic from the Website portal's blog
// content: the post body plus Suggested (same category), Related (latest
// others) and a month-by-month Archive. New posts appear without a redeploy.
// The fetch and rendering live in scripts/blog-post.ts; it retitles the hero
// through `data-page-heading`, and the page server (server/page-meta.ts) gives
// crawlers the post's own card.
import PageLayout from '../../layouts/PageLayout.astro';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();

const copy = {
  notFound: t('website.main.blogPost.notFound'),
  error: t('website.main.blogPost.error'),
  noSuggested: t('website.main.blogPost.noSuggested'),
  noRelated: t('website.main.blogPost.noRelated'),
  noArchive: t('website.main.blogPost.noArchive'),
  titleSuffix: t('website.main.blogPost.eyebrow'),
};
const asides = [
  { id: 'suggestedPosts', icon: 'fa-wand-magic-sparkles', title: t('website.main.blogPost.suggested'), skeleton: 'h-16' },
  { id: 'relatedPosts', icon: 'fa-layer-group', title: t('website.main.blogPost.related'), skeleton: 'h-16' },
  { id: 'postArchive', icon: 'fa-box-archive', title: t('website.main.blogPost.archive'), skeleton: 'h-10' },
];
---

<PageLayout
  title={t('website.main.blogPost.title')}
  eyebrow={t('website.main.blogPost.eyebrow')}
  heading={t('website.main.blogPost.story')}
  intro={t('website.main.blogPost.intro')}
  heroImage="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1600&q=80&auto=format&fit=crop"
  wide
>
  <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <article id="postBody" class="min-w-0" data-copy={JSON.stringify(copy)}>
      <div class="not-prose space-y-3" aria-hidden="true">
        <div class="skeleton h-72 rounded-card"></div>
        <div class="skeleton h-8 w-2/3"></div>
        <div class="skeleton h-4"></div>
        <div class="skeleton h-4"></div>
        <div class="skeleton h-4 w-5/6"></div>
      </div>
    </article>

    <aside class="not-prose grid gap-5 lg:sticky lg:top-28">
      {
        asides.map((block) => (
          <section data-reveal class="rounded-card border border-line bg-surface p-5 shadow-soft">
            <h2 class="mb-4 flex items-center gap-2.5 font-head text-base font-extrabold tracking-tight text-ink">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-primary-light text-sm text-primary-ink" aria-hidden="true">
                <i class={`fa-solid ${block.icon}`} />
              </span>
              {block.title}
            </h2>
            <div id={block.id} class="grid gap-2">
              <div class={`skeleton ${block.skeleton}`} aria-hidden="true" />
              <div class={`skeleton ${block.skeleton}`} aria-hidden="true" />
            </div>
          </section>
        ))
      }
      <a
        href="/blog"
        class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-ink px-6 font-head text-sm font-bold text-cream transition duration-300 ease-soft hover:-translate-y-0.5 hover:bg-primary-dark hover:text-white"
      >
        <i class="fa-solid fa-arrow-left transition duration-300 ease-soft group-hover:-translate-x-0.5" aria-hidden="true"></i>
        {t('website.main.blogPost.allPosts')}
      </a>
    </aside>
  </div>
</PageLayout>

<script>
  import { urlConfigs } from '../../config/url-configs';
  import { loadBlogPost } from '../../scripts/blog-post';

  loadBlogPost(urlConfigs.graphqlUrl).catch((error: unknown) => console.error('blog post crashed', error));
</script>
