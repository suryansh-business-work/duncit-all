---
// Careers — open roles come live from the Website portal (CAREERS content)
// and applications land in its Job Applications inbox.
import PageLayout from '../layouts/PageLayout.astro';
import WebsiteContentList from '../components/WebsiteContentList.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();

const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
---

<PageLayout
  title={t('website.main.careers.title')}
  eyebrow={t('website.main.careers.eyebrow')}
  heading={t('website.main.careers.heading')}
  intro={t('website.main.careers.intro')}
  accent="tertiary"
  heroImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.careers.whyHeading')}</h2>
  <ul>
    <li><strong>{t('website.main.careers.why1Label')}</strong> {t('website.main.careers.why1Text')}</li>
    <li><strong>{t('website.main.careers.why2Label')}</strong> {t('website.main.careers.why2Text')}</li>
    <li><strong>{t('website.main.careers.why3Label')}</strong> {t('website.main.careers.why3Text')}</li>
  </ul>

  <h2>{t('website.main.careers.openHeading')}</h2>
  <WebsiteContentList type="CAREERS" variant="jobs" />

  <h2>{t('website.main.careers.noRoleHeading')}</h2>
  <p>
    {t('website.main.careers.noRoleText')}
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a> {t('website.main.careers.noRoleTextAfter')}
  </p>
</PageLayout>
