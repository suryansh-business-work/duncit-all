---
// Contact — reach-us cards come from Admin branding (support email/phone) and
// the form lands in the Website portal's Contact Submissions inbox.
import { captchaCopy } from '@duncit/i18n';
import Captcha from '@duncit/captcha/Captcha.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
const supportPhone = branding.support_phone;
---

<PageLayout
  title={t('website.main.contact.title')}
  eyebrow={t('website.main.contact.eyebrow')}
  heading={t('website.main.contact.heading')}
  intro={t('website.main.contact.intro')}
  accent="secondary"
  heroImage="https://images.unsplash.com/photo-1573497019418-b400bb3ab074?w=1600&q=80&auto=format&fit=crop"
>
  <div class="not-prose grid sm:grid-cols-2 gap-4 my-6">
    <a href={`mailto:${supportEmail}`} class="block p-5 rounded-2xl glass hover:-translate-y-0.5 transition text-center">
      <i class="fa-solid fa-envelope text-2xl text-primary mb-2" aria-hidden="true"></i>
      <div class="font-head font-bold text-ink">{t('website.main.contact.emailUs')}</div>
      <div class="text-sm text-ink-soft mt-1">{supportEmail}</div>
    </a>
    {supportPhone ? (
      <a href={`tel:${supportPhone}`} class="block p-5 rounded-2xl glass hover:-translate-y-0.5 transition text-center">
        <i class="fa-solid fa-phone text-2xl text-secondary mb-2" aria-hidden="true"></i>
        <div class="font-head font-bold text-ink">{t('website.main.contact.callUs')}</div>
        <div class="text-sm text-ink-soft mt-1">{supportPhone}</div>
      </a>
    ) : (
      <a href="/help" class="block p-5 rounded-2xl glass hover:-translate-y-0.5 transition text-center">
        <i class="fa-solid fa-life-ring text-2xl text-tertiary-dark mb-2" aria-hidden="true"></i>
        <div class="font-head font-bold text-ink">{t('website.main.contact.helpCenter')}</div>
        <div class="text-sm text-ink-soft mt-1">{t('website.main.contact.helpCenterText')}</div>
      </a>
    )}
  </div>

  <h2>{t('website.main.contact.formHeading')}</h2>
  <form
    class="not-prose grid gap-4 max-w-xl mt-4"
    id="contactForm"
    data-cms-widget="contact-form"
    data-graphql-url={urlConfigs.graphqlUrl}
    data-copy={JSON.stringify({
      sending: t('website.main.contact.sending'),
      sent: t('website.main.contact.sent'),
      send: t('website.main.contact.send'),
      failed: t('website.main.contact.failed'),
      failedRetry: t('website.main.contact.failedRetry'),
    })}
  >
    <input name="name" required placeholder={t('website.main.contact.namePlaceholder')} class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none" />
    <input name="email" required type="email" placeholder={t('website.main.contact.emailPlaceholder')} class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none" />
    <input name="subject" placeholder={t('website.main.contact.subjectPlaceholder')} class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none" />
    <textarea name="message" required rows="5" placeholder={t('website.main.contact.messagePlaceholder')} class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none resize-y"></textarea>
    <Captcha graphqlUrl={urlConfigs.graphqlUrl} copy={captchaCopy(t)} />
    <p id="contactErr" data-form-error class="text-sm text-red-600 hidden"></p>
    <button class="px-6 py-3.5 rounded-xl bg-ink text-cream font-bold sticker hover:-translate-y-0.5 transition inline-flex items-center justify-center gap-2 self-start">
      {t('website.main.contact.send')} <i class="fa-solid fa-paper-plane"></i>
    </button>
  </form>
</PageLayout>

<!-- The copy reaches the script through the form's own data attribute, NOT
     `define:vars`: that directive makes a script `is:inline`, and an inline
     script cannot import — this one needs @duncit/captcha. -->
<script>
  import { mount } from '@duncit/brand/widgets/contact-form';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="contact-form"]')) mount(root);
</script>
