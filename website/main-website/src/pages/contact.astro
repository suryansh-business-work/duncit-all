---
// Contact: reach-us cards come from Admin branding (support email/phone) and
// the form lands in the Website portal's Contact Submissions inbox.
import { captchaCopy } from '@duncit/i18n';
import Captcha from '@duncit/captcha/Captcha.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Block from '../components/page/Block.astro';
import IconCard, { type CardTone } from '../components/page/IconCard.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';
import '../styles/widgets.css';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
const supportPhone = branding.support_phone;

const channels: { icon: string; tone: CardTone; href: string; title: string; text: string }[] = [
  { icon: 'fa-envelope', tone: 'primary', href: `mailto:${supportEmail}`, title: t('website.main.contact.emailUs'), text: supportEmail },
  supportPhone
    ? { icon: 'fa-phone', tone: 'secondary', href: `tel:${supportPhone}`, title: t('website.main.contact.callUs'), text: supportPhone }
    : { icon: 'fa-life-ring', tone: 'secondary', href: '/help', title: t('website.main.contact.helpCenter'), text: t('website.main.contact.helpCenterText') },
  { icon: 'fa-circle-question', tone: 'tertiary', href: '/faq', title: t('website.main.nav.faq'), text: t('website.main.faq.intro') },
];

const fields = [
  { name: 'name', type: 'text', required: true, autocomplete: 'name', label: t('website.main.contact.namePlaceholder') },
  { name: 'email', type: 'email', required: true, autocomplete: 'email', label: t('website.main.contact.emailPlaceholder') },
] as const;
---

<PageLayout
  title={t('website.main.contact.title')}
  eyebrow={t('website.main.contact.eyebrow')}
  heading={t('website.main.contact.heading')}
  intro={t('website.main.contact.intro')}
  accent="secondary"
  heroImage="https://images.unsplash.com/photo-1573497019418-b400bb3ab074?w=1600&q=80&auto=format&fit=crop"
  wide
>
  <div class="grid items-start gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
    <Block kicker={t('website.main.contact.reachKicker')} title={t('website.main.contact.reachHeading')}>
      <ul data-reveal-group class="grid gap-4">
        {channels.map((channel) => <IconCard icon={channel.icon} tone={channel.tone} href={channel.href} title={channel.title} text={channel.text} />)}
      </ul>
    </Block>

    <Block kicker={t('website.main.contact.formKicker')} title={t('website.main.contact.formHeading')} class="mt-0!">
      <form
        data-reveal
        class="grid gap-5 rounded-panel border border-line bg-surface p-6 shadow-soft sm:p-10"
        id="contactForm"
        data-cms-widget="contact-form"
        data-graphql-url={urlConfigs.graphqlUrl}
        data-copy={JSON.stringify({
          sending: t('website.main.contact.sending'),
          sent: t('website.main.contact.sent'),
          send: t('website.main.contact.send'),
          failed: t('website.main.contact.failed'),
          failedRetry: t('website.main.contact.failedRetry'),
        })}
      >
        <div class="grid gap-5 sm:grid-cols-2">
          {
            fields.map((field) => (
              <label class="form-label">
                {field.label}
                <input name={field.name} type={field.type} required={field.required} autocomplete={field.autocomplete} class="form-field" />
              </label>
            ))
          }
        </div>
        <label class="form-label">
          {t('website.main.contact.subjectPlaceholder')}
          <input name="subject" type="text" class="form-field" />
        </label>
        <label class="form-label">
          {t('website.main.contact.messagePlaceholder')}
          <textarea name="message" required rows="5" class="form-field"></textarea>
        </label>
        <Captcha graphqlUrl={urlConfigs.graphqlUrl} copy={captchaCopy(t)} />
        <p id="contactErr" data-form-error class="form-error hidden" role="alert"></p>
        <button class="form-submit justify-self-start">
          {t('website.main.contact.send')} <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </button>
      </form>
    </Block>
  </div>
</PageLayout>

<!-- The copy reaches the script through the form's own data attribute, NOT
     `define:vars`: that directive makes a script `is:inline`, and an inline
     script cannot import. This one needs @duncit/captcha. -->
<script>
  import { mount } from '@duncit/brand/widgets/contact-form';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="contact-form"]')) mount(root);
</script>
