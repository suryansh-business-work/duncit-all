---
// FAQs load client-side from the Support portal so new answers appear
// without a redeploy; the support email comes from Admin branding.
import { captchaCopy } from '@duncit/i18n';
import Captcha from '@duncit/captcha/Captcha.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
---

<PageLayout
  title={t('website.main.faq.title')}
  eyebrow={t('website.main.faq.eyebrow')}
  heading={t('website.main.faq.heading')}
  intro={t('website.main.faq.intro')}
  accent="tertiary"
  heroImage="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1600&q=80&auto=format&fit=crop"
>
  <div id="faqGroups" data-cms-widget="faq" data-graphql-url={urlConfigs.graphqlUrl} data-copy={JSON.stringify({ empty: t('website.main.faq.empty'), error: t('website.main.faq.error') })} class="not-prose my-6 space-y-3">
    <div class="skeleton h-8 w-48" aria-hidden="true"></div>
    <div class="skeleton h-20" aria-hidden="true"></div>
    <div class="skeleton h-20" aria-hidden="true"></div>
    <div class="skeleton h-20" aria-hidden="true"></div>
  </div>

  <h2>{t('website.main.faq.askHeading')}</h2>
  <p>{t('website.main.faq.askText')}</p>
  <form
    class="not-prose grid gap-3 max-w-xl mt-4"
    id="askFaqForm"
    data-cms-widget="faq"
    data-graphql-url={urlConfigs.graphqlUrl}
    data-copy={JSON.stringify({
      ask: t('website.main.faq.ask'),
      sending: t('website.main.faq.sending'),
      gotIt: t('website.main.faq.gotIt'),
      tooShort: t('website.main.faq.tooShort'),
      needEmail: t('website.main.faq.needEmail'),
      failed: t('website.main.faq.failed'),
      failedRetry: t('website.main.faq.failedRetry'),
    })}
  >
    <textarea
      name="question"
      required
      rows="3"
      placeholder={t('website.main.faq.questionPlaceholder')}
      class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none resize-y"
    ></textarea>
    <input
      name="email"
      type="email"
      required
      placeholder={t('website.main.faq.emailPlaceholder')}
      class="px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none"
    />
    <Captcha graphqlUrl={urlConfigs.graphqlUrl} copy={captchaCopy(t)} />
    <p id="askFaqErr" data-form-error class="text-sm text-red-600 hidden"></p>
    <button class="px-6 py-3 rounded-xl bg-ink text-cream font-bold sticker hover:-translate-y-0.5 transition inline-flex items-center justify-center gap-2 self-start">
      {t('website.main.faq.ask')} <i class="fa-solid fa-paper-plane"></i>
    </button>
  </form>
  <p class="mt-4">{t('website.main.faq.orEmail')} <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.</p>
</PageLayout>

<script>
  import { mount } from '@duncit/brand/widgets/faq';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="faq"]')) mount(root);
</script>
