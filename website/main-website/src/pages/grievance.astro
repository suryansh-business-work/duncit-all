---
// Raise a grievance (the open door).
//
// The apps carry the same form, but a person with a grievance about Duncit may
// well have already deleted their account, so this page asks for no login at
// all. The officer block and the escalation ladder (GrievanceLadder) come
// first; the Legal portal fills the officer in and this page reads it at
// build time.
import { captchaCopy, grievanceTicketFieldCopy } from '@duncit/i18n';
import Captcha from '@duncit/captcha/Captcha.astro';
import PageLayout from '../layouts/PageLayout.astro';
import GrievanceLadder from '../components/page/GrievanceLadder.astro';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';
import '../styles/widgets.css';

const { t } = await getTranslator();

const fields = [
  { name: 'name', label: t('grievance.field.name'), type: 'text', required: true, autocomplete: 'name' },
  { name: 'email', label: t('grievance.field.email'), type: 'email', required: true, autocomplete: 'email' },
  { name: 'phone', label: t('grievance.field.phone'), type: 'tel', required: true, autocomplete: 'tel' },
  { name: 'address', label: t('grievance.field.address'), type: 'text', required: false, autocomplete: 'street-address' },
  { name: 'subject', label: t('grievance.field.subject'), type: 'text', required: true, autocomplete: 'off' },
] as const;

const optionalSuffix = ` (${t('grievance.optional')})`;
// The website has nobody signed in, so it cannot offer a dropdown of the
// visitor's own tickets the way mWeb and the app do. It asks for the number
// instead, and requires it, because a grievance with nothing behind it is rejected.
const ticketField = grievanceTicketFieldCopy(t);
---

<PageLayout
  title={t('grievance.title')}
  eyebrow={t('website.main.grievance.eyebrow')}
  heading={t('grievance.title')}
  intro={t('grievance.subtitle')}
  accent="secondary"
  wide
>
  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10">
    <GrievanceLadder />

    <section class="not-prose rounded-panel border border-line bg-surface p-6 shadow-soft sm:p-10" aria-labelledby="grievanceFormHeading">
      <span class="kicker">{t('website.main.grievance.formKicker')}</span>
      <h2 id="grievanceFormHeading" class="headline mt-3 mb-8 text-[2rem] text-ink sm:text-4xl">{t('website.main.grievance.formHeading')}</h2>
      {/* The copy travels on the element, not through `define:vars`: that
          directive makes the script inline, which would ship the imports below
          verbatim and leave the form dead in the browser. */}
      <form
        class="grid gap-5"
        id="grievanceForm"
        data-cms-widget="grievance-form"
        data-graphql-url={urlConfigs.graphqlUrl}
        data-source="WEBSITE"
        data-failed={t('grievance.failed')}
        data-sending={t('grievance.submitting')}
      >
        {/* First, and required: it is the gate the rest of the form stands
            behind, and somebody who has not been to support should find that
            out before writing five paragraphs. */}
        <label class="form-label">
          {ticketField.label}
          <input
            name="support_ticket_ref"
            type="text"
            required
            maxlength="60"
            placeholder={ticketField.refPlaceholder}
            aria-describedby="grievanceTicketHint"
            class="form-field"
          />
          <span id="grievanceTicketHint" class="form-hint">{ticketField.refHint}</span>
        </label>
        <div class="grid gap-5 sm:grid-cols-2">
          {
            fields.map((field) => (
              <label class:list={['form-label', field.name === 'subject' && 'sm:col-span-2']}>
                <span>
                  {field.label}
                  {field.required ? '' : optionalSuffix}
                </span>
                <input name={field.name} type={field.type} required={field.required} autocomplete={field.autocomplete} class="form-field" />
              </label>
            ))
          }
        </div>
        <label class="form-label">
          {t('grievance.field.description')}
          <textarea name="description" required rows="5" class="form-field" placeholder={t('grievance.descriptionHint')}></textarea>
        </label>
        <Captcha graphqlUrl={urlConfigs.graphqlUrl} copy={captchaCopy(t)} />
        <p id="grievanceErr" data-form-error class="form-error hidden" role="alert"></p>
        <button class="form-submit justify-self-start">
          {t('grievance.submit')} <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </button>
      </form>

      <div id="grievanceDone" data-grievance-done class="hidden rounded-card bg-lilac p-6 text-center sm:p-8" role="status">
        <span class="mx-auto inline-flex h-14 w-14 -rotate-6 items-center justify-center rounded-2xl bg-tertiary text-2xl text-on-accent" aria-hidden="true">
          <i class="fa-solid fa-circle-check"></i>
        </span>
        <div class="mt-4 font-head text-2xl font-extrabold text-ink">{t('grievance.successTitle')}</div>
        <p class="mt-2 text-ink-soft">{t('grievance.successBody')}</p>
        <div class="mt-5 text-sm font-bold tracking-wide text-ink-soft uppercase">{t('grievance.referenceLabel')}</div>
        <div class="mt-1 font-mono text-3xl font-bold break-all text-primary-ink" id="grievanceRef" data-grievance-ref></div>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  import { mount } from '@duncit/brand/widgets/grievance-form';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="grievance-form"]')) mount(root);
</script>
