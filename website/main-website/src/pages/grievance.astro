---
// Raise a grievance — the open door.
//
// The apps carry the same form, but a person with a grievance about Duncit may
// well have already deleted their account, so this page asks for no login at
// all. The officer block above the form is what we are required to publish;
// the Legal portal fills it in and this page reads it at build time.
import { captchaCopy, grievanceEscalationCopy, grievanceTicketFieldCopy } from '@duncit/i18n';
import Captcha from '@duncit/captcha/Captcha.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { fetchGrievanceOfficer } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';
import { urlConfigs } from '../config/url-configs';

const { t } = await getTranslator();
const officer = await fetchGrievanceOfficer();

const officerRows = officer
  ? [
      [t('grievance.officerName'), officer.name],
      [t('grievance.officerEmail'), officer.email],
      [t('grievance.officerPhone'), officer.phone],
      [t('grievance.officerAddress'), officer.address],
    ].filter(([, value]) => value)
  : [];

const fields = [
  { name: 'name', label: t('grievance.field.name'), type: 'text', required: true },
  { name: 'email', label: t('grievance.field.email'), type: 'email', required: true },
  { name: 'phone', label: t('grievance.field.phone'), type: 'tel', required: true },
  { name: 'address', label: t('grievance.field.address'), type: 'text', required: false },
  { name: 'subject', label: t('grievance.field.subject'), type: 'text', required: true },
];

const optionalSuffix = ` (${t('grievance.optional')})`;
const inputClass =
  'w-full px-4 py-3 rounded-xl bg-surface border-2 border-ink/10 focus:border-primary outline-none';

// Support first, grievance after. The same three steps and the same warning the
// two apps render, resolved from the shared builder rather than written again
// here — this is the sentence a rejected grievance is measured against, and a
// visitor told one thing on the website and another in the app has a fair
// argument that they were misled.
const escalation = grievanceEscalationCopy(t);
// The website has nobody signed in, so it cannot offer a dropdown of the
// visitor's own tickets the way mWeb and the app do. It asks for the number
// instead — required, because a grievance with nothing behind it is rejected.
const ticketField = grievanceTicketFieldCopy(t);
---

<PageLayout
  title={t('grievance.title')}
  eyebrow="Grievance redressal"
  heading={t('grievance.title')}
  intro={t('grievance.subtitle')}
  accent="secondary"
>
  <section class="not-prose my-6">
    <h2 class="font-head font-bold text-ink text-xl mb-3">{t('grievance.officerTitle')}</h2>
    {officerRows.length === 0 ? (
      <p class="text-ink-soft">{t('grievance.officerEmpty')}</p>
    ) : (
      <dl class="grid sm:grid-cols-2 gap-3 p-5 rounded-2xl glass">
        {officerRows.map(([label, value]) => (
          <div>
            <dt class="text-sm text-ink-soft">{label}</dt>
            <dd class="font-bold text-ink break-words">{value}</dd>
          </div>
        ))}
      </dl>
    )}
  </section>

  {/* The escalation ladder, before the form rather than beside it: a visitor
      who reads it after typing has already wasted the effort. Hidden together
      with the form once a grievance lands. */}
  <section class="not-prose my-8" id="grievanceLadder" data-grievance-ladder>
    <h2 class="font-head font-bold text-ink text-xl mb-3">{escalation.title}</h2>
    <ol class="grid gap-4 p-5 rounded-2xl glass">
      {escalation.steps.map((step, index) => (
        <li class="flex gap-3">
          <span
            class="shrink-0 grid place-items-center w-7 h-7 rounded-full bg-ink text-cream font-bold text-sm"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <span class="grid gap-0.5">
            <span class="font-bold text-ink">{step.title}</span>
            <span class="text-sm text-ink-soft">{step.body}</span>
          </span>
        </li>
      ))}
    </ol>
    <p
      class="mt-4 p-4 rounded-2xl border-2 border-amber-500/40 bg-amber-500/10 text-sm text-ink font-bold"
      role="note"
    >
      {escalation.warning}
    </p>
  </section>

  <h2>{t('grievance.title')}</h2>
  {/* The copy travels on the element, not through `define:vars`: that directive
      makes the script inline, which would ship the imports below verbatim and
      leave the form dead in the browser. */}
  <form
    class="not-prose grid gap-4 max-w-xl mt-4"
    id="grievanceForm"
    data-cms-widget="grievance-form"
    data-graphql-url={urlConfigs.graphqlUrl}
    data-source="WEBSITE"
    data-failed={t('grievance.failed')}
    data-sending={t('grievance.submitting')}
  >
    {/* First, and required: it is the gate the rest of the form stands behind,
        and somebody who has not been to support should find that out before
        writing five paragraphs. The one field the two apps render as a dropdown
        instead — nobody is signed in here, so there is no history to pick from. */}
    <label class="grid gap-1.5">
      <span class="text-sm text-ink-soft">{ticketField.label}</span>
      <input
        name="support_ticket_ref"
        type="text"
        required
        maxlength="60"
        placeholder={ticketField.refPlaceholder}
        aria-describedby="grievanceTicketHint"
        class={inputClass}
      />
      <span id="grievanceTicketHint" class="text-xs text-ink-soft">{ticketField.refHint}</span>
    </label>
    {fields.map((field) => (
      <label class="grid gap-1.5">
        <span class="text-sm text-ink-soft">
          {field.label}{field.required ? '' : optionalSuffix}
        </span>
        <input
          name={field.name}
          type={field.type}
          required={field.required}
          class={inputClass}
        />
      </label>
    ))}
    <label class="grid gap-1.5">
      <span class="text-sm text-ink-soft">{t('grievance.field.description')}</span>
      <textarea
        name="description"
        required
        rows="5"
        class={`${inputClass} resize-y`}
        placeholder={t('grievance.descriptionHint')}></textarea>
    </label>
    <Captcha graphqlUrl={urlConfigs.graphqlUrl} copy={captchaCopy(t)} />
    <p id="grievanceErr" data-form-error class="text-sm text-red-600 hidden"></p>
    <button
      class="px-6 py-3.5 rounded-xl bg-ink text-cream font-bold sticker hover:-translate-y-0.5 transition inline-flex items-center justify-center gap-2 self-start"
    >
      {t('grievance.submit')} <i class="fa-solid fa-paper-plane"></i>
    </button>
  </form>

  <div id="grievanceDone" data-grievance-done class="not-prose hidden mt-4 p-5 rounded-2xl glass">
    <div class="font-head font-bold text-ink text-lg">{t('grievance.successTitle')}</div>
    <p class="text-ink-soft mt-1">{t('grievance.successBody')}</p>
    <div class="mt-3 text-sm text-ink-soft">{t('grievance.referenceLabel')}</div>
    <div class="font-mono font-bold text-2xl text-primary" id="grievanceRef" data-grievance-ref></div>
  </div>
</PageLayout>

<script>
  import { mount } from '@duncit/brand/widgets/grievance-form';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cms-widget="grievance-form"]')) mount(root);
</script>
