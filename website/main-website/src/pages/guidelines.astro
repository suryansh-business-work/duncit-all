---
import PageLayout from '../layouts/PageLayout.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
---

<PageLayout
  title={t('website.main.guidelines.title')}
  eyebrow={t('website.main.guidelines.eyebrow')}
  heading={t('website.main.guidelines.heading')}
  intro={t('website.main.guidelines.intro')}
  accent="tertiary"
  heroImage="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.guidelines.rule1Heading')}</h2>
  <p>{t('website.main.guidelines.rule1Text')}</p>

  <h2>{t('website.main.guidelines.rule2Heading')}</h2>
  <p>{t('website.main.guidelines.rule2Text')}</p>

  <h2>{t('website.main.guidelines.rule3Heading')}</h2>
  <p>{t('website.main.guidelines.rule3Text')}</p>

  <h2>{t('website.main.guidelines.rule4Heading')}</h2>
  <p>{t('website.main.guidelines.rule4Text')}</p>

  <h2>{t('website.main.guidelines.rule5Heading')}</h2>
  <p>{t('website.main.guidelines.rule5Text')}</p>

  <h2>{t('website.main.guidelines.rule6Heading')}</h2>
  <p>{t('website.main.guidelines.rule6Text')}</p>

  <h2>{t('website.main.guidelines.wrongHeading')}</h2>
  <p>
    {t('website.main.guidelines.wrongText')}
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
    {t('website.main.guidelines.wrongTextAfter')}
  </p>
</PageLayout>
