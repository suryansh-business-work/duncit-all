---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import DownloadApps from '../components/DownloadApps.astro';
import DuncitNetwork from '../components/DuncitNetwork.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ActivityMarquee from '../components/home/ActivityMarquee.astro';
import RealVibes from '../components/home/RealVibes.astro';
import FlowStrip from '../components/home/FlowStrip.astro';
import EarnShowcase from '@duncit/brand/EarnShowcase.astro';
import ReelSlider from '@duncit/brand/ReelSlider.astro';
import PodRail from '@duncit/brand/PodRail.astro';
import { urlConfigs } from '../config/url-configs';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();
---

<Layout title={t('website.main.home.title')}>
  <SiteNav />
  <div class="bg-frame p-2 sm:p-3">
    <TopBar />
    <main>
      <HomeHero />
      <!-- Upcoming pods, live from the API, right under the banner; each opens on mWeb. -->
      <PodRail graphqlUrl={urlConfigs.graphqlUrl} mwebUrl={urlConfigs.mwebUrl} t={t} />
      <ActivityMarquee />

      <!-- Website portal > Reel Slider. Second on the page, straight after the
           hero. Hidden when there are no reels. -->
      <ReelSlider graphqlUrl={urlConfigs.graphqlUrl} site="MAIN" t={t} />

      <!-- Website portal > Earn with Duncit. Renders here (AFTER_REELS); the
           portal can move it into a slot below. -->
      <EarnShowcase href={urlConfigs.earnwithUrl} graphqlUrl={urlConfigs.graphqlUrl} site="MAIN" t={t} />

      <DownloadApps />
      <div data-earn-slot="AFTER_DOWNLOAD"></div>

      <DuncitNetwork />
      <RealVibes />
      <FlowStrip />

      <div data-earn-slot="BEFORE_FOOTER"></div>
    </main>

    <Footer />
  </div>
</Layout>
