---
import PageLayout from '../layouts/PageLayout.astro';
import WebsiteContentList from '../components/WebsiteContentList.astro';
import { fetchBranding } from '../lib/site-data';
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();

const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
---

<PageLayout
  title={t('website.main.newsroom.title')}
  eyebrow={t('website.main.newsroom.eyebrow')}
  heading={t('website.main.newsroom.heading')}
  intro={t('website.main.newsroom.intro')}
  accent="secondary"
  heroImage="https://images.unsplash.com/photo-1495020689067-958852a7765e?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.newsroom.latest')}</h2>
  <WebsiteContentList type="NEWSROOM" variant="news" />

  <h2>{t('website.main.newsroom.press')}</h2>
  <p>
    {t('website.main.newsroom.pressText')}
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>. {t('website.main.newsroom.pressTextAfter')}
  </p>
</PageLayout>
