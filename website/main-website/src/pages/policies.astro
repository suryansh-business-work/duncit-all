---
// Policy Hub — every active policy from the Legal portal. Fetched in the
// browser so newly published policies appear without a site redeploy.
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Policy Hub"
  eyebrow="Policy Hub"
  heading="Duncit policies"
  intro="Every policy that governs Duncit, published live from our Legal team — always the current version."
  heroImage="https://images.pexels.com/photos/7654588/pexels-photo-7654588.jpeg?auto=compress&cs=tinysrgb&w=1600"
>
  <!-- Thirteen policies is more than anyone scans. The field filters the list
       as you type; it stays hidden until the list has actually loaded, because
       a search box over four skeletons is a control that does nothing. -->
  <div class="not-prose mb-6 hidden" id="policySearchWrap">
    <label class="sr-only" for="policySearch">Search policies</label>
    <div class="relative">
      <i
        class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-ink-soft"
        aria-hidden="true"></i>
      <input
        id="policySearch"
        type="search"
        autocomplete="off"
        placeholder="Search policies…"
        class="w-full rounded-xl border-2 border-ink/10 bg-surface py-3 pl-11 pr-4 text-ink outline-none transition focus:border-primary"
      />
    </div>
    <p class="mt-2 text-sm text-ink-soft" id="policyCount" role="status" aria-live="polite"></p>
  </div>

  <div id="policyList" class="not-prose grid sm:grid-cols-2 gap-4">
    <div class="skeleton h-28" aria-hidden="true"></div>
    <div class="skeleton h-28" aria-hidden="true"></div>
    <div class="skeleton h-28" aria-hidden="true"></div>
    <div class="skeleton h-28" aria-hidden="true"></div>
  </div>
</PageLayout>

<script>
  import { urlConfigs } from '../config/url-configs';

  const target = document.getElementById('policyList');
  const searchWrap = document.getElementById('policySearchWrap');
  const search = document.getElementById('policySearch') as HTMLInputElement | null;
  const count = document.getElementById('policyCount');

  type Policy = { slug: string; title: string };
  let policies: Policy[] = [];

  function esc(value: string) {
    const div = document.createElement('div');
    div.textContent = value ?? '';
    return div.innerHTML;
  }

  function card(policy: Policy) {
    return `
      <a href="/policy/${encodeURIComponent(policy.slug)}"
         class="glass rounded-2xl p-5 flex items-center justify-between gap-3 hover:-translate-y-0.5 transition">
        <span>
          <span class="block font-head font-extrabold text-lg text-ink">${esc(policy.title)}</span>
          <span class="block text-xs text-ink-soft mt-1">Read the current version</span>
        </span>
        <i class="fa-solid fa-arrow-right text-primary" aria-hidden="true"></i>
      </a>`;
  }

  function render(query: string) {
    if (!target) return;
    const needle = query.trim().toLowerCase();
    // The slug is searched as well as the title: someone who arrived with
    // "data deletion" in mind types that, and the policy is called something
    // longer.
    const matches = needle
      ? policies.filter(
          (policy) =>
            policy.title.toLowerCase().includes(needle) ||
            policy.slug.toLowerCase().replaceAll('-', ' ').includes(needle)
        )
      : policies;

    if (count) {
      const noun = matches.length === 1 ? 'policy matches' : 'policies match';
      count.textContent = needle ? `${matches.length} ${noun} “${query.trim()}”` : '';
    }

    target.innerHTML = matches.length
      ? matches.map(card).join('')
      : `<p class="text-ink-soft col-span-full">Nothing matches “${esc(query.trim())}”. <button type="button" data-clear-search class="font-bold text-primary underline">Show all policies</button></p>`;
  }

  async function load() {
    if (!target) return;
    try {
      const res = await fetch(urlConfigs.graphqlUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: 'query { publicPolicies { id slug title } }' }),
      });
      const json = await res.json();
      policies = json?.data?.publicPolicies ?? [];
      if (!policies.length) {
        target.innerHTML =
          '<p class="text-ink-soft col-span-full">No policies are published yet — check back soon.</p>';
        return;
      }
      searchWrap?.classList.remove('hidden');
      render('');
    } catch {
      target.innerHTML =
        '<p class="text-ink-soft col-span-full">Policies could not be loaded right now. Please try again later.</p>';
    }
  }

  search?.addEventListener('input', () => render(search.value));
  // The empty-state's own way out, wired once by delegation because the button
  // is re-created on every render.
  target?.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement)?.closest('[data-clear-search]')) return;
    if (search) search.value = '';
    render('');
    search?.focus();
  });

  load();
</script>
