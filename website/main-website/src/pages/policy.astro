---
// The old address. Policies live at /policy/<slug> now; this stays so that
// every link already printed in an email, a receipt or another site's footer
// still lands on the right page instead of 404ing.
//
// The line below is only ever seen if the inline redirect does not run, but it
// is still a sentence somebody reads, so it comes from the catalogue too.
import { getTranslator } from '../lib/i18n';

const { t } = await getTranslator();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <!-- Tell a crawler this address moved rather than that it has content. -->
    <meta name="robots" content="noindex" />
    <script is:inline>
      (() => {
        const slug = new URLSearchParams(window.location.search).get('slug');
        window.location.replace(slug ? `/policy/${encodeURIComponent(slug)}` : '/policies');
      })();
    </script>
  </head>
  <body>
    <p>{t('website.main.policyRedirect.moved')} <a href="/policies">{t('website.main.policyRedirect.seeAll')}</a>.</p>
  </body>
</html>
