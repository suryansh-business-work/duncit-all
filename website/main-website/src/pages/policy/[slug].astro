---
// One policy, at its own address: /policy/contact-us-support.
//
// A page per published policy is generated at build time from the Legal
// portal's list, so each policy is a real, linkable, indexable URL rather than
// a query string on a single page. The TEXT is still loaded live, so a legal
// edit is on the site immediately without a redeploy — only a brand-new policy
// needs one to get its page.
import PageLayout from '../../layouts/PageLayout.astro';
import { fetchPolicies } from '../../lib/site-data';
import { getTranslator } from '../../lib/i18n';

export async function getStaticPaths() {
  const policies = await fetchPolicies();
  return policies.map((policy) => ({
    params: { slug: policy.slug },
    props: { title: policy.title },
  }));
}

const { t } = await getTranslator();
const { slug } = Astro.params;
const { title } = Astro.props;
---

<PageLayout
  title={title ?? t('website.main.policyDetail.fallbackTitle')}
  eyebrow={t('website.main.policyDetail.eyebrow')}
  heading={title ?? t('website.main.policyDetail.fallbackTitle')}
  intro={t('website.main.policyDetail.intro')}
  heroImage="https://images.pexels.com/photos/7654588/pexels-photo-7654588.jpeg?auto=compress&cs=tinysrgb&w=1600"
>
  <div id="policyBody"
    data-copy={JSON.stringify({ notFound: t('website.main.policyDetail.notFound'), empty: t('website.main.policyDetail.empty'), error: t('website.main.policyDetail.error') })} data-policy-slug={slug}>
    <div class="not-prose space-y-3" aria-hidden="true">
      <div class="skeleton h-8 w-2/3"></div>
      <div class="skeleton h-4"></div>
      <div class="skeleton h-4"></div>
      <div class="skeleton h-4 w-5/6"></div>
      <div class="skeleton h-4 w-4/6"></div>
    </div>
  </div>
  <p class="not-prose mt-8">
    <a href="/policies" class="inline-flex items-center gap-2 font-bold text-primary">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All policies
    </a>
  </p>
</PageLayout>

<script>
  import { urlConfigs } from '../../config/url-configs';

  const body = document.getElementById('policyBody');
  // Handed over by the markup — a module script cannot read Astro frontmatter.
  const COPY = JSON.parse(body?.dataset.copy ?? '{}');
  // The slug comes from the page itself now, not from the query string.
  const slug = body?.dataset.policySlug ?? '';

  async function load() {
    if (!body) return;
    if (!slug) {
      window.location.replace('/policies');
      return;
    }
    try {
      const res = await fetch(urlConfigs.graphqlUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query:
            'query Policy($slug: String!) { policyBySlug(slug: $slug) { title content updated_at } }',
          variables: { slug },
        }),
      });
      const json = await res.json();
      const policy = json?.data?.policyBySlug;
      if (!policy) {
        body.innerHTML = `<p>${COPY.notFound}</p>`;
        return;
      }
      document.title = `${policy.title} — Duncit`;
      const heading = document.querySelector('[data-page-heading]') ?? document.querySelector('h1');
      if (heading) heading.textContent = policy.title;
      // Policy content is trusted HTML authored by our own Legal portal editor.
      body.innerHTML = policy.content || `<p>${COPY.empty}</p>`;
    } catch {
      body.innerHTML = `<p>${COPY.error}</p>`;
    }
  }

  load();
</script>
