---
import PageLayout from '../../layouts/PageLayout.astro';
import { fetchBranding } from '../../lib/site-data';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';
---

<PageLayout
  title={t('website.main.safetyAdvice.title')}
  eyebrow={t('website.main.safetyAdvice.eyebrow')}
  heading={t('website.main.safetyAdvice.heading')}
  intro={t('website.main.safetyAdvice.intro')}
  accent="tertiary"
  heroImage="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.safetyAdvice.beforeHeading')}</h2>
  <ul>
    <li>{t('website.main.safetyAdvice.before1')}</li>
    <li>{t('website.main.safetyAdvice.before2')}</li>
    <li>{t('website.main.safetyAdvice.before3')}</li>
  </ul>

  <h2>{t('website.main.safetyAdvice.meetHeading')}</h2>
  <ul>
    <li>{t('website.main.safetyAdvice.meet1')}</li>
    <li>{t('website.main.safetyAdvice.meet2')}</li>
    <li>{t('website.main.safetyAdvice.meet3')}</li>
    <li>{t('website.main.safetyAdvice.meet4')}</li>
  </ul>

  <h2>{t('website.main.safetyAdvice.flagsHeading')}</h2>
  <ul>
    <li>{t('website.main.safetyAdvice.flag1')}</li>
    <li>{t('website.main.safetyAdvice.flag2')}</li>
    <li>{t('website.main.safetyAdvice.flag3')}</li>
    <li>{t('website.main.safetyAdvice.flag4')}</li>
  </ul>

  <h2>{t('website.main.safetyAdvice.helpHeading')}</h2>
  <p>
    {t('website.main.safetyAdvice.helpText')}
    <a href="/safety/resources">{t('website.main.safetyAdvice.helpLink')}</a>
    {t('website.main.safetyAdvice.helpTextAfter')}
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.
  </p>
</PageLayout>
