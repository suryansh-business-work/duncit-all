---
import PageLayout from '../../layouts/PageLayout.astro';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();
---

<PageLayout
  title={t('website.main.safetyApproach.title')}
  eyebrow={t('website.main.safetyApproach.eyebrow')}
  heading={t('website.main.safetyApproach.heading')}
  intro={t('website.main.safetyApproach.intro')}
  heroImage="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=1600&q=80&auto=format&fit=crop"
>
  <h2>{t('website.main.safetyApproach.principlesHeading')}</h2>
  <ul>
    <li>
      <strong>{t('website.main.safetyApproach.principle1Label')}</strong>
      {t('website.main.safetyApproach.principle1Text')}
    </li>
    <li>
      <strong>{t('website.main.safetyApproach.principle2Label')}</strong>
      {t('website.main.safetyApproach.principle2Text')}
    </li>
    <li>
      <strong>{t('website.main.safetyApproach.principle3Label')}</strong>
      {t('website.main.safetyApproach.principle3Text')}
    </li>
    <li>
      <strong>{t('website.main.safetyApproach.principle4Label')}</strong>
      {t('website.main.safetyApproach.principle4Text')}
    </li>
  </ul>

  <h2>{t('website.main.safetyApproach.howHeading')}</h2>
  <p>{t('website.main.safetyApproach.howText')}</p>

  <h2>{t('website.main.safetyApproach.readHeading')}</h2>
  <ul>
    <li><a href="/safety/advice">{t('website.main.safetyApproach.readAdvice')}</a></li>
    <li><a href="/safety/tools">{t('website.main.safetyApproach.readTools')}</a></li>
    <li><a href="/safety/resources">{t('website.main.safetyApproach.readResources')}</a></li>
  </ul>
</PageLayout>
