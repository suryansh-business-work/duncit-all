---
import PageLayout from '../../layouts/PageLayout.astro';
import { fetchBranding } from '../../lib/site-data';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();
const branding = await fetchBranding();
const supportEmail = branding.support_email || 'support@duncit.com';

// Organisation NAMES stay as they are: they are proper nouns, and a translated
// helpline name is a helpline nobody can search for. The region and the
// instruction beside it are what a reader actually has to understand.
const resources = [
  {
    region: t('website.main.safetyResources.regionUs'),
    name: 'Crisis Text Line',
    contact: t('website.main.safetyResources.crisisTextLineContact'),
  },
  {
    region: t('website.main.safetyResources.regionUs'),
    name: 'National Suicide Prevention Lifeline',
    contact: t('website.main.safetyResources.lifelineContact'),
  },
  {
    region: t('website.main.safetyResources.regionUk'),
    name: 'Samaritans',
    contact: t('website.main.safetyResources.samaritansContact'),
  },
  {
    region: t('website.main.safetyResources.regionEu'),
    name: 'Mental Health Europe Helplines',
    contact: t('website.main.safetyResources.mheContact'),
  },
  {
    region: t('website.main.safetyResources.regionIndia'),
    name: 'iCall',
    contact: t('website.main.safetyResources.icallContact'),
  },
  {
    region: t('website.main.safetyResources.regionWorldwide'),
    name: 'Find A Helpline',
    contact: t('website.main.safetyResources.findAHelplineContact'),
  },
];
---

<PageLayout
  title={t('website.main.safetyResources.title')}
  eyebrow={t('website.main.safetyResources.eyebrow')}
  heading={t('website.main.safetyResources.heading')}
  intro={t('website.main.safetyResources.intro')}
  heroImage="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=1600&q=80&auto=format&fit=crop"
>
  <p>{t('website.main.safetyResources.emergencyText')}</p>

  <h2>{t('website.main.safetyResources.helplinesHeading')}</h2>
  <div class="not-prose space-y-3 my-6">
    {resources.map((resource) => (
      <div class="p-5 rounded-2xl bg-surface sticker flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-secondary/15 text-secondary inline-flex items-center justify-center shrink-0">
          <i class="fa-solid fa-phone-volume"></i>
        </div>
        <div class="flex-1">
          <div class="text-xs uppercase tracking-wider text-ink-soft font-bold">{resource.region}</div>
          <div class="font-head font-bold text-ink">{resource.name}</div>
          <div class="text-sm text-primary font-semibold mt-0.5">{resource.contact}</div>
        </div>
      </div>
    ))}
  </div>

  <h2>{t('website.main.safetyResources.supportHeading')}</h2>
  <p>
    {t('website.main.safetyResources.supportText')}
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.
    {t('website.main.safetyResources.supportTextAfter')}
  </p>
</PageLayout>
