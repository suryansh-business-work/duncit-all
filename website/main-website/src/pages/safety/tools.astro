---
import PageLayout from '../../layouts/PageLayout.astro';
import Block from '../../components/page/Block.astro';
import IconCard from '../../components/page/IconCard.astro';
import Statement from '../../components/page/Statement.astro';
import SafetyNav from '../../components/page/SafetyNav.astro';
import { getTranslator } from '../../lib/i18n';

const { t } = await getTranslator();

const tools = [
  { icon: 'fa-ban', tone: 'primary', title: t('website.main.safetyTools.blockTitle'), text: t('website.main.safetyTools.blockText') },
  { icon: 'fa-volume-xmark', tone: 'secondary', title: t('website.main.safetyTools.muteTitle'), text: t('website.main.safetyTools.muteText') },
  { icon: 'fa-flag', tone: 'tertiary', title: t('website.main.safetyTools.reportTitle'), text: t('website.main.safetyTools.reportText') },
  { icon: 'fa-eye-slash', tone: 'ink', title: t('website.main.safetyTools.hideTitle'), text: t('website.main.safetyTools.hideText') },
  { icon: 'fa-image', tone: 'secondary', title: t('website.main.safetyTools.verifyTitle'), text: t('website.main.safetyTools.verifyText') },
  { icon: 'fa-key', tone: 'primary', title: t('website.main.safetyTools.twoFactorTitle'), text: t('website.main.safetyTools.twoFactorText') },
] as const;
---

<PageLayout
  title={t('website.main.safetyTools.title')}
  eyebrow={t('website.main.safetyTools.eyebrow')}
  heading={t('website.main.safetyTools.heading')}
  intro={t('website.main.safetyTools.intro')}
  accent="secondary"
  heroImage="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=1600&q=80&auto=format&fit=crop"
  wide
>
  <SafetyNav />

  <Block kicker={t('website.main.safetyTools.toolsKicker')} title={t('website.main.safetyTools.toolsHeading')}>
    <ul data-reveal-group class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <IconCard icon={tool.icon} tone={tool.tone} title={tool.title} text={tool.text} />)}
    </ul>
  </Block>

  <Block kicker={t('website.main.safetyTools.reportsKicker')} title={t('website.main.safetyTools.reportsHeading')}>
    <Statement text={t('website.main.safetyTools.reportsText')} icon="fa-clock-rotate-left" />
  </Block>
</PageLayout>
