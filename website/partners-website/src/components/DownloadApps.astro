---
// This site's words on the shared download band. The band, the store buttons,
// the "coming soon" state and the phone live in @duncit/brand — four sites had
// four versions of the same two store listings.
import AppDownload from '@duncit/brand/AppDownload.astro';
import { fetchBranding } from '../lib/site-data';

const branding = await fetchBranding();
const stores = [
  { icon: 'fa-google-play', eyebrow: 'Get it on', name: 'Google Play', url: branding.android_app_url },
  { icon: 'fa-apple', eyebrow: 'Download on the', name: 'App Store', url: branding.ios_app_url },
];
---

<AppDownload
  heading="Your partners,"
  headingAccent="in their pocket"
  text="Members book your venue and join your pods from the Duncit app on Android and iOS."
  perks={['Real bookings', 'Clean operations', 'Duncit\'s trust layer']}
  stores={stores}
/>
