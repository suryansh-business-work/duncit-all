---
// This site's words on the shared download band. The band, the store buttons,
// the "coming soon" state and the phone live in @duncit/brand — four sites had
// four versions of the same two store listings.
import AppDownload from '@duncit/brand/AppDownload.astro';
import { getSiteTranslator } from '@duncit/brand/site-i18n';
import { fetchBranding } from '../lib/site-data';
import { urlConfigs } from '../config/url-configs';

const branding = await fetchBranding();
const { t } = await getSiteTranslator(urlConfigs.graphqlUrl);
const stores = [
  {
    icon: 'fa-google-play',
    eyebrow: t('website.partners.download.googlePlayEyebrow'),
    name: t('website.partners.download.googlePlayName'),
    url: branding.android_app_url,
  },
  {
    icon: 'fa-apple',
    eyebrow: t('website.partners.download.appStoreEyebrow'),
    name: t('website.partners.download.appStoreName'),
    url: branding.ios_app_url,
  },
];
const perks = [
  t('website.partners.download.perkBookings'),
  t('website.partners.download.perkOps'),
  t('website.partners.download.perkTrust'),
];
---

<!-- A rounded panel on the frame like every other section; the wrapper, not
     the band, carries the reveal so the shared component stays untouched. -->
<div data-reveal>
  <AppDownload
    heading={t('website.partners.download.heading')}
    headingAccent={t('website.partners.download.headingAccent')}
    text={t('website.partners.download.text')}
    perks={perks}
    stores={stores}
    webUrl={urlConfigs.mwebUrl}
    graphqlUrl={urlConfigs.graphqlUrl}
    t={t}
    class="mt-3 scroll-mt-24 rounded-[2rem] sm:rounded-[2.75rem]"
  />
</div>
