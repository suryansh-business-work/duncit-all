---
// Footer — links managed from the Website portal (Navigation → PARTNERS) and
// the Policy Hub from the Legal portal; branding assets from Admin.
import { urlConfigs } from '../config/url-configs';
import { fetchBranding, fetchNavGroups, fetchPolicies, type SiteNavGroup } from '../lib/site-data';
import FooterLogo from '@duncit/brand/FooterLogo.astro';
import PolicyStrip from '@duncit/brand/PolicyStrip.astro';
import SocialLinks from '@duncit/brand/SocialLinks.astro';
import SharedNewsletter from '@duncit/brand/NewsletterSignup.astro';
import { getSiteTranslator } from '@duncit/brand/site-i18n';

const { t } = await getSiteTranslator(urlConfigs.graphqlUrl);

const FALLBACK_GROUPS: SiteNavGroup[] = [
  {
    label: t('website.partners.footer.duncitGroup'),
    links: [
      {
        id: 'f-main',
        area: 'FOOTER',
        group_label: t('website.partners.footer.duncitGroup'),
        label: t('website.partners.footer.mainSite'),
        url: urlConfigs.mainSiteUrl,
        sort_order: 0,
      },
      {
        id: 'f-support',
        area: 'FOOTER',
        group_label: t('website.partners.footer.duncitGroup'),
        label: t('website.partners.footer.support'),
        url: `${urlConfigs.mainSiteUrl}/help`,
        sort_order: 1,
      },
    ],
  },
];

const [branding, navGroups, policies] = await Promise.all([
  fetchBranding(),
  fetchNavGroups('FOOTER', FALLBACK_GROUPS),
  fetchPolicies(),
]);
const year = new Date().getFullYear();
---

<footer class="mt-3 rounded-[2rem] bg-cream px-5 py-16 sm:rounded-[2.75rem] sm:px-8 lg:py-20">
  <!-- Brand on the left, the one thing we ask for on the right — the same
       shape as every other Duncit footer. It used to put the newsletter under
       the brand in a narrow column and give a single two-link nav group twice
       that width, so most of the footer was empty. -->
  <div data-reveal class="max-w-6xl mx-auto grid gap-10 items-start lg:grid-cols-[1fr_1.1fr]">
    <div>
      <FooterLogo
        footerSrc={branding.website_footer_logo_url}
        headerSrc={branding.website_header_logo_url}
        name={branding.app_name}
        height={96}
        graphqlUrl={urlConfigs.graphqlUrl}
      />
      <p class="mt-2 font-head text-2xl font-extrabold leading-none tracking-tight text-ink">
        {t('website.partners.brand.footerName')}
      </p>
      <p class="mt-3 text-sm text-ink-soft max-w-xs">{t('website.partners.footer.blurb')}</p>
      <a href={`mailto:${branding.support_email || 'support@duncit.com'}`} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary-ink hover:underline">
        {branding.support_email || 'support@duncit.com'}
      </a>
      <SocialLinks class="mt-5" />
    </div>

    <!-- This site had no way to keep in touch at all. Same form as the others,
         same CRM, tagged with where it came from. -->
    <SharedNewsletter
      graphqlUrl={urlConfigs.graphqlUrl}
      source="PARTNERS_WEBSITE_FOOTER"
      heading={t('website.partners.footer.newsletterHeading')}
      text={t('website.partners.footer.newsletterText')}
      t={t}
    />
  </div>

  <div data-reveal class="max-w-6xl mx-auto mt-10 grid grid-cols-2 gap-8 border-t border-line pt-10 sm:grid-cols-3">
    {navGroups.map((group) => (
      <nav aria-label={group.label}>
        <h3 class="kicker mb-3">{group.label}</h3>
        <ul class="space-y-2">
          {group.links.map((link) => (
            <li>
              <a href={link.url} class="inline-flex min-h-11 items-center text-sm text-ink-soft transition-colors hover:text-ink sm:min-h-0">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <!-- Policies get the full width. Six of thirteen in a narrow column was a
       list that hid the ones nobody thought to ask for. -->
  <PolicyStrip
    policies={policies}
    baseUrl={urlConfigs.mainSiteUrl}
    heading={t('website.partners.footer.policyHub')}
    t={t}
    class="max-w-6xl mx-auto mt-10"
  />

  <div class="max-w-6xl mx-auto mt-10 pt-5 border-t border-line text-xs text-ink-soft text-center">
    {t('website.partners.footer.rights', { vars: { year } })}
  </div>
</footer>
