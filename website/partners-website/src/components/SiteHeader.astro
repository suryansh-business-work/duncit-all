---
// The partner site's top bar: a floating pill that stays with the visitor as
// they scroll. Menu (below lg), the mark, the page's real destinations, the
// light/dark toggle (always visible, phone included) and the one ask.
import BrandLogo from '@duncit/brand/BrandLogo.astro';
import SiteMenu from '@duncit/brand/SiteMenu.astro';
import ThemeToggle from '@duncit/brand/ThemeToggle.astro';
import { fetchBranding } from '../lib/site-data';
import { urlConfigs } from '../config/url-configs';
import { getSiteTranslator } from '@duncit/brand/site-i18n';

const branding = await fetchBranding();
const { t } = await getSiteTranslator(urlConfigs.graphqlUrl);

// Every one of these goes somewhere that exists: the partner paths on this
// page, the two real destinations in the partner app, and the download band.
const links = [
  { label: t('website.partners.nav.how'), href: '/#ways' },
  { label: t('website.partners.nav.listVenue'), href: `${urlConfigs.partnersAppUrl}/register-venue` },
  { label: t('website.partners.nav.becomeHost'), href: `${urlConfigs.partnersAppUrl}/become-host` },
  { label: t('website.partners.nav.getApp'), href: '/#download' },
];
const login = { label: t('website.partners.nav.login'), href: urlConfigs.partnersAppUrl };
const join = {
  label: t('website.partners.nav.join'),
  href: `${urlConfigs.partnersAppUrl}/register-venue`,
};
---

<header class="sticky top-3 z-50 mx-auto max-w-6xl sm:top-4">
  <nav
    aria-label={t('website.partners.nav.mainAria')}
    class="glass flex h-16 items-center justify-between gap-2 rounded-full pl-2 pr-2 sm:pl-3"
  >
    <div class="flex min-w-0 items-center gap-1 sm:gap-2">
      <SiteMenu links={links} actions={[join, login]} t={t} />
      <a
        href={urlConfigs.mainSiteUrl}
        class="inline-flex min-h-11 items-center gap-2 rounded-full px-1 no-underline"
        aria-label={t('website.partners.nav.brandAria')}
      >
        <BrandLogo
          src={branding.website_header_logo_url}
          name={branding.app_name}
          height={36}
          href={null}
          graphqlUrl={urlConfigs.graphqlUrl}
        />
        <span class="hidden font-head text-lg font-extrabold tracking-tight text-ink sm:inline">
          {t('website.partners.brand.word')}
        </span>
      </a>
    </div>

    <div class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <a
            class="rounded-full px-4 py-2.5 text-[0.9375rem] font-semibold text-ink-soft transition-colors hover:bg-lilac hover:text-ink"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <ThemeToggle label={t('website.nav.theme')} />
      <a
        class="hidden min-h-11 items-center gap-2 rounded-full px-3 text-sm font-bold text-ink transition-colors hover:text-primary-ink lg:inline-flex"
        href={login.href}
      >
        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
        {login.label}
      </a>
      <a
        class="group inline-flex h-11 items-center gap-2 whitespace-nowrap rounded-full bg-primary-dark px-4 font-head text-sm font-bold text-on-primary shadow-lg shadow-primary/30 transition-transform duration-300 ease-soft hover:-translate-y-0.5 sm:h-12 sm:px-5"
        href={join.href}
      >
        {join.label}
        <i
          class="fa-solid fa-arrow-right hidden text-xs transition-transform duration-300 ease-soft group-hover:-rotate-45 sm:inline"
          aria-hidden="true"
        ></i>
      </a>
    </div>
  </nav>
</header>
