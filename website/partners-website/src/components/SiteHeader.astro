---
// The partner site's header. It had none: the landing page drew a logo pill and
// a login button inline, with no navigation at all — nothing linked to the
// sections below it, and on a phone there was nothing to open.
import BrandLogo from '@duncit/brand/BrandLogo.astro';
import SiteMenu from '@duncit/brand/SiteMenu.astro';
import { fetchBranding } from '../lib/site-data';
import { urlConfigs } from '../config/url-configs';
import { getSiteTranslator } from '@duncit/brand/site-i18n';

const branding = await fetchBranding();
const { t } = await getSiteTranslator(urlConfigs.graphqlUrl);

// Every one of these goes somewhere that exists. The page has two sections and
// a download band, so the nav names those and the two real destinations in the
// partner app — not four anchors to headings nobody wrote.
const links = [
  { label: t('website.partners.nav.how'), href: '#ways' },
  { label: t('website.partners.nav.listVenue'), href: `${urlConfigs.partnersAppUrl}/register-venue` },
  { label: t('website.partners.nav.becomeHost'), href: `${urlConfigs.partnersAppUrl}/become-host` },
  { label: t('website.partners.nav.getApp'), href: '#download' },
];
const login = { label: t('website.partners.nav.login'), href: urlConfigs.partnersAppUrl };
const join = {
  label: t('website.partners.nav.join'),
  href: `${urlConfigs.partnersAppUrl}/register-venue`,
};
---

<!-- Rendered INSIDE the hero card, not absolutely over the page. The page is a
     dark frame around rounded panels, so a header pinned to the viewport hangs
     over the frame and the card's corner at once — which is exactly what it
     did: it landed on top of the hero's own badge. -->
<header class="partner-header relative z-20">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 py-1">
    <!-- No white pill behind the mark. It was there to keep a logo legible on
         the photograph, and it read as a sticker stuck on the banner; the
         scrim under the header does that job without boxing the brand in. -->
    <a href={urlConfigs.mainSiteUrl} class="partner-brand" aria-label={t('website.partners.nav.brandAria')}>
      <BrandLogo
        src={branding.website_header_logo_url}
        name={branding.app_name}
        height={56}
        href={null}
        graphqlUrl={urlConfigs.graphqlUrl}
      />
      <span class="partner-brand-word">{t('website.partners.brand.word')}</span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {links.map((link) => <a class="partner-link" href={link.href}>{link.label}</a>)}
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <a class="partner-login" href={login.href}>
        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
        <span class="hidden sm:inline">{login.label}</span>
      </a>
      <SiteMenu links={links} actions={[join, login]} onDark t={t} />
    </div>
  </nav>
</header>

<style>
  /* No scrim of its own: the hero already lays a gradient over the photograph,
     and a second one stacked on top just darkened a band across the top of the
     card. */

  .partner-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .partner-brand-word {
    font-family: var(--font-head, system-ui, sans-serif);
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-on-primary);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }
  .partner-brand :global(img) {
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.45));
  }

  .partner-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-on-primary) 85%, transparent);
    text-decoration: none;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    transition: color 150ms ease;
  }
  .partner-link:hover {
    color: var(--color-on-primary);
  }

  .partner-login {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-on-primary) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-on-primary) 12%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
    /* Two words in a pill between a wordmark and a burger — it broke across
       two lines on a phone before the label was hidden, and would again at the
       widths that show it. */
    white-space: nowrap;
    color: var(--color-on-primary);
    text-decoration: none;
    backdrop-filter: blur(6px);
    transition: background-color 150ms ease;
  }
  .partner-login:hover {
    background: color-mix(in srgb, var(--color-on-primary) 22%, transparent);
  }
</style>
