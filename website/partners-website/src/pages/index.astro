---
import Layout from '../layouts/Layout.astro';
import DownloadApps from '../components/DownloadApps.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/home/Hero.astro';
import PartnerPaths from '../components/home/PartnerPaths.astro';
import PartnerSteps from '../components/home/PartnerSteps.astro';
import ReelSlider from '@duncit/brand/ReelSlider.astro';
import PodRail from '@duncit/brand/PodRail.astro';
import EarnShowcase from '@duncit/brand/EarnShowcase.astro';
import { urlConfigs } from '../config/url-configs';
import { getSiteTranslator } from '@duncit/brand/site-i18n';

const { t } = await getSiteTranslator(urlConfigs.graphqlUrl);
---

<Layout title={t('website.partners.brand.title')}>
  <div class="min-h-screen bg-frame p-3 sm:p-4">
    <SiteHeader />
    <main class="mt-3 sm:mt-4">
      <Hero />
      <!-- Upcoming pods, live from the API, right under the banner; each opens on mWeb. -->
      <PodRail graphqlUrl={urlConfigs.graphqlUrl} mwebUrl={urlConfigs.mwebUrl} t={t} />

      <!-- Reels second, straight after the hero (hidden when there are none),
           then the Earn section the Website portal can move into a slot below. -->
      <ReelSlider graphqlUrl={urlConfigs.graphqlUrl} site="PARTNERS" t={t} />
      <EarnShowcase href={urlConfigs.earnwithUrl} graphqlUrl={urlConfigs.graphqlUrl} site="PARTNERS" t={t} class="rounded-3xl mt-3" />

      <PartnerPaths />
      <PartnerSteps />

      <DownloadApps />
      <div data-earn-slot="AFTER_DOWNLOAD"></div>
      <div data-earn-slot="BEFORE_FOOTER"></div>
    </main>
    <SiteFooter />
  </div>
</Layout>
